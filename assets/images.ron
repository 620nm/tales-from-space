// Whole pictures the shell shows at their authored size, never tiles.
//
// DMI paths are reference-root-relative; Aseprite and PNG paths are
// relative to originals/. Authored dimensions survive the PNG bake
// (engine docs/assets/delivery.md).
[
    // tg's title screen, behind the main menu.
    ("menu_bg", "icons/runtime/default_title.dmi"),
    ("wallpaper_bliss", "art/computer/wallpaper/wallpaper_bliss.aseprite"),
    ("wallpaper_moonlake", "art/computer/wallpaper/wallpaper_moonlake.aseprite"),
]
