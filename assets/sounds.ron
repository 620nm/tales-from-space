[
    ("weld", "items/tools/welder.ogg"),
    // tg splits these: `usesound` is the quick pop a crowbar makes
    // doing a job (pry_tile calls play_tool_sound), `operating_sound`
    // is the sustained heave used while forcing something open.
    ("crowbar", "items/tools/crowbar.ogg"),
    ("crowbar_pry", "items/tools/crowbar_prying.ogg"),
    ("smash", "items/weapons/smash.ogg"),
    ("vend", "machines/machine_vend.ogg"),
    ("airlock_open", "machines/airlock/airlockopen.ogg"),
    ("airlock_close", "machines/airlock/airlockclose.ogg"),
    ("wirecutter", "items/tools/wirecutter_cut.ogg"),
    ("ratchet", "items/tools/ratchet.ogg"),
    ("drink", "items/drink.ogg"),
    ("hiss", "machines/hiss.ogg"),
    // A tube going through: tg's break_light_tube plays glasshit.ogg,
    // and the light replacer clicks (lightreplacer.dm:263).
    ("glass_break", "effects/glass/glasshit.ogg"),
    ("click", "machines/click.ogg"),
    // An atmospherics valve wheel starting to turn. tg plays it on the
    // CLICK, ahead of the second of turning, so the room hears somebody
    // commit rather than hears the result (valve.dm:28).
    ("valve", "effects/valve_opening.ogg"),
    // Dice tumbling. tg plays it from `diceroll` itself, so it sounds
    // for a roll in the hand and a roll on landing alike (dice.dm:86).
    ("dice_roll", "items/dice_roll.ogg"),
]