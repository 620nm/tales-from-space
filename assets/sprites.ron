        ("cable_l3_10", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-2-8", 0), (25, 25, 200))),
        ("cable_l3_11", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-1-2-8", 0), (25, 25, 200))),
        ("cable_l3_12", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-4-8", 0), (25, 25, 200))),
        ("cable_l3_13", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-1-4-8", 0), (25, 25, 200))),
        ("cable_l3_14", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-2-4-8", 0), (25, 25, 200))),
        ("cable_l3_15", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l4-1-2-4-8", 0), (25, 25, 200))),
    ],
    offsets: [
        ("apc_s", 0, 25),
        ("apc_n", 0, -25),
        ("apc_e", 25, 0),
        ("apc_w", -25, 0),
        ("outlet_s", 0, 25),
        ("outlet_n", 0, -25),
        ("outlet_e", 25, 0),
        ("outlet_w", -25, 0),
    ],
    // tg's belt-content sheet is composed around the dropped belt,
    // whose top is y=10. The worn belt starts at y=18, so the same
    // details move down eight pixels only when they ride a mob.
    worn_offsets: [
        ("belt_screwdriver", 0, 8),
        ("belt_wrench", 0, 8),
        ("belt_crowbar", 0, 8),
        ("belt_cutters", 0, 8),
        ("belt_multitool", 0, 8),
    ],
    emissive: [
        "smes_out0",
