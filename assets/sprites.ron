(
    // The paper doll `Body`/`BodyDead` recipes composite. Optional at
    // the schema: a game whose sprites are all sheets and stills omits
    // the block entirely and bakes without one.
    //
    // No plan in this pack draws itself out of it any more — a crewman
    // is a coloured layer stack now (`content/bodies/human.luau`'s
    // `looks`, docs/LOOKS.md) — but the composite stays: it is one
    // whole-body picture for any plan that wants one, and the engine's
    // own test fixtures name it.
    body: Some((
        dmi: "mob/human/bodyparts_greyscale.dmi",
        parts: [
            "human_chest_m",
            "human_r_leg",
            "human_l_leg",
            "human_r_arm",
            "human_l_arm",
            "human_r_hand",
            "human_l_hand",
            "human_head_m",
        ],
        skin: (232, 200, 168),
    )),
    // tg renders status-display maptext in 12pt TinyUnicode
    // (`code/game/machinery/status_display.dm:3-11`). At 96dpi that is
    // 16px. The direct controls start from tg's `reject_bad_text`
    // exclusions (`code/__HELPERS/text.dm:81-106`) but deliberately
    // tighten them to printable ASCII because each field is one line;
    // the roster is exactly that grammar after uppercase conversion.
    // A space advances the pen without drawing a cell.
    fonts: [
        (
            id: "status",
            source: Tg("interface/fonts/TinyUnicode.ttf"),
            px: 16,
            glyphs: " !\"#$%&'()*+,-.0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`{|}~",
        ),
    ],
    // Display composition is atlas data rather than a game-named
    // renderer. The clock advances at tg's one-second processing
    // cadence (`code/controllers/subsystem/processing/digital_clock.dm:1-5`),
    // which is 20 ticks at this engine's frozen tick rate. The status
    // display keeps tg's two 22px rows, 25px/s marquee, four-space
    // repeat gap with a 2px-trimmed loop, and purple `-...-` headers
    // (`code/game/machinery/status_display.dm:3-10,35-38,311-347`;
    // `code/__DEFINES/colors.dm:383-384`).
    displays: [
        (
            sprites: [
                "digital_clock_s", "digital_clock_n",
                "digital_clock_e", "digital_clock_w",
            ],
            content: Clock((
                period_ticks: 20,
                digits: [
                    "digital_clock_0", "digital_clock_1", "digital_clock_2",
                    "digital_clock_3", "digital_clock_4", "digital_clock_5",
                    "digital_clock_6", "digital_clock_7", "digital_clock_8",
                    "digital_clock_9",
                ],
                separator: "digital_clock_separator",
                cells: [
                    (part: HourTens, x: -14, y: 0),
                    (part: HourOnes, x: -10, y: 0),
                    (part: Separator, x: 0, y: 0),
                    (part: MinuteTens, x: -4, y: 0),
                    (part: MinuteOnes, x: 0, y: 0),
                ],
            )),
        ),
        (
            sprites: [
                "status_display_s", "status_display_n",
                "status_display_e", "status_display_w",
            ],
            content: Text((
                font: "status",
                color: (34, 204, 255),
                // tg maptext uses +y up
                // (`code/game/machinery/status_display.dm:7-10`), while
                // atlas display coordinates use +y down. Negating tg's
                // -4/-11 keeps the second row below the first.
                lines: [
                    (var: "lunatic/tfs:display_line1", x: 1, y: 4, width: 22),
                    (var: "lunatic/tfs:display_line2", x: 1, y: 11, width: 22),
                ],
                marquee: Some((
                    pixels_per_second: 25,
                    gap_spaces: 4,
                    loop_trim: 2,
                )),
                emphasis: Some((
                    delimiter: '-',
                    color: (93, 93, 252),
                )),
            )),
        ),
    ],
    // The sprite roster lives in `tfs/assets/sprites/`, one file per
    // family, because this one crossed the thousand-line ceiling that is
    // a project rule rather than a guideline. Every .ron in that
    // directory is baked in file-name order; nothing else changed, and
    // the atlas it produces is byte-identical to the one this list
    // produced.
    offsets: [
        ("apc_s", 0, 25),
        ("apc_n", 0, -25),
        ("apc_e", 25, 0),
        ("apc_w", -25, 0),
        ("outlet_s", 0, 25),
        ("outlet_n", 0, -25),
        ("outlet_e", 25, 0),
        ("outlet_w", -25, 0),
        // The wall frame and what it becomes, overhanging the wall they
        // are bolted to exactly as the APC above does — the same box on
        // the same sheet, so the same shift (assets/sprites/73-network.ron).
        ("wall_frame_s", 0, 25),
        ("wall_frame_n", 0, -25),
        ("wall_frame_e", 25, 0),
        ("wall_frame_w", -25, 0),
        ("wall_frame_wired_s", 0, 25),
        ("wall_frame_wired_n", 0, -25),
        ("wall_frame_wired_e", 25, 0),
        ("wall_frame_wired_w", -25, 0),
        ("wall_frame_boarded_s", 0, 25),
        ("wall_frame_boarded_n", 0, -25),
        ("wall_frame_boarded_e", 25, 0),
        ("wall_frame_boarded_w", -25, 0),
        ("access_point_s", 0, 25),
        ("access_point_n", 0, -25),
        ("access_point_e", 25, 0),
        ("access_point_w", -25, 0),
        // tg's directional wall helpers shift these toward their wall
        // by the numbers declared beside each type: 28 pixels for the
        // clock (`code/game/machinery/digital_clock.dm:155`) and a full
        // tile for the status display
        // (`code/game/machinery/status_display.dm:399`).
        ("digital_clock_s", 0, 28),
        ("digital_clock_n", 0, -28),
        ("digital_clock_e", 28, 0),
        ("digital_clock_w", -28, 0),
        ("status_display_s", 0, 32),
        ("status_display_n", 0, -32),
        ("status_display_e", 32, 0),
        ("status_display_w", -32, 0),
    ],
    emissive: [
        "smes_out0",
        "smes_out1",
        "smes_in0",
        "smes_in1",
        "smes_chg1",
        "smes_chg2",
        "smes_chg3",
        "smes_chg4",
        "smes_chg5",
        "canister_g0",
        "canister_g1",
        "canister_g2",
        "canister_g3",
        "apcov_chg0",
        "apcov_chg1",
        "apcov_chg2",
        "apcov_lock",
        "apcov_eq_on",
        "apcov_eq_off",
        "apcov_lt_on",
        "apcov_lt_off",
        "apcov_env_on",
        "apcov_env_off",
    ],
)
