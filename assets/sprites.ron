        ("held_crowbar_r_s", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 0)),
        ("held_crowbar_r_n", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 1)),
        ("held_crowbar_r_e", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 2)),
