(
    // The paper doll `Body`/`BodyDead` recipes composite. Optional at
    // the schema: a game whose sprites are all sheets and stills omits
    // the block entirely and bakes without one.
    //
    // No plan in this pack draws itself out of it any more — a crewman
    // is a coloured layer stack now (`content/bodies/human.luau`'s
    // `looks`, docs/LOOKS.md) — but the composite stays: it is one
    // whole-body picture for any plan that wants one, and the engine's
    // own test fixtures name it.
    body: Some((
        dmi: "mob/human/bodyparts_greyscale.dmi",
        parts: [
            "human_chest_m",
            "human_r_leg",
            "human_l_leg",
            "human_r_arm",
            "human_l_arm",
            "human_r_hand",
            "human_l_hand",
            "human_head_m",
        ],
        skin: (232, 200, 168),
    )),
    // The sprite roster lives in `tfs/assets/sprites/`, one file per
    // family, because this one crossed the thousand-line ceiling that is
    // a project rule rather than a guideline. Every .ron in that
    // directory is baked in file-name order; nothing else changed, and
    // the atlas it produces is byte-identical to the one this list
    // produced.
    offsets: [
        ("apc_s", 0, 25),
        ("apc_n", 0, -25),
        ("apc_e", 25, 0),
        ("apc_w", -25, 0),
        ("outlet_s", 0, 25),
        ("outlet_n", 0, -25),
        ("outlet_e", 25, 0),
        ("outlet_w", -25, 0),
        // The wall frame and what it becomes, overhanging the wall they
        // are bolted to exactly as the APC above does — the same box on
        // the same sheet, so the same shift (assets/sprites/73-network.ron).
        ("wall_frame_s", 0, 25),
        ("wall_frame_n", 0, -25),
        ("wall_frame_e", 25, 0),
        ("wall_frame_w", -25, 0),
        ("wall_frame_wired_s", 0, 25),
        ("wall_frame_wired_n", 0, -25),
        ("wall_frame_wired_e", 25, 0),
        ("wall_frame_wired_w", -25, 0),
        ("wall_frame_boarded_s", 0, 25),
        ("wall_frame_boarded_n", 0, -25),
        ("wall_frame_boarded_e", 25, 0),
        ("wall_frame_boarded_w", -25, 0),
        ("access_point_s", 0, 25),
        ("access_point_n", 0, -25),
        ("access_point_e", 25, 0),
        ("access_point_w", -25, 0),
    ],
    emissive: [
        "smes_out0",
        "smes_out1",
        "smes_in0",
        "smes_in1",
        "smes_chg1",
        "smes_chg2",
        "smes_chg3",
        "smes_chg4",
        "smes_chg5",
        "canister_g0",
        "canister_g1",
        "canister_g2",
        "canister_g3",
        "apcov_chg0",
        "apcov_chg1",
        "apcov_chg2",
        "apcov_lock",
        "apcov_eq_on",
        "apcov_eq_off",
        "apcov_lt_on",
        "apcov_lt_off",
        "apcov_env_on",
        "apcov_env_off",
    ],
)
