        // The two fittings in hand. tg draws every /obj/item/pipe
        // from its machine's `pipe_state` in pipe_item.dmi
        // (construction.dm:212) -- the device with no run joined to
        // it, which is what one in your hands is. A flipped fitting
        // wears the same picture: what differs is the machine it
        // stands up as, and tg's item art does not distinguish them
        // either.
        ("filter_fitting", Dmi("obj/pipes_n_cables/pipe_item.dmi", "filter", 0)),
        ("mixer_fitting", Dmi("obj/pipes_n_cables/pipe_item.dmi", "mixer", 0)),
        // A gas canister: tg's art is greyscale and each gas type paints
        // it (greyscale_colors "#c6c0b5" is pre-mixed air). Baked with
        // that colour for now; it moves to per-object paint when the
        // renderer can tint a sprite on both paths.
        // tg's canister greyscale recipe, whole (canister_base.json +
        // canister_post_effects.json): a white shell mask that takes the
        // colour, two shader passes, and a coloured outline. Baking only
        // `base` — which is 329 pixels of pure white — is why this drew
        // as a flat blob with no edge.
        //
        // Left greyscale with a DECLARED colour rather than a baked one,
        // so a canister can be painted by its gas the way tg paints
        // them. The one cost: `add_shader` is a highlight tg adds AFTER
        // colouring, and added to a white base it clamps away, leaving
        // this ~7% darker than tg's. The shape, which is what was
        // actually missing, is exact.
        ("canister", Tinted(DmiBlend(
            dmi: "obj/pipes_n_cables/canisters.dmi",
            layers: [
                ("base", Over, true),
                ("add_shader", Add, false),
                ("multi_shader", Multiply, false),
                ("outline", Over, true),
            ],
            dir: 0,
            paint: (255, 255, 255),
        ), (198, 192, 181))),
        // The same shell wearing tg's `can-connector` — the picture a
        // canister only has while it is fastened to a port
        // (canister.dm's update_overlays: `if(connected_port)`). It is
        // a STATE SPRITE rather than an overlay because the canister's
        // overlay slot is already spoken for by the gauge, which the
        // sim rewrites every time the pressure band moves; the two
        // would fight for the same component every tick. tg does not
        // RESET_COLOR this one either, so it takes the gas's colour
        // along with the rest of the shell, which is why it rides
        // inside the blend.
        ("canister_connected", Tinted(DmiBlend(
            dmi: "obj/pipes_n_cables/canisters.dmi",
            layers: [
                ("base", Over, true),
                ("add_shader", Add, false),
                ("multi_shader", Multiply, false),
                ("outline", Over, true),
                ("can-connector", Over, false),
            ],
            dir: 0,
            paint: (255, 255, 255),
        ), (198, 192, 181))),
        // The indicator lamps are NOT coloured by the gas (tg's
        // post_effects leaves them alone), so they ride as their own
        // untinted overlay.
        ("canister_lights", Dmi("obj/pipes_n_cables/canisters.dmi", "lights", 0)),
        ("canister_g0", Dmi("obj/pipes_n_cables/canisters.dmi", "can-0", 0)),
        ("canister_g1", Dmi("obj/pipes_n_cables/canisters.dmi", "can-1", 0)),
        ("canister_g2", Dmi("obj/pipes_n_cables/canisters.dmi", "can-2", 0)),
        ("canister_g3", Dmi("obj/pipes_n_cables/canisters.dmi", "can-3", 0)),
        ("metal", Dmi("obj/stack_objects.dmi", "sheet-metal_3", 0)),
        ("floor_tile", Dmi("obj/tiles.dmi", "tile", 0)),
        ("tv", Dmi("obj/machines/computer.dmi", "detective_tv", 0)),
        ("white", White),

        // ---- in-hand overlays -------------------------------------
        // What a carried item looks like ON the mob. tg keeps these
        // apart from the worn_* sheets entirely: `/obj/item` declares
        // `inhand_icon_state` plus a PAIR of files (`lefthand_file` /
        // `righthand_file`) scattered through icons/mob/inhands/, and
        // an item points at whichever category file happens to hold
        // its state. Left vs right is the FILE, never a state suffix —
        // hence `_l` / `_r` here, one baked family per hand, so a
        // two-item carry doesn't stack both pictures on one shoulder.
        // No render offset: tg only shifts hands 3 and 4 (multi-armed
        // mobs) by 16px; a two-handed human's overlays sit at 0,0.
        ("held_crowbar_l_s", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 0)),
        ("held_crowbar_l_n", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 1)),
        ("held_crowbar_l_e", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 2)),
