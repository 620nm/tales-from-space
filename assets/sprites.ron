(
    body_dmi: "mob/human/bodyparts_greyscale.dmi",
    body_parts: [
        "human_chest_m",
        "human_r_leg",
        "human_l_leg",
        "human_r_arm",
        "human_l_arm",
        "human_r_hand",
        "human_l_hand",
        "human_head_m",
    ],
    skin: (232, 200, 168),
    sprites: [
        ("space", Dmi("turf/space.dmi", "space", 0)),
        ("floor", Dmi("turf/floors.dmi", "floor", 0)),
        ("plating", Dmi("turf/floors.dmi", "plating", 0)),
        ("wall", Dmi("turf/walls/wall.dmi", "wall-0", 0)),
        ("girder", Dmi("obj/structures.dmi", "girder", 0)),
        ("girder_displaced", Dmi("obj/structures.dmi", "displaced", 0)),
        ("frame", Dmi("obj/devices/stock_parts.dmi", "box_0", 0)),
        ("board", Dmi("obj/devices/circuitry_n_data.dmi", "mainboard", 0)),
        // An airlock has four appearances, not two: the two rests and
        // the two swings between them. tg's `update_icon_state` appends
        // AIRLOCK_FRAME_OPENING/CLOSING while the door is operating
        // (airlock.dm:556), and each swing is six frames of a tenth.
        ("door", Dmi("obj/doors/airlocks/station/public.dmi", "closed", 0)),
        ("door_open", Dmi("obj/doors/airlocks/station/public.dmi", "open", 0)),
        ("door_opening", DmiAnim("obj/doors/airlocks/station/public.dmi", "opening", 0)),
        ("door_closing", DmiAnim("obj/doors/airlocks/station/public.dmi", "closing", 0)),
        ("door_eng", Dmi("obj/doors/airlocks/station/engineering.dmi", "closed", 0)),
        ("door_eng_open", Dmi("obj/doors/airlocks/station/engineering.dmi", "open", 0)),
        ("door_eng_opening", DmiAnim("obj/doors/airlocks/station/engineering.dmi", "opening", 0)),
        ("door_eng_closing", DmiAnim("obj/doors/airlocks/station/engineering.dmi", "closing", 0)),
        ("apc", Dmi("obj/machines/wallmounts.dmi", "apc0", 0)),
        ("apc_s", Dmi("obj/machines/wallmounts.dmi", "apc0", 0)),
        ("apc_n", Dmi("obj/machines/wallmounts.dmi", "apc0", 0)),
        ("apc_e", Dmi("obj/machines/wallmounts.dmi", "apc0", 0)),
        ("apc_w", Dmi("obj/machines/wallmounts.dmi", "apc0", 0)),
        ("apcov_chg0", Dmi("obj/machines/wallmounts.dmi", "apco3-0", 0)),
        ("apcov_chg1", Dmi("obj/machines/wallmounts.dmi", "apco3-1", 0)),
        ("apcov_chg2", Dmi("obj/machines/wallmounts.dmi", "apco3-2", 0)),
        ("apcov_lock", Dmi("obj/machines/wallmounts.dmi", "apcox-0", 0)),
        ("apcov_eq_on", Dmi("obj/machines/wallmounts.dmi", "apco0-3", 0)),
        ("apcov_eq_off", Dmi("obj/machines/wallmounts.dmi", "apco0-1", 0)),
        ("apcov_lt_on", Dmi("obj/machines/wallmounts.dmi", "apco1-3", 0)),
        ("apcov_lt_off", Dmi("obj/machines/wallmounts.dmi", "apco1-1", 0)),
        ("apcov_env_on", Dmi("obj/machines/wallmounts.dmi", "apco2-3", 0)),
        ("apcov_env_off", Dmi("obj/machines/wallmounts.dmi", "apco2-1", 0)),
        ("human_s", Body(0)),
        ("human_n", Body(1)),
        ("human_e", Body(2)),
        ("human_w", Body(3)),
        ("human_dead", BodyDead),
        ("worn_backpack_s", Dmi("mob/clothing/back/backpack.dmi", "backpack", 0)),
        ("worn_backpack_n", Dmi("mob/clothing/back/backpack.dmi", "backpack", 1)),
        ("worn_backpack_e", Dmi("mob/clothing/back/backpack.dmi", "backpack", 2)),
        ("worn_backpack_w", Dmi("mob/clothing/back/backpack.dmi", "backpack", 3)),
        ("worn_uniform_grey_s", Dmi("mob/clothing/under/color.dmi", "grey_ancient", 0)),
        ("worn_uniform_grey_n", Dmi("mob/clothing/under/color.dmi", "grey_ancient", 1)),
        ("worn_uniform_grey_e", Dmi("mob/clothing/under/color.dmi", "grey_ancient", 2)),
        ("worn_uniform_grey_w", Dmi("mob/clothing/under/color.dmi", "grey_ancient", 3)),
        ("worn_uniform_eng_s", Dmi("mob/clothing/under/engineering.dmi", "engine", 0)),
        ("worn_uniform_eng_n", Dmi("mob/clothing/under/engineering.dmi", "engine", 1)),
        ("worn_uniform_eng_e", Dmi("mob/clothing/under/engineering.dmi", "engine", 2)),
        ("worn_uniform_eng_w", Dmi("mob/clothing/under/engineering.dmi", "engine", 3)),
        ("worn_uniform_med_s", Dmi("mob/clothing/under/medical.dmi", "medical", 0)),
        ("worn_uniform_med_n", Dmi("mob/clothing/under/medical.dmi", "medical", 1)),
        ("worn_uniform_med_e", Dmi("mob/clothing/under/medical.dmi", "medical", 2)),
        ("worn_uniform_med_w", Dmi("mob/clothing/under/medical.dmi", "medical", 3)),
        ("worn_uniform_sec_s", Dmi("mob/clothing/under/security.dmi", "security", 0)),
        ("worn_uniform_sec_n", Dmi("mob/clothing/under/security.dmi", "security", 1)),
        ("worn_uniform_sec_e", Dmi("mob/clothing/under/security.dmi", "security", 2)),
        ("worn_uniform_sec_w", Dmi("mob/clothing/under/security.dmi", "security", 3)),
        ("worn_uniform_cap_s", Dmi("mob/clothing/under/captain.dmi", "captain", 0)),
        ("worn_uniform_cap_n", Dmi("mob/clothing/under/captain.dmi", "captain", 1)),
        ("worn_uniform_cap_e", Dmi("mob/clothing/under/captain.dmi", "captain", 2)),
        ("worn_uniform_cap_w", Dmi("mob/clothing/under/captain.dmi", "captain", 3)),
        ("uniform_grey", Dmi("obj/clothing/under/color.dmi", "grey_ancient", 0)),
        ("uniform_eng", Dmi("obj/clothing/under/engineering.dmi", "engine", 0)),
        ("uniform_med", Dmi("obj/clothing/under/medical.dmi", "medical", 0)),
        ("uniform_sec", Dmi("obj/clothing/under/security.dmi", "rsecurity", 0)),
        ("uniform_cap", Dmi("obj/clothing/under/captain.dmi", "captain", 0)),
        ("toolbox", Dmi("obj/storage/toolbox.dmi", "red", 0)),
        ("backpack", Dmi("obj/storage/backpack.dmi", "backpack", 0)),
        ("headset", Dmi("obj/clothing/headsets.dmi", "headset", 0)),
        ("welder", Dmi("obj/tools.dmi", "welder", 0)),
        ("id", Dmi("obj/card.dmi", "card_grey", 0)),
        ("crowbar", Dmi("obj/tools.dmi", "crowbar", 0)),
        // tg's screwdriver is a COLOURED handle plus a steel shaft that
        // must stay steel (greyscale/json_configs/screwdriver.json). We
        // baked only the handle mask, so the tool was a couple of tinted
        // pixels. The colour is baked here rather than declared because
        // one quad cannot carry two colours; COLOR_TOOL_RED is tg's.
        ("screwdriver", DmiBlend(
            dmi: "obj/tools.dmi",
            layers: [("screwdriver", Over, true), ("screwdriver_screwybits", Over, false)],
            dir: 0,
            paint: (149, 23, 16),
        )),
        ("wrench", Dmi("obj/tools.dmi", "wrench", 0)),
        ("vendor", Dmi("obj/machines/vending.dmi", "Cola_Machine", 0)),
        // tg's YouTool, off the same vending sheet (vending/youtool.dm).
        ("tool_vendor", Dmi("obj/machines/vending.dmi", "tool", 0)),
        ("cola", Dmi("obj/drinks/soda.dmi", "cola", 0)),
        ("outlet", Dmi("obj/pipes_n_cables/structures.dmi", "term", 0)),
        ("outlet_s", Dmi("obj/pipes_n_cables/structures.dmi", "term", 0)),
        ("outlet_n", Dmi("obj/pipes_n_cables/structures.dmi", "term", 1)),
        ("outlet_e", Dmi("obj/pipes_n_cables/structures.dmi", "term", 2)),
        ("outlet_w", Dmi("obj/pipes_n_cables/structures.dmi", "term", 3)),
        ("generator", Dmi("obj/machines/engine/other.dmi", "portgen0_0", 0)),
        ("smes", Dmi("obj/machines/engine/other.dmi", "smes", 0)),
        // SMES display lamps (tg smes.dm update_overlays): an output
        // lamp, an input lamp, and a five-segment charge bar. All of
        // them glow, so all of them are emissive.
        ("smes_out0", Dmi("obj/machines/engine/other.dmi", "smes-op0", 0)),
        ("smes_out1", Dmi("obj/machines/engine/other.dmi", "smes-op1", 0)),
        ("smes_in0", Dmi("obj/machines/engine/other.dmi", "smes-oc0", 0)),
        ("smes_in1", Dmi("obj/machines/engine/other.dmi", "smes-oc1", 0)),
        ("smes_chg1", Dmi("obj/machines/engine/other.dmi", "smes-og1", 0)),
        ("smes_chg2", Dmi("obj/machines/engine/other.dmi", "smes-og2", 0)),
        ("smes_chg3", Dmi("obj/machines/engine/other.dmi", "smes-og3", 0)),
        ("smes_chg4", Dmi("obj/machines/engine/other.dmi", "smes-og4", 0)),
        ("smes_chg5", Dmi("obj/machines/engine/other.dmi", "smes-og5", 0)),
        ("light_on", DmiLayers([
            ("obj/lighting.dmi", "tube"),
            ("obj/lighting_overlay.dmi", "tube"),
        ], 0)),
        ("light_off", Dmi("obj/lighting.dmi", "tube", 0)),
        ("light_on_s", DmiLayers([
            ("obj/lighting.dmi", "tube"),
            ("obj/lighting_overlay.dmi", "tube"),
        ], 0)),
        ("light_on_n", DmiLayers([
            ("obj/lighting.dmi", "tube"),
            ("obj/lighting_overlay.dmi", "tube"),
        ], 1)),
        ("light_on_e", DmiLayers([
            ("obj/lighting.dmi", "tube"),
            ("obj/lighting_overlay.dmi", "tube"),
        ], 2)),
        ("light_on_w", DmiLayers([
            ("obj/lighting.dmi", "tube"),
            ("obj/lighting_overlay.dmi", "tube"),
        ], 3)),
        ("light_off_s", Dmi("obj/lighting.dmi", "tube", 0)),
        ("light_off_n", Dmi("obj/lighting.dmi", "tube", 1)),
        ("light_off_e", Dmi("obj/lighting.dmi", "tube", 2)),
        ("light_off_w", Dmi("obj/lighting.dmi", "tube", 3)),
        // The other three sockets tg draws (light.dm's update_icon_state
        // switch): shattered glass, an empty fitting, a burned-out tube.
        // None of them glow, so none of them wear the emissive overlay.
        ("light_broken", Dmi("obj/lighting.dmi", "tube-broken", 0)),
        ("light_broken_s", Dmi("obj/lighting.dmi", "tube-broken", 0)),
        ("light_broken_n", Dmi("obj/lighting.dmi", "tube-broken", 1)),
        ("light_broken_e", Dmi("obj/lighting.dmi", "tube-broken", 2)),
        ("light_broken_w", Dmi("obj/lighting.dmi", "tube-broken", 3)),
        ("light_empty", Dmi("obj/lighting.dmi", "tube-empty", 0)),
        ("light_empty_s", Dmi("obj/lighting.dmi", "tube-empty", 0)),
        ("light_empty_n", Dmi("obj/lighting.dmi", "tube-empty", 1)),
        ("light_empty_e", Dmi("obj/lighting.dmi", "tube-empty", 2)),
        ("light_empty_w", Dmi("obj/lighting.dmi", "tube-empty", 3)),
        ("light_burned", Dmi("obj/lighting.dmi", "tube-burned", 0)),
        ("light_burned_s", Dmi("obj/lighting.dmi", "tube-burned", 0)),
        ("light_burned_n", Dmi("obj/lighting.dmi", "tube-burned", 1)),
        ("light_burned_e", Dmi("obj/lighting.dmi", "tube-burned", 2)),
        ("light_burned_w", Dmi("obj/lighting.dmi", "tube-burned", 3)),
        // The loose glass a fitting takes, and the janitor's device
        // that fits it for you (tg lighting.dmi "ltube"/"lbulb",
        // service/janitor.dmi "lightreplacer").
        ("light_tube", Dmi("obj/lighting.dmi", "ltube", 0)),
        ("light_bulb", Dmi("obj/lighting.dmi", "lbulb", 0)),
        ("light_replacer", Dmi("obj/service/janitor.dmi", "lightreplacer", 0)),
        // A cardboard box wearing its contents label, tg's
        // `illustration` overlay (service_boxes.dm:114).
        ("box_lights", DmiLayers([
            ("obj/storage/box.dmi", "box"),
            ("obj/storage/box.dmi", "lightmixed"),
        ], 0)),
        // Same shape as the screwdriver: coloured grips, steel jaws
        // (wirecutters.json). tg colours these COLOR_RED.
        ("wirecutters", DmiBlend(
            dmi: "obj/tools.dmi",
            layers: [("cutters", Over, true), ("cutters_cutty_thingy", Over, false)],
            dir: 0,
            paint: (255, 0, 0),
        )),
        ("coil", Dmi("obj/stack_objects.dmi", "coil", 0)),
        ("beaker", Dmi("obj/medical/chemical.dmi", "beaker", 0)),
        ("ghost", Dmi("mob/human/species/ghost.dmi", "ghost_base", 0)),
        ("solar", Dmi("obj/machines/solar.dmi", "solar_panel_glass", 0)),
        // The fan, by what it is actually doing. Blowing and siphoning
        // are the two running loops (tg's `vent_[pump_direction ?
        // "out" : "in"]`); the spin-up and spin-down are one-shots the
        // machine plays on the power edges (vent_pump.dm's
        // flick("vent_out-starting") / flick("vent_out-shutdown")).
        ("vent_on", DmiAnim("obj/machines/atmospherics/unary_devices.dmi", "vent_out", 0)),
        ("vent_siphon", DmiAnim("obj/machines/atmospherics/unary_devices.dmi", "vent_in", 0)),
        ("vent_starting", DmiAnim("obj/machines/atmospherics/unary_devices.dmi", "vent_out-starting", 0)),
        ("vent_shutdown", DmiAnim("obj/machines/atmospherics/unary_devices.dmi", "vent_out-shutdown", 0)),
        ("vent_off", Dmi("obj/machines/atmospherics/unary_devices.dmi", "vent_off", 0)),
        ("vent_passive", Dmi("obj/machines/atmospherics/unary_devices.dmi", "passive_vent", 0)),
        // The connector port: tg's `portables_connector`, a pipe fitting
        // that lies in the deck and is the ONLY thing a portable atmos
        // device may fasten to. The two states are two of tg's own
        // pictures, and the difference between them is the whole rule:
        // `connector_map-3` is the socket with its stub running down
        // into the pipe, and `connector` is the same socket with the
        // stub gone — a fitting lying loose on the deck, joined to
        // nothing, hosting nothing.
        //
        // The stub POINTS, so there are four of it. tg draws the same
        // state at four dirs (`connector_map-3` is `dirs = 4`) and a
        // unary atmos component's `initialize_directions` IS its dir
        // (unary_devices.dm:14) — the socket joins the run on that one
        // side and no other. DMI dir order is south, north, east, west.
        ("connector_port_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "connector_map-3", 0)),
        ("connector_port_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "connector_map-3", 1)),
        ("connector_port_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "connector_map-3", 2)),
        ("connector_port_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "connector_map-3", 3)),
        // Unbolted there is no stub at all, so there is nothing to
        // point: tg's loose `connector` state is `dirs = 1`.
        ("connector_port_loose", Dmi("obj/machines/atmospherics/unary_devices.dmi", "connector", 0)),
        // The machines that stand IN a run rather than on it: tg's
        // binary devices. Each picture is tg's own recipe, composited --
        // one `pipe_intact` half-pipe per NODE direction, then the
        // device body at its facing (components_base.dm:87-98). Drawn
        // this way rather than wearing the `*_map-N` states because
        // those exist for one position only (there is no
        // `mvalve_on_map`), and a machine whose open picture came from a
        // different recipe than its shut one would not read as the same
        // object.
        //
        // A binary device reaches along ONE AXIS, so there are two
        // pictures and not four: tg's `PIPING_CARDINAL_AUTONORMALIZE`
        // folds south onto north and west onto east (valve.dm:14,25,
        // `normalize_cardinal_directions`), and the art agrees --
        // `mvalve_off-1` has no south or west cell at all. The four
        // names below are what `facing_sprites` asks for; two pairs bake
        // the same picture, which is the honest amount of art a thing
        // with two ends has. `-1` is tg's overlay offset for piping
        // layers 1, 3 and 5 (`set_overlay_offset`).
        //
        // DMI dirs: 0 south, 1 north, 2 east, 3 west.
        ("valve_shut_n", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 1),
        ])),
        ("valve_shut_s", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 1),
        ])),
        ("valve_shut_e", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 2),
        ])),
        ("valve_shut_w", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 2),
        ])),
        ("valve_open_n", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 1),
        ])),
        ("valve_open_s", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 1),
        ])),
        ("valve_open_e", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 2),
        ])),
        ("valve_open_w", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 2),
        ])),
        // The gas pump, same recipe. tg's running body (`pump_on-1`) is
        // a five-frame loop; its first frame is baked, so a running pump
        // reads by its lit indicators rather than by moving -- the loop
        // is a follow-up, not a correction.
        ("pump_off_n", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 1),
        ])),
        ("pump_off_s", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 1),
        ])),
        ("pump_off_e", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 2),
        ])),
        ("pump_off_w", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 2),
        ])),
        ("pump_on_n", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 1),
        ])),
        ("pump_on_s", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 1),
        ])),
        ("pump_on_e", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 2),
        ])),
        ("pump_on_w", DmiCells([
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
            ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
            ("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 2),
        ])),
        // The TRINARY machines: tg's gas filter and gas mixer. Same
        // recipe as the binaries above -- a half-pipe per NODE
        // direction, then the device body at its facing
        // (components_base.dm:87-98) -- with two differences that come
        // straight out of the trinary art.
        //
        // The half-pipe is this file's own `cap` state, not
        // binary_devices.dmi's `pipe_intact`: tg composites
        // `get_pipe_image(icon, "cap", direction, ...)` where `icon` is
        // the machine's own (filter.dm:44-50, mixer.dm:50-58). And the
        // body's overlay offset is `-0` rather than `-1`, because
        // `set_overlay_offset` returns 0 for the default piping layer
        // and only layers 1 and 5 get their own (trinary_devices.dm:53-60).
        //
        // FOUR facings each, where a binary has two. A binary reaches
        // along one axis and tg normalises south onto north; a trinary
        // reaches three ways and every rotation is a different picture.
        // The three caps per sprite are its node dirs: behind the
        // facing, the facing, and `turn(dir, -90)` -- the same geometry
        // `pipes/devices.rs` binds by, so a machine's art and its
        // plumbing cannot disagree.
        //
        // `_f` is tg's flipped body (trinary_devices.dm:12-13): node1
        // and node3 change places while the side port stays where it
        // is, so the CAPS are identical and only the body mirrors.
        // tg's running bodies are four-frame loops; the first frame is
        // baked, as the pump's is.
        ("filter_off_n", DmiCells([
            ("obj/machines/atmospherics/trinary_devices.dmi", "cap", 0),
            ("obj/machines/atmospherics/trinary_devices.dmi", "cap", 1),
            ("obj/machines/atmospherics/trinary_devices.dmi", "cap", 2),
            ("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0", 1),
