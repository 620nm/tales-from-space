        ("pipe_l5_15", Dmi("obj/pipes_n_cables/!pipes_bitmask.dmi", "15_5", 0)),
        // Cable art, tg's naming kept verbatim: l<layer>-<dirs>
        // with BYOND dir bits 1=N 2=S 4=E 8=W, sorted ascending, and
        // "noconnection" for a stub joined to nothing. The client
        // derives WHICH of these to draw from its own neighbour scan,
        // so the wire only ever carries the topology.
        //
        // tg's art is white and tinted per cable; the colours are the
        // vocabulary, not decoration -- red is the feeder you do not
        // cut, yellow is the branch you do (tg's CABLE_HEX_COLOR_RED
        // and _YELLOW). Baked in rather than tinted at draw time so
        // the Canvas2D fallback, which can fill a rect but not tint a
        // sprite, draws the same wire the WebGPU path does.
        ("cable_l1_none", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-noconnection", 0), (255, 0, 0))),
        ("cable_l2_none", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l2-noconnection", 0), (255, 255, 0))),
        ("cable_l1_1", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-1", 0), (255, 0, 0))),
        ("cable_l1_2", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-2", 0), (255, 0, 0))),
        ("cable_l1_3", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-1-2", 0), (255, 0, 0))),
        ("cable_l1_4", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-4", 0), (255, 0, 0))),
