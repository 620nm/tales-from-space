        ("cable_l1_6", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-2-4", 0), (255, 0, 0))),
        ("cable_l1_7", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-1-2-4", 0), (255, 0, 0))),
        ("cable_l1_8", Tinted(Dmi("obj/pipes_n_cables/layer_cable.dmi", "l1-8", 0), (255, 0, 0))),
