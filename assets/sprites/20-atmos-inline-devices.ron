// The machines that stand IN a pipe run rather than on it: tg's binary
// and trinary families, and the flow devices built on them.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
//
// EVERY BODY HERE IS BARE, and that is the whole shape of this file.
// tg draws a component in two passes -- `update_icon_nopipes()` puts
// down the device and nothing else, then `update_icon()` underlays one
// pipe stub per mouth from the state of the network right now
// (components_base.dm:68-111). These cells are the first pass. The
// second is `sim/atmos_machines/underlays.rs`, which reads the same
// ports the pipe grid binds gas through and asks for
// `pipe_intact_*` / `pipe_exposed_*` out of 50-pipes-and-cable.ron.
//
// The half-pipes used to be COMPOSITED IN HERE, one `pipe_intact` cell
// per node direction, and that was the defect: a picture cannot know
// what is next door, so a filter never reached its neighbours, a pump
// with one end unplumbed still showed a full-width tube, and no machine
// ever gained or lost a connection when somebody laid or cut the run
// beside it. Baked art answers "what is this machine"; only the sim can
// answer "what is it joined to". Do not composite a stub back in.
//
// DMI dirs throughout: 0 south, 1 north, 2 east, 3 west.
(
    // Sheet aliases are local to this family; @names below resolve here.
    sheets: [
        ("binary", "obj/machines/atmospherics/binary_devices.dmi"),
        ("trinary", "obj/machines/atmospherics/trinary_devices.dmi"),
        ("pipe_item", "obj/pipes_n_cables/pipe_item.dmi"),
    ],
    sprites: [
        // THE BINARY FAMILY. A binary device reaches along ONE AXIS, so
        // there are two pictures and not four: tg's
        // `PIPING_CARDINAL_AUTONORMALIZE` folds south onto north and west
        // onto east (valve.dm:14,25, `normalize_cardinal_directions`), and
        // the art agrees -- `mvalve_off-1` has no south or west cell at
        // all. So these name the AXIS, and `facing_sprites` points two
        // directions at one name. They used to bake four names for two
        // pictures, which cost two atlas cells apiece that nobody looked
        // at; harmless while every body was a single still, and no longer
        // harmless now that a running pump is five cells rather than one.
        //
        // `-1` is tg's overlay offset for piping layers 1, 3 and 5
        // (`set_overlay_offset`, binary_devices.dm:27-32); layers 2 and 4
        // have their own `-2` bodies in tg which this pack does not bake
        // yet, so a valve on the waste main wears the default-layer body
        // over stubs drawn at its own layer. The stubs are the half that
        // has to be right -- they are what meets the run.
        ("valve_shut_ns", Dmi("@binary", "mvalve_off-1", 1)),
        ("valve_shut_ew", Dmi("@binary", "mvalve_off-1", 2)),
        ("valve_open_ns", Dmi("@binary", "mvalve_on-1", 1)),
        ("valve_open_ew", Dmi("@binary", "mvalve_on-1", 2)),
        // The wheel actually turning. tg flicks these from
        // `update_icon_nopipes(animation = TRUE)` (valve.dm:24-29), which
        // is called from the turn at valve.dm:67 -- `[valve_type]valve_
        // [on][!on]`, where `on` is the position BEFORE the toggle, so
        // shut->open is `mvalve_01` and open->shut is `mvalve_10`.
        //
        // `DmiAnimOnce`, not `DmiAnim`, and the difference is load-bearing:
        // these two states carry no `loop = 1`, because BYOND's `flick()`
        // plays a state once whatever its loop flag says and an artist
        // drawing a flicked animation has no reason to set it. Baked off
        // the sheet's own flag they would loop, and a looping sprite reads
        // the client's wall clock instead of the sim's anchor -- the turn
        // would start at an arbitrary frame and never stop. The digital
        // valve below DOES set the flag; same code flicks both, which is
        // the clearest possible evidence the flag is not the authority.
        //
        // 1.4 seconds of art (five frames, `2,2,2,2,6`) against a valve
        // that takes 1.0 second to turn. They disagree in tg too and are
        // left disagreeing: `flick()` is cosmetic and the `addtimer(...,
        // 1 SECONDS)` at valve.dm:70 is the mechanism.
        ("valve_opening_ns", DmiAnimOnce("@binary", "mvalve_01-1", 1)),
        ("valve_opening_ew", DmiAnimOnce("@binary", "mvalve_01-1", 2)),
        ("valve_closing_ns", DmiAnimOnce("@binary", "mvalve_10-1", 1)),
        ("valve_closing_ew", DmiAnimOnce("@binary", "mvalve_10-1", 2)),
        // The gas pump, running: tg's `pump_on-1`, five frames at a
        // twentieth of a second each. No anchor and no server state -- a
        // loop has no beginning worth agreeing on, so every client runs it
        // off its own clock and the wire never mentions it.
        // FOUR facings, not two: a pump has a FRONT, and tg's art says
        // so -- `pump_off-1` carries four dirs and the south and west
        // frames are the rotations that show which way it blows. Only
        // the valves and the adapters carry
        // `PIPING_CARDINAL_AUTONORMALIZE`; folding a pump's south onto
        // its north made a west-facing machine wear the east picture
        // and read as wrenched the wrong way round.
        ("pump_off_n", Dmi("@binary", "pump_off-1", 1)),
        ("pump_off_s", Dmi("@binary", "pump_off-1", 0)),
        ("pump_off_e", Dmi("@binary", "pump_off-1", 2)),
        ("pump_off_w", Dmi("@binary", "pump_off-1", 3)),
        ("pump_on_n", DmiAnim("@binary", "pump_on-1", 1)),
        ("pump_on_s", DmiAnim("@binary", "pump_on-1", 0)),
        ("pump_on_e", DmiAnim("@binary", "pump_on-1", 2)),
        ("pump_on_w", DmiAnim("@binary", "pump_on-1", 3)),
        // THE TRINARY MACHINES: tg's gas filter and gas mixer. FOUR
        // facings each, where a binary has two -- a binary reaches along
        // one axis and tg normalises south onto north, while a trinary
        // reaches three ways and every rotation is a different picture.
        // Which three ways is `pipes/devices.rs`'s `node_dirs`: behind the
        // facing, the facing, and `turn(dir, -90)`, so a machine's art and
        // its plumbing cannot disagree about where the side mouth is.
        //
        // The body's overlay offset is `-0` rather than `-1`, because
        // `set_overlay_offset` returns 0 for the default piping layer and
        // only layers 1 and 5 get their own (trinary_devices.dm:53-60).
        //
        // `_f` is tg's flipped body (trinary_devices.dm:12-13): node1 and
        // node3 change places while the side port stays where it is, so
        // only the body mirrors. The running bodies are four-frame loops
        // (`2,2,2,2` -- a fifth of a second a frame, half the pump's
        // rate), and they are the expensive entry in this file: four
        // facings times four frames times two chiralities is sixty-four
        // atlas cells across the filter and the mixer. Worth it, because
        // these two are the machines an engineer stands and watches -- a
        // filter row that is running looks like a filter row that is
        // running, and a stalled one is now visibly stalled.
        ("filter_off_n", Dmi("@trinary", "filter_off-0", 1)),
        ("filter_off_s", Dmi("@trinary", "filter_off-0", 0)),
        ("filter_off_e", Dmi("@trinary", "filter_off-0", 2)),
        ("filter_off_w", Dmi("@trinary", "filter_off-0", 3)),
        ("filter_on_n", DmiAnim("@trinary", "filter_on-0", 1)),
        ("filter_on_s", DmiAnim("@trinary", "filter_on-0", 0)),
        ("filter_on_e", DmiAnim("@trinary", "filter_on-0", 2)),
        ("filter_on_w", DmiAnim("@trinary", "filter_on-0", 3)),
        ("filter_f_off_n", Dmi("@trinary", "filter_off-0_f", 1)),
        ("filter_f_off_s", Dmi("@trinary", "filter_off-0_f", 0)),
        ("filter_f_off_e", Dmi("@trinary", "filter_off-0_f", 2)),
        ("filter_f_off_w", Dmi("@trinary", "filter_off-0_f", 3)),
        ("filter_f_on_n", DmiAnim("@trinary", "filter_on-0_f", 1)),
        ("filter_f_on_s", DmiAnim("@trinary", "filter_on-0_f", 0)),
        ("filter_f_on_e", DmiAnim("@trinary", "filter_on-0_f", 2)),
        ("filter_f_on_w", DmiAnim("@trinary", "filter_on-0_f", 3)),
        ("mixer_off_n", Dmi("@trinary", "mixer_off-0", 1)),
        ("mixer_off_s", Dmi("@trinary", "mixer_off-0", 0)),
        ("mixer_off_e", Dmi("@trinary", "mixer_off-0", 2)),
        ("mixer_off_w", Dmi("@trinary", "mixer_off-0", 3)),
        ("mixer_on_n", DmiAnim("@trinary", "mixer_on-0", 1)),
        ("mixer_on_s", DmiAnim("@trinary", "mixer_on-0", 0)),
        ("mixer_on_e", DmiAnim("@trinary", "mixer_on-0", 2)),
        ("mixer_on_w", DmiAnim("@trinary", "mixer_on-0", 3)),
        ("mixer_f_off_n", Dmi("@trinary", "mixer_off-0_f", 1)),
        ("mixer_f_off_s", Dmi("@trinary", "mixer_off-0_f", 0)),
        ("mixer_f_off_e", Dmi("@trinary", "mixer_off-0_f", 2)),
        ("mixer_f_off_w", Dmi("@trinary", "mixer_off-0_f", 3)),
        ("mixer_f_on_n", DmiAnim("@trinary", "mixer_on-0_f", 1)),
        ("mixer_f_on_s", DmiAnim("@trinary", "mixer_on-0_f", 0)),
        ("mixer_f_on_e", DmiAnim("@trinary", "mixer_on-0_f", 2)),
        ("mixer_f_on_w", DmiAnim("@trinary", "mixer_on-0_f", 3)),
        // The two fittings in hand. tg draws every /obj/item/pipe
        // from its machine's `pipe_state` in pipe_item.dmi
        // (construction.dm:212) -- and THAT art does show every
        // connection the machine could make, because a fitting in your
        // hands has no network to be honest about. It is the one place
        // the all-connections picture belongs, and the reason the placed
        // machine must never wear it. A flipped fitting wears the same
        // picture: what differs is the machine it stands up as, and tg's
        // item art does not distinguish them either.
        ("filter_fitting", Dmi("@pipe_item", "filter", 0)),
        ("mixer_fitting", Dmi("@pipe_item", "mixer", 0)),
        ("filter_fitting_s", Dmi("@pipe_item", "filter", 0)),
        ("filter_fitting_n", Dmi("@pipe_item", "filter", 1)),
        ("filter_fitting_e", Dmi("@pipe_item", "filter", 2)),
        ("filter_fitting_w", Dmi("@pipe_item", "filter", 3)),
        ("mixer_fitting_s", Dmi("@pipe_item", "mixer", 0)),
        ("mixer_fitting_n", Dmi("@pipe_item", "mixer", 1)),
        ("mixer_fitting_e", Dmi("@pipe_item", "mixer", 2)),
        ("mixer_fitting_w", Dmi("@pipe_item", "mixer", 3)),

        // ---- the flow devices (feat/atmos-flow) --------------------------
        //
        // The rest of tg's binary roster: the volumetric pump, the
        // passive gate, the pressure valve, and the manual valve's
        // digital twin.
        //
        // FOUR pictures each for the machines with a FRONT (the pump
        // note above): tg autonormalises only its valves and adapters
        // (valve.dm:14), and the .dmi's four dirs on every pump, gate
        // and pressure valve are four genuinely different frames. The
        // manual and digital valves below keep their two -- theirs is
        // the axis machine the fold is FOR.
        ("volpump_off_n", Dmi("@binary", "volpump_off-1", 1)),
        ("volpump_off_s", Dmi("@binary", "volpump_off-1", 0)),
        ("volpump_off_e", Dmi("@binary", "volpump_off-1", 2)),
        ("volpump_off_w", Dmi("@binary", "volpump_off-1", 3)),
        // The volumetric pump's running body: ten frames at a twentieth
        // each, the longest loop in the binary family and the reason it
        // reads as a harder-working machine than the gas pump beside it.
        ("volpump_on_n", DmiAnim("@binary", "volpump_on-1", 1)),
        ("volpump_on_s", DmiAnim("@binary", "volpump_on-1", 0)),
        ("volpump_on_e", DmiAnim("@binary", "volpump_on-1", 2)),
        ("volpump_on_w", DmiAnim("@binary", "volpump_on-1", 3)),
        ("passgate_off_n", Dmi("@binary", "passgate_off-1", 1)),
        ("passgate_off_s", Dmi("@binary", "passgate_off-1", 0)),
        ("passgate_off_e", Dmi("@binary", "passgate_off-1", 2)),
        ("passgate_off_w", Dmi("@binary", "passgate_off-1", 3)),
        ("passgate_on_n", Dmi("@binary", "passgate_on-1", 1)),
        ("passgate_on_s", Dmi("@binary", "passgate_on-1", 0)),
        ("passgate_on_e", Dmi("@binary", "passgate_on-1", 2)),
        ("passgate_on_w", Dmi("@binary", "passgate_on-1", 3)),
        // The pressure valve ships a third picture, `pvalve_flow`, for
        // the pass in which gas is actually crossing. Not baked: a
        // machine's picture comes from its assembly STATE, and "armed"
        // and "armed and flowing right now" are one state with a
        // per-tick fact on top of it. That wants a per-instance overlay
        // the position machinery does not express yet -- see the same
        // note on the volume pump's overclock light.
        ("pvalve_off_n", Dmi("@binary", "pvalve_off-1", 1)),
        ("pvalve_off_s", Dmi("@binary", "pvalve_off-1", 0)),
        ("pvalve_off_e", Dmi("@binary", "pvalve_off-1", 2)),
        ("pvalve_off_w", Dmi("@binary", "pvalve_off-1", 3)),
        ("pvalve_on_n", Dmi("@binary", "pvalve_on-1", 1)),
        ("pvalve_on_s", Dmi("@binary", "pvalve_on-1", 0)),
        ("pvalve_on_e", Dmi("@binary", "pvalve_on-1", 2)),
        ("pvalve_on_w", Dmi("@binary", "pvalve_on-1", 3)),
        // The digital valve: tg's own second valve_type, drawn from the
        // `d`-prefixed half of the same sheet (valve.dm:78-83).
        ("dvalve_shut_ns", Dmi("@binary", "dvalve_off-1", 1)),
        ("dvalve_shut_ew", Dmi("@binary", "dvalve_off-1", 2)),
        ("dvalve_open_ns", Dmi("@binary", "dvalve_on-1", 1)),
        ("dvalve_open_ew", Dmi("@binary", "dvalve_on-1", 2)),
        // Its turn: seven frames of `2`, 1.4 seconds, the same length as
        // the manual valve's and a visibly smoother mechanism. Flicked by
        // the same line (valve.dm:24-29) -- the digital valve overrides
        // `update_icon_nopipes` only to add a no-power case and otherwise
        // calls `..()`.
        //
        // `DmiAnimOnce` here too, even though these two DO carry
        // `loop = 1` and would bake correctly either way. The source says
        // what the sim does with the art rather than what the sheet
        // happens to record, and a pair of valves baked two different ways
        // for a difference that does not matter would be a puzzle for
        // whoever reads this next.
        //
        // Not baked: `dvalve_nopower`. tg reaches it only through
        // `!is_operational` (valve.dm:147-150), and the base valve is
        // `use_power = NO_POWER_USE` (valve.dm:19), so NOPOWER is never
        // set on one -- it is a BROKEN/MAINT picture. This engine has no
        // broken state for atmospherics machinery, so the cell would have
        // nothing to hang on. It becomes bakeable the day one exists.
        ("dvalve_opening_ns", DmiAnimOnce("@binary", "dvalve_01-1", 1)),
        ("dvalve_opening_ew", DmiAnimOnce("@binary", "dvalve_01-1", 2)),
        ("dvalve_closing_ns", DmiAnimOnce("@binary", "dvalve_10-1", 1)),
        ("dvalve_closing_ew", DmiAnimOnce("@binary", "dvalve_10-1", 2)),
        // The fittings these are raised from, and yield back. tg draws
        // every one of them off ONE sheet: `/obj/item/pipe` is
        // `pipe_item.dmi` and its icon_state is the machine's own
        // `pipe_state` (construction.dm:17,216) -- so a fitting in your
        // hands is the machine with all its possible connections drawn
        // around it, which is the honest picture of a thing joined to
        // nothing yet.
        ("manual_valve_loose", Dmi("@pipe_item", "mvalve", 0)),
        ("digital_valve_loose", Dmi("@pipe_item", "dvalve", 0)),
        ("gas_pump_loose", Dmi("@pipe_item", "pump", 0)),
        ("volume_pump_loose", Dmi("@pipe_item", "volumepump", 0)),
        ("passive_gate_loose", Dmi("@pipe_item", "passivegate", 0)),
        ("pressure_valve_loose", Dmi("@pipe_item", "pvalve", 0)),
        ("manual_valve_loose_s", Dmi("@pipe_item", "mvalve", 0)),
        ("manual_valve_loose_n", Dmi("@pipe_item", "mvalve", 1)),
        ("manual_valve_loose_e", Dmi("@pipe_item", "mvalve", 2)),
        ("manual_valve_loose_w", Dmi("@pipe_item", "mvalve", 3)),
        ("digital_valve_loose_s", Dmi("@pipe_item", "dvalve", 0)),
        ("digital_valve_loose_n", Dmi("@pipe_item", "dvalve", 1)),
        ("digital_valve_loose_e", Dmi("@pipe_item", "dvalve", 2)),
        ("digital_valve_loose_w", Dmi("@pipe_item", "dvalve", 3)),
        ("gas_pump_loose_s", Dmi("@pipe_item", "pump", 0)),
        ("gas_pump_loose_n", Dmi("@pipe_item", "pump", 1)),
        ("gas_pump_loose_e", Dmi("@pipe_item", "pump", 2)),
        ("gas_pump_loose_w", Dmi("@pipe_item", "pump", 3)),
        ("volume_pump_loose_s", Dmi("@pipe_item", "volumepump", 0)),
        ("volume_pump_loose_n", Dmi("@pipe_item", "volumepump", 1)),
        ("volume_pump_loose_e", Dmi("@pipe_item", "volumepump", 2)),
        ("volume_pump_loose_w", Dmi("@pipe_item", "volumepump", 3)),
        ("passive_gate_loose_s", Dmi("@pipe_item", "passivegate", 0)),
        ("passive_gate_loose_n", Dmi("@pipe_item", "passivegate", 1)),
        ("passive_gate_loose_e", Dmi("@pipe_item", "passivegate", 2)),
        ("passive_gate_loose_w", Dmi("@pipe_item", "passivegate", 3)),
        ("pressure_valve_loose_s", Dmi("@pipe_item", "pvalve", 0)),
        ("pressure_valve_loose_n", Dmi("@pipe_item", "pvalve", 1)),
        ("pressure_valve_loose_e", Dmi("@pipe_item", "pvalve", 2)),
        ("pressure_valve_loose_w", Dmi("@pipe_item", "pvalve", 3)),
        // ---- end of the flow devices -------------------------------------
    ],
)
