// The machines that stand IN a pipe run rather than on it: tg's binary
// and trinary families, and the flow devices built on them.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
//
// EVERY BODY HERE IS BARE, and that is the whole shape of this file.
// tg draws a component in two passes -- `update_icon_nopipes()` puts
// down the device and nothing else, then `update_icon()` underlays one
// pipe stub per mouth from the state of the network right now
// (components_base.dm:68-111). These cells are the first pass. The
// second is `sim/atmos_machines/underlays.rs`, which reads the same
// ports the pipe grid binds gas through and asks for
// `pipe_intact_*` / `pipe_exposed_*` out of 50-pipes-and-cable.ron.
//
// The half-pipes used to be COMPOSITED IN HERE, one `pipe_intact` cell
// per node direction, and that was the defect: a picture cannot know
// what is next door, so a filter never reached its neighbours, a pump
// with one end unplumbed still showed a full-width tube, and no machine
// ever gained or lost a connection when somebody laid or cut the run
// beside it. Baked art answers "what is this machine"; only the sim can
// answer "what is it joined to". Do not composite a stub back in.
//
// DMI dirs throughout: 0 south, 1 north, 2 east, 3 west.
[
    // THE BINARY FAMILY. A binary device reaches along ONE AXIS, so
    // there are two pictures and not four: tg's
    // `PIPING_CARDINAL_AUTONORMALIZE` folds south onto north and west
    // onto east (valve.dm:14,25, `normalize_cardinal_directions`), and
    // the art agrees -- `mvalve_off-1` has no south or west cell at
    // all. The four names below are what `facing_sprites` asks for;
    // two pairs bake the same picture, which is the honest amount of
    // art a thing with two ends has.
    //
    // `-1` is tg's overlay offset for piping layers 1, 3 and 5
    // (`set_overlay_offset`, binary_devices.dm:27-32); layers 2 and 4
    // have their own `-2` bodies in tg which this pack does not bake
    // yet, so a valve on the waste main wears the default-layer body
    // over stubs drawn at its own layer. The stubs are the half that
    // has to be right -- they are what meets the run.
    ("valve_shut_n", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 1)),
    ("valve_shut_s", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 1)),
    ("valve_shut_e", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 2)),
    ("valve_shut_w", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_off-1", 2)),
    ("valve_open_n", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 1)),
    ("valve_open_s", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 1)),
    ("valve_open_e", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 2)),
    ("valve_open_w", Dmi("obj/machines/atmospherics/binary_devices.dmi", "mvalve_on-1", 2)),
    // The gas pump. tg's running body (`pump_on-1`) is a five-frame
    // loop; its first frame is baked, so a running pump reads by its
    // lit indicators rather than by moving -- the loop is a follow-up,
    // not a correction.
    ("pump_off_n", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 1)),
    ("pump_off_s", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 1)),
    ("pump_off_e", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 2)),
    ("pump_off_w", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_off-1", 2)),
    ("pump_on_n", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 1)),
    ("pump_on_s", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 1)),
    ("pump_on_e", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 2)),
    ("pump_on_w", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pump_on-1", 2)),
    // THE TRINARY MACHINES: tg's gas filter and gas mixer. FOUR
    // facings each, where a binary has two -- a binary reaches along
    // one axis and tg normalises south onto north, while a trinary
    // reaches three ways and every rotation is a different picture.
    // Which three ways is `pipes/devices.rs`'s `node_dirs`: behind the
    // facing, the facing, and `turn(dir, -90)`, so a machine's art and
    // its plumbing cannot disagree about where the side mouth is.
    //
    // The body's overlay offset is `-0` rather than `-1`, because
    // `set_overlay_offset` returns 0 for the default piping layer and
    // only layers 1 and 5 get their own (trinary_devices.dm:53-60).
    //
    // `_f` is tg's flipped body (trinary_devices.dm:12-13): node1 and
    // node3 change places while the side port stays where it is, so
    // only the body mirrors. tg's running bodies are four-frame loops;
    // the first frame is baked, as the pump's is.
    ("filter_off_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0", 1)),
    ("filter_off_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0", 0)),
    ("filter_off_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0", 2)),
    ("filter_off_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0", 3)),
    ("filter_on_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0", 1)),
    ("filter_on_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0", 0)),
    ("filter_on_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0", 2)),
    ("filter_on_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0", 3)),
    ("filter_f_off_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0_f", 1)),
    ("filter_f_off_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0_f", 0)),
    ("filter_f_off_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0_f", 2)),
    ("filter_f_off_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_off-0_f", 3)),
    ("filter_f_on_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0_f", 1)),
    ("filter_f_on_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0_f", 0)),
    ("filter_f_on_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0_f", 2)),
    ("filter_f_on_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0_f", 3)),
    ("mixer_off_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0", 1)),
    ("mixer_off_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0", 0)),
    ("mixer_off_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0", 2)),
    ("mixer_off_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0", 3)),
    ("mixer_on_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0", 1)),
    ("mixer_on_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0", 0)),
    ("mixer_on_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0", 2)),
    ("mixer_on_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0", 3)),
    ("mixer_f_off_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0_f", 1)),
    ("mixer_f_off_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0_f", 0)),
    ("mixer_f_off_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0_f", 2)),
    ("mixer_f_off_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_off-0_f", 3)),
    ("mixer_f_on_n", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0_f", 1)),
    ("mixer_f_on_s", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0_f", 0)),
    ("mixer_f_on_e", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0_f", 2)),
    ("mixer_f_on_w", Dmi("obj/machines/atmospherics/trinary_devices.dmi", "mixer_on-0_f", 3)),
    // The two fittings in hand. tg draws every /obj/item/pipe
    // from its machine's `pipe_state` in pipe_item.dmi
    // (construction.dm:212) -- and THAT art does show every
    // connection the machine could make, because a fitting in your
    // hands has no network to be honest about. It is the one place
    // the all-connections picture belongs, and the reason the placed
    // machine must never wear it. A flipped fitting wears the same
    // picture: what differs is the machine it stands up as, and tg's
    // item art does not distinguish them either.
    ("filter_fitting", Dmi("obj/pipes_n_cables/pipe_item.dmi", "filter", 0)),
    ("mixer_fitting", Dmi("obj/pipes_n_cables/pipe_item.dmi", "mixer", 0)),

    // ---- the flow devices (feat/atmos-flow) --------------------------
    //
    // The rest of tg's binary roster: the volumetric pump, the
    // passive gate, the pressure valve, and the manual valve's
    // digital twin.
    //
    // TWO pictures each, not four. A binary device reaches along one
    // AXIS (`PIPING_CARDINAL_AUTONORMALIZE`), so north and south are
    // the same picture and east and west are the other; the valve
    // and pump above bake four names for those two pictures, which
    // is two atlas cells apiece nobody looks at. These name the
    // AXIS instead and let `facing_sprites` point two directions at
    // one name, which is the same art and half the atlas.
    ("volpump_off_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "volpump_off-1", 1)),
    ("volpump_off_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "volpump_off-1", 2)),
    // tg's running body is a ten-frame loop; its first frame is
    // baked, so a running pump reads by its lit indicators rather
    // than by moving. The loop is a follow-up, not a correction.
    ("volpump_on_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "volpump_on-1", 1)),
    ("volpump_on_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "volpump_on-1", 2)),
    ("passgate_off_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "passgate_off-1", 1)),
    ("passgate_off_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "passgate_off-1", 2)),
    ("passgate_on_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "passgate_on-1", 1)),
    ("passgate_on_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "passgate_on-1", 2)),
    // The pressure valve ships a third picture, `pvalve_flow`, for
    // the pass in which gas is actually crossing. Not baked: a
    // machine's picture comes from its assembly STATE, and "armed"
    // and "armed and flowing right now" are one state with a
    // per-tick fact on top of it. That wants a per-instance overlay
    // the position machinery does not express yet -- see the same
    // note on the volume pump's overclock light.
    ("pvalve_off_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pvalve_off-1", 1)),
    ("pvalve_off_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pvalve_off-1", 2)),
    ("pvalve_on_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pvalve_on-1", 1)),
    ("pvalve_on_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "pvalve_on-1", 2)),
    // The digital valve: tg's own second valve_type, drawn from the
    // `d`-prefixed half of the same sheet (valve.dm:78-83).
    ("dvalve_shut_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "dvalve_off-1", 1)),
    ("dvalve_shut_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "dvalve_off-1", 2)),
    ("dvalve_open_ns", Dmi("obj/machines/atmospherics/binary_devices.dmi", "dvalve_on-1", 1)),
    ("dvalve_open_ew", Dmi("obj/machines/atmospherics/binary_devices.dmi", "dvalve_on-1", 2)),
    // The fittings these are raised from, and yield back. tg draws
    // every one of them off ONE sheet: `/obj/item/pipe` is
    // `pipe_item.dmi` and its icon_state is the machine's own
    // `pipe_state` (construction.dm:17,216) -- so a fitting in your
    // hands is the machine with all its possible connections drawn
    // around it, which is the honest picture of a thing joined to
    // nothing yet.
    ("manual_valve_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "mvalve", 0)),
    ("digital_valve_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "dvalve", 0)),
    ("gas_pump_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "pump", 0)),
    ("volume_pump_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "volumepump", 0)),
    ("passive_gate_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "passivegate", 0)),
    ("pressure_valve_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "pvalve", 0)),
    // ---- end of the flow devices -------------------------------------
]
