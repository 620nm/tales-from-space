        ("obj/machines/atmospherics/trinary_devices.dmi", "cap", 0),
        ("obj/machines/atmospherics/trinary_devices.dmi", "cap", 3),
        ("obj/machines/atmospherics/trinary_devices.dmi", "filter_on-0_f", 0),
    ])),
    ("filter_f_on_e", DmiCells([
