// The thermal pair, the two pipe adapters, the two room devices, and
// the canisters they all move gas into and out of.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
[
    // ---- the thermal pair, and the two adapters ----------------------
    //
    // THE THERMAL PAIR share the binary sheet and the valve's recipe
    // above: two lengths of `pipe_intact` under the body, and the
    // body itself at `-1`, tg's overlay offset for piping layers 1,
    // 3 and 5 (`set_overlay_offset`). Both fold south onto north and
    // west onto east, which is all a machine with two ends and one
    // axis of art has to say. DMI dirs throughout: 0 south, 1 north,
    // 2 east, 3 west.
    //
    // tg's armed gate is a six-frame loop (`tgate_on-1`) and it has
    // a THIRD state, `tgate_flow`, for the moment gas is actually
    // crossing (temperature_gate.dm:57-63). Neither is baked: the
    // first frame reads by its lit body, and "is anything crossing
    // right now" is a question for the panel, which answers it with
    // two port pressures rather than by flickering.
    ("tgate_off_ns", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
        ("obj/machines/atmospherics/binary_devices.dmi", "tgate_off-1", 1),
    ])),
    ("tgate_off_ew", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
        ("obj/machines/atmospherics/binary_devices.dmi", "tgate_off-1", 2),
    ])),
    ("tgate_on_ns", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
        ("obj/machines/atmospherics/binary_devices.dmi", "tgate_on-1", 1),
    ])),
    ("tgate_on_ew", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
        ("obj/machines/atmospherics/binary_devices.dmi", "tgate_on-1", 2),
    ])),
    ("tpump_off_ns", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
        ("obj/machines/atmospherics/binary_devices.dmi", "tpump_off-1", 1),
    ])),
    ("tpump_off_ew", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
        ("obj/machines/atmospherics/binary_devices.dmi", "tpump_off-1", 2),
    ])),
    ("tpump_on_ns", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 1),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 0),
        ("obj/machines/atmospherics/binary_devices.dmi", "tpump_on-1", 1),
    ])),
    ("tpump_on_ew", DmiCells([
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 2),
        ("obj/machines/atmospherics/binary_devices.dmi", "pipe_intact", 3),
        ("obj/machines/atmospherics/binary_devices.dmi", "tpump_on-1", 2),
    ])),
    // THE PLATE is the odd one, and its cells are REVERSED on
    // purpose. tg points a unary device at its PIPE
    // (unary_devices.dm:14, `initialize_directions = dir`), so its
    // face looks the other way; this engine points a machine at what
    // it DOES, so `facing` here is the face. A plate drawn facing
    // north is therefore tg's `he1` pointed south, and so on round.
    // `he1` rather than `he0` because a plate with no pipe behind it
    // is one somebody has not finished plumbing, not a second kind
    // of plate.
    ("he_plate_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "he1", 0)),
    ("he_plate_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "he1", 1)),
    ("he_plate_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "he1", 3)),
    ("he_plate_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "he1", 2)),
    // THE ADAPTERS are pipe, and each comes off its own sheet.
    //
    // tg draws both as a centre piece plus one stub per connection
    // it actually found, tinted per node: the colour adapter's
    // `update_overlays` walks `nodes` and colours each stub with
    // THAT run's paint (color_adapter.dm:46-58), and the layer
    // manifold draws a stub per layer per end off a whole separate
    // underlay sheet (layer_manifold_underlays.dmi). Both are
    // per-instance compositions of a live network, which is not a
    // thing a baked atlas cell can be. So each bakes as its centre
    // plus a straight run through it -- what one looks like in the
    // ordinary case of being plumbed at both ends -- and the
    // per-node tinting waits on runtime sprite tinting with the
    // rest of it.
    ("color_adapter_ns", DmiCells([
        ("obj/pipes_n_cables/color_adapter.dmi", "pipe", 1),
        ("obj/pipes_n_cables/color_adapter.dmi", "pipe", 0),
        ("obj/pipes_n_cables/color_adapter.dmi", "adapter_center", 1),
    ])),
    ("color_adapter_ew", DmiCells([
        ("obj/pipes_n_cables/color_adapter.dmi", "pipe", 2),
        ("obj/pipes_n_cables/color_adapter.dmi", "pipe", 3),
        ("obj/pipes_n_cables/color_adapter.dmi", "adapter_center", 2),
    ])),
    ("layer_adapter_ns", DmiCells([
        ("obj/pipes_n_cables/manifold.dmi", "manifoldlayer", 1),
        ("obj/pipes_n_cables/manifold.dmi", "manifoldlayer_center", 1),
    ])),
    ("layer_adapter_ew", DmiCells([
        ("obj/pipes_n_cables/manifold.dmi", "manifoldlayer", 2),
        ("obj/pipes_n_cables/manifold.dmi", "manifoldlayer_center", 2),
    ])),
    // And the five fittings they are raised from, off the same one
    // sheet as every other `/obj/item/pipe`.
    ("temperature_gate_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "tgate", 0)),
    ("temperature_pump_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "tpump", 0)),
    ("heat_exchanger_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "heunary", 0)),
    ("layer_adapter_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "manifoldlayer", 0)),
    ("color_adapter_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "adapter_center", 0)),
    // ---- end of the thermal devices and adapters ---------------------
    // ---- the two room devices ----------------------------------------
    //
    // The scrubber and the injector are UNARY, and their cells are
    // REVERSED for the same reason the plate's are: tg points a
    // unary device at its PIPE (unary_devices.dm:14) so its face
    // looks the other way, and this engine points a machine at what
    // it DOES. So the scrubber drawn facing north is tg's sprite
    // pointed south.
    //
    // Three pictures for the scrubber, because it has three
    // positions: dead, filtering, and emptying the room. tg draws
    // the last one differently on purpose (`scrub_purge`,
    // vent_scrubber.dm:142) and it is the one a passer-by most
    // needs to recognise. `scrub_on` and `scrub_purge` are loops
    // (24 and 8 frames); their first frames are baked, so a running
    // scrubber reads by its lit grille rather than by moving.
    // `scrub_wide` is deliberately absent — widenet is deferred, and
    // a picture for a mode that cannot be selected would be a lie.
    ("scrubber_off_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_off", 0)),
    ("scrubber_off_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_off", 1)),
    ("scrubber_off_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_off", 3)),
    ("scrubber_off_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_off", 2)),
    ("scrubber_on_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_on", 0)),
    ("scrubber_on_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_on", 1)),
    ("scrubber_on_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_on", 3)),
    ("scrubber_on_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_on", 2)),
    ("scrubber_purge_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_purge", 0)),
    ("scrubber_purge_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_purge", 1)),
    ("scrubber_purge_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_purge", 3)),
    ("scrubber_purge_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "scrub_purge", 2)),
    // The injector has two, and no third: it only ever runs one way.
    ("injector_off_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_off", 0)),
    ("injector_off_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_off", 1)),
    ("injector_off_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_off", 3)),
    ("injector_off_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_off", 2)),
    ("injector_on_n", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_on", 0)),
    ("injector_on_s", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_on", 1)),
    ("injector_on_e", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_on", 3)),
    ("injector_on_w", Dmi("obj/machines/atmospherics/unary_devices.dmi", "inje_on", 2)),
    // And the two fittings, off the one sheet every /obj/item/pipe
    // is drawn from.
    ("air_scrubber_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "scrubber", 0)),
    ("air_injector_loose", Dmi("obj/pipes_n_cables/pipe_item.dmi", "injector", 0)),
    // ---- end of the room devices -------------------------------------
    // A gas canister: tg's art is greyscale and each gas type paints
    // it (greyscale_colors "#c6c0b5" is pre-mixed air). Baked with
    // that colour for now; it moves to per-object paint when the
    // renderer can tint a sprite on both paths.
    // tg's canister greyscale recipe, whole (canister_base.json +
    // canister_post_effects.json): a white shell mask that takes the
    // colour, two shader passes, and a coloured outline. Baking only
    // `base` — which is 329 pixels of pure white — is why this drew
    // as a flat blob with no edge.
    //
    // Left greyscale with a DECLARED colour rather than a baked one,
    // so a canister can be painted by its gas the way tg paints
    // them. The one cost: `add_shader` is a highlight tg adds AFTER
    // colouring, and added to a white base it clamps away, leaving
    // this ~7% darker than tg's. The shape, which is what was
    // actually missing, is exact.
    ("canister", Tinted(DmiBlend(
        dmi: "obj/pipes_n_cables/canisters.dmi",
        layers: [
            ("base", Over, true),
            ("add_shader", Add, false),
            ("multi_shader", Multiply, false),
            ("outline", Over, true),
        ],
        dir: 0,
        paint: (255, 255, 255),
    ), (198, 192, 181))),
    // The same shell wearing tg's `can-connector` — the picture a
    // canister only has while it is fastened to a port
    // (canister.dm's update_overlays: `if(connected_port)`). It is
    // a STATE SPRITE rather than an overlay because the canister's
    // overlay slot is already spoken for by the gauge, which the
    // sim rewrites every time the pressure band moves; the two
    // would fight for the same component every tick. tg does not
    // RESET_COLOR this one either, so it takes the gas's colour
    // along with the rest of the shell, which is why it rides
    // inside the blend.
    ("canister_connected", Tinted(DmiBlend(
        dmi: "obj/pipes_n_cables/canisters.dmi",
        layers: [
            ("base", Over, true),
            ("add_shader", Add, false),
            ("multi_shader", Multiply, false),
            ("outline", Over, true),
            ("can-connector", Over, false),
        ],
        dir: 0,
        paint: (255, 255, 255),
    ), (198, 192, 181))),
    // The indicator lamps are NOT coloured by the gas (tg's
    // post_effects leaves them alone), so they ride as their own
    // untinted overlay.
    ("canister_lights", Dmi("obj/pipes_n_cables/canisters.dmi", "lights", 0)),
    ("canister_g0", Dmi("obj/pipes_n_cables/canisters.dmi", "can-0", 0)),
    ("canister_g1", Dmi("obj/pipes_n_cables/canisters.dmi", "can-1", 0)),
    ("canister_g2", Dmi("obj/pipes_n_cables/canisters.dmi", "can-2", 0)),
    ("canister_g3", Dmi("obj/pipes_n_cables/canisters.dmi", "can-3", 0)),
    ("metal", Dmi("obj/stack_objects.dmi", "sheet-metal_3", 0)),
    ("floor_tile", Dmi("obj/tiles.dmi", "tile", 0)),
    ("tv", Dmi("obj/machines/computer.dmi", "detective_tv", 0)),
    ("white", White),

]
