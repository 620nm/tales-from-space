// The cap tg draws over each mouth of a device, whether or not a run meets
// it (`get_pipe_image`, atmosmachinery.dm:536-542). Direction is the mouth's.
// A cap is drawn in the body's own frame and rides its seat, so a cell holds
// only the forward shift trinary devices take on layers 1 and 5, along the
// mouth. dy runs down the sheet.
//
// DMI dirs: 0 south, 1 north, 2 east, 3 west. Names end in the network mask.
(
    sheets: [
        ("trinary", "obj/machines/atmospherics/trinary_devices.dmi"),
        ("unary", "obj/machines/atmospherics/unary_devices.dmi"),
    ],
    sprites: [
        // cap
        ("pipe_cap_inline_l1_1", DmiCellsAt([(dmi: "@trinary", state: "cap", dir: 1, dx: 0, dy: 4)])),
        ("pipe_cap_inline_l1_2", DmiCellsAt([(dmi: "@trinary", state: "cap", dir: 0, dx: 0, dy: 4)])),
        ("pipe_cap_inline_l1_4", DmiCellsAt([(dmi: "@trinary", state: "cap", dir: 2, dx: -4, dy: 0)])),
        ("pipe_cap_inline_l1_8", DmiCellsAt([(dmi: "@trinary", state: "cap", dir: 3, dx: -4, dy: 0)])),
