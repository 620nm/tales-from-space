// What a sprite looks like in somebody's hand or on their body -- tg's
// inhand sheets and the worn overlays the paper doll composes.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then expansion order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    // Aliases are file-local on purpose: this family can move without a
    // central sheet registry, while a path correction is still one edit.
    sheets: [
        ("tools_l", "mob/inhands/equipment/tools_lefthand.dmi"),
        ("tools_r", "mob/inhands/equipment/tools_righthand.dmi"),
        ("toolbox_l", "mob/inhands/equipment/toolbox_lefthand.dmi"),
        ("toolbox_r", "mob/inhands/equipment/toolbox_righthand.dmi"),
        ("backpack_l", "mob/inhands/equipment/backpack_lefthand.dmi"),
        ("backpack_r", "mob/inhands/equipment/backpack_righthand.dmi"),
        ("id_l", "mob/inhands/equipment/idcards_lefthand.dmi"),
        ("id_r", "mob/inhands/equipment/idcards_righthand.dmi"),
        ("sheets_l", "mob/inhands/items/sheets_lefthand.dmi"),
        ("sheets_r", "mob/inhands/items/sheets_righthand.dmi"),
        ("tiles_l", "mob/inhands/items/tiles_lefthand.dmi"),
        ("tiles_r", "mob/inhands/items/tiles_righthand.dmi"),
        ("items_l", "mob/inhands/items_lefthand.dmi"),
        ("items_r", "mob/inhands/items_righthand.dmi"),
        ("drinks_l", "mob/inhands/items/drinks_lefthand.dmi"),
        ("drinks_r", "mob/inhands/items/drinks_righthand.dmi"),
        ("devices_l", "mob/inhands/items/devices_lefthand.dmi"),
        ("devices_r", "mob/inhands/items/devices_righthand.dmi"),
    ],
    groups: [
        // What a carried item looks like ON the mob. tg keeps these
        // apart from the worn_* sheets entirely: `/obj/item` declares
        // `inhand_icon_state` plus a PAIR of files (`lefthand_file` /
        // `righthand_file`). Left vs right is the FILE, never a generated
        // state suffix, so both hand bases remain literal and greppable.
        // No render offset: tg only shifts hands 3 and 4 (multi-armed
        // mobs) by 16px; a two-handed human's overlays sit at 0,0.
        (sheet: "tools_l", sprites: [Directions("held_crowbar_l", "crowbar")]),
        (sheet: "tools_r", sprites: [Directions("held_crowbar_r", "crowbar")]),
        (sheet: "tools_l", sprites: [Directions("held_welder_l", "welder")]),
        (sheet: "tools_r", sprites: [Directions("held_welder_r", "welder")]),
        (sheet: "tools_l", sprites: [BlendDirections(
            name: "held_screwdriver_l",
            layers: [("screwdriver", Over, true), ("screwdriver_head", Over, false)],
            paint: (149, 23, 16),
        )]),
        (sheet: "tools_r", sprites: [BlendDirections(
            name: "held_screwdriver_r",
            layers: [("screwdriver", Over, true), ("screwdriver_head", Over, false)],
            paint: (149, 23, 16),
        )]),
        (sheet: "tools_l", sprites: [Directions("held_wrench_l", "wrench")]),
        (sheet: "tools_r", sprites: [Directions("held_wrench_r", "wrench")]),
        (sheet: "tools_l", sprites: [BlendDirections(
            name: "held_wirecutters_l",
            layers: [("cutters", Over, true), ("cutters_cutty_thingy", Over, false)],
            paint: (255, 0, 0),
        )]),
        (sheet: "tools_r", sprites: [BlendDirections(
            name: "held_wirecutters_r",
            layers: [("cutters", Over, true), ("cutters_cutty_thingy", Over, false)],
            paint: (255, 0, 0),
        )]),
        (sheet: "tools_l", sprites: [Directions("held_coil_l", "coil_yellow")]),
        (sheet: "tools_r", sprites: [Directions("held_coil_r", "coil_yellow")]),
        (sheet: "toolbox_l", sprites: [Directions("held_toolbox_l", "toolbox_red")]),
        (sheet: "toolbox_r", sprites: [Directions("held_toolbox_r", "toolbox_red")]),
        (sheet: "backpack_l", sprites: [Directions("held_backpack_l", "backpack")]),
        (sheet: "backpack_r", sprites: [Directions("held_backpack_r", "backpack")]),
        (sheet: "id_l", sprites: [Directions("held_id_l", "card-id")]),
        (sheet: "id_r", sprites: [Directions("held_id_r", "card-id")]),
        (sheet: "sheets_l", sprites: [Directions("held_metal_l", "sheet-metal")]),
        (sheet: "sheets_r", sprites: [Directions("held_metal_r", "sheet-metal")]),
        (sheet: "tiles_l", sprites: [Directions("held_floor_tile_l", "tile")]),
        (sheet: "tiles_r", sprites: [Directions("held_floor_tile_r", "tile")]),
        (sheet: "items_l", sprites: [Directions("held_headset_l", "headset")]),
        (sheet: "items_r", sprites: [Directions("held_headset_r", "headset")]),
        (sheet: "items_l", sprites: [Directions("held_beaker_l", "beaker")]),
        (sheet: "items_r", sprites: [Directions("held_beaker_r", "beaker")]),
        (sheet: "drinks_l", sprites: [Directions("held_cola_l", "cola")]),
        (sheet: "drinks_r", sprites: [Directions("held_cola_r", "cola")]),
        (sheet: "devices_l", sprites: [Directions("held_board_l", "electronic")]),
        (sheet: "devices_r", sprites: [Directions("held_board_r", "electronic")]),
    ],
)
