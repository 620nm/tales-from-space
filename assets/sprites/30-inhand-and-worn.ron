// What a sprite looks like in somebody's hand or on their body -- tg's
// inhand sheets and the worn overlays the paper doll composes.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
[
    // ---- in-hand overlays -------------------------------------
    // What a carried item looks like ON the mob. tg keeps these
    // apart from the worn_* sheets entirely: `/obj/item` declares
    // `inhand_icon_state` plus a PAIR of files (`lefthand_file` /
    // `righthand_file`) scattered through icons/mob/inhands/, and
    // an item points at whichever category file happens to hold
    // its state. Left vs right is the FILE, never a state suffix —
    // hence `_l` / `_r` here, one baked family per hand, so a
    // two-item carry doesn't stack both pictures on one shoulder.
    // No render offset: tg only shifts hands 3 and 4 (multi-armed
    // mobs) by 16px; a two-handed human's overlays sit at 0,0.
    ("held_crowbar_l_s", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 0)),
    ("held_crowbar_l_n", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 1)),
    ("held_crowbar_l_e", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 2)),
    ("held_crowbar_l_w", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "crowbar", 3)),
    ("held_crowbar_r_s", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 0)),
    ("held_crowbar_r_n", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 1)),
    ("held_crowbar_r_e", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 2)),
    ("held_crowbar_r_w", Dmi("mob/inhands/equipment/tools_righthand.dmi", "crowbar", 3)),
    ("held_welder_l_s", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "welder", 0)),
    ("held_welder_l_n", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "welder", 1)),
    ("held_welder_l_e", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "welder", 2)),
    ("held_welder_l_w", Dmi("mob/inhands/equipment/tools_lefthand.dmi", "welder", 3)),
    ("held_welder_r_s", Dmi("mob/inhands/equipment/tools_righthand.dmi", "welder", 0)),
    ("held_welder_r_n", Dmi("mob/inhands/equipment/tools_righthand.dmi", "welder", 1)),
    ("held_welder_r_e", Dmi("mob/inhands/equipment/tools_righthand.dmi", "welder", 2)),
    ("held_welder_r_w", Dmi("mob/inhands/equipment/tools_righthand.dmi", "welder", 3)),
    ("held_screwdriver_l_s", DmiBlend(
        dmi: "mob/inhands/equipment/tools_lefthand.dmi",
        layers: [("screwdriver", Over, true), ("screwdriver_head", Over, false)],
        dir: 0,
