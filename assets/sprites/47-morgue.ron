// The morgue, off tg's general structures sheet (icons/obj/structures.dmi,
// code/game/objects/structures/morgue.dm).
//
// One facing of the four the sheet ships, because a cadaver chamber is a
// container and takes no aimed `dir`. `morgue1` is the shut, empty face the
// file names as its base, `morgue0` the open one, and the other two are what
// `update_icon_state` swaps to for what is inside (morgue.dm:384-403):
// `morgue3` is things and nobody, `morgue2` a corpse.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in this
// directory is baked, in FILE-NAME order and then entry order, so the
// atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    sheets: [
        ("structures", "obj/structures.dmi"),
    ],
    sprites: [
        ("morgue0_s", Dmi("@structures", "morgue0", 0)),
        ("morgue1_s", Dmi("@structures", "morgue1", 0)),
        ("morgue2_s", Dmi("@structures", "morgue2", 0)),
        ("morgue3_s", Dmi("@structures", "morgue3", 0)),
    ],
)
