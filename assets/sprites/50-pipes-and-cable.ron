// Subfloor infrastructure. Pipe, cable and stub art lives as tagged
// Aseprite documents under originals/pipes_n_cables/, converted from
// tg's matching .dmi sheets by `cargo run -p xtask -- convert-dmi`.
// State names stay verbatim: the client still builds pipe_l3_5 etc.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    // Sheet aliases are local to this family; @names below resolve here.
    sheets: [
        ("pipes_bitmask", "pipes_n_cables/pipes_bitmask.aseprite"),
        ("cable", "pipes_n_cables/layer_cable.aseprite"),
        ("manifold_underlays", "pipes_n_cables/layer_manifold_underlays.aseprite"),
        ("pipe_underlays", "pipes_n_cables/pipe_underlays.aseprite"),
    ],
    sprites: [
        // Atmospheric pipe, tg's !pipes_bitmask.dmi state names kept
        // verbatim: "<field>_<piping layer>". The field is tg's
        // CARDINAL_TO_FULLPIPES/_SHORTPIPES pair -- low nibble the
        // directions the run actually joins, high nibble the short
        // stub drawn where it does not, so a length with one
        // connection reads as a pipe that ENDS rather than a piece of
        // a longer one. Sixteen shapes cover every adjacency; five
        // layers cross without meeting. The client derives WHICH from
        // its own neighbour scan, so the wire carries only topology.
        // Art is greyscale on purpose (tg tints per pipe); unpainted
        // grey is what a pipe dispenser hands you.
        ("pipe_l1_0", Ase("@pipes_bitmask", "48_1-s")),
        ("pipe_l1_1", Ase("@pipes_bitmask", "33_1-s")),
        ("pipe_l1_2", Ase("@pipes_bitmask", "18_1-s")),
        ("pipe_l1_3", Ase("@pipes_bitmask", "3_1-s")),
        ("pipe_l1_4", Ase("@pipes_bitmask", "132_1-s")),
        ("pipe_l1_5", Ase("@pipes_bitmask", "5_1-s")),
        ("pipe_l1_6", Ase("@pipes_bitmask", "6_1-s")),
        ("pipe_l1_7", Ase("@pipes_bitmask", "7_1-s")),
        ("pipe_l1_8", Ase("@pipes_bitmask", "72_1-s")),
        ("pipe_l1_9", Ase("@pipes_bitmask", "9_1-s")),
        ("pipe_l1_10", Ase("@pipes_bitmask", "10_1-s")),
        ("pipe_l1_11", Ase("@pipes_bitmask", "11_1-s")),
        ("pipe_l1_12", Ase("@pipes_bitmask", "12_1-s")),
        ("pipe_l1_13", Ase("@pipes_bitmask", "13_1-s")),
        ("pipe_l1_14", Ase("@pipes_bitmask", "14_1-s")),
        ("pipe_l1_15", Ase("@pipes_bitmask", "15_1-s")),
        ("pipe_l2_0", Ase("@pipes_bitmask", "48_2-s")),
        ("pipe_l2_1", Ase("@pipes_bitmask", "33_2-s")),
        ("pipe_l2_2", Ase("@pipes_bitmask", "18_2-s")),
        ("pipe_l2_3", Ase("@pipes_bitmask", "3_2-s")),
        ("pipe_l2_4", Ase("@pipes_bitmask", "132_2-s")),
        ("pipe_l2_5", Ase("@pipes_bitmask", "5_2-s")),
        ("pipe_l2_6", Ase("@pipes_bitmask", "6_2-s")),
        ("pipe_l2_7", Ase("@pipes_bitmask", "7_2-s")),
        ("pipe_l2_8", Ase("@pipes_bitmask", "72_2-s")),
        ("pipe_l2_9", Ase("@pipes_bitmask", "9_2-s")),
        ("pipe_l2_10", Ase("@pipes_bitmask", "10_2-s")),
        ("pipe_l2_11", Ase("@pipes_bitmask", "11_2-s")),
        ("pipe_l2_12", Ase("@pipes_bitmask", "12_2-s")),
        ("pipe_l2_13", Ase("@pipes_bitmask", "13_2-s")),
        ("pipe_l2_14", Ase("@pipes_bitmask", "14_2-s")),
        ("pipe_l2_15", Ase("@pipes_bitmask", "15_2-s")),
        ("pipe_l3_0", Ase("@pipes_bitmask", "48_3-s")),
        ("pipe_l3_1", Ase("@pipes_bitmask", "33_3-s")),
        ("pipe_l3_2", Ase("@pipes_bitmask", "18_3-s")),
        ("pipe_l3_3", Ase("@pipes_bitmask", "3_3-s")),
        ("pipe_l3_4", Ase("@pipes_bitmask", "132_3-s")),
        ("pipe_l3_5", Ase("@pipes_bitmask", "5_3-s")),
        ("pipe_l3_6", Ase("@pipes_bitmask", "6_3-s")),
        ("pipe_l3_7", Ase("@pipes_bitmask", "7_3-s")),
        ("pipe_l3_8", Ase("@pipes_bitmask", "72_3-s")),
        ("pipe_l3_9", Ase("@pipes_bitmask", "9_3-s")),
        ("pipe_l3_10", Ase("@pipes_bitmask", "10_3-s")),
        ("pipe_l3_11", Ase("@pipes_bitmask", "11_3-s")),
        ("pipe_l3_12", Ase("@pipes_bitmask", "12_3-s")),
        ("pipe_l3_13", Ase("@pipes_bitmask", "13_3-s")),
        ("pipe_l3_14", Ase("@pipes_bitmask", "14_3-s")),
        ("pipe_l3_15", Ase("@pipes_bitmask", "15_3-s")),
        ("pipe_l4_0", Ase("@pipes_bitmask", "48_4-s")),
        ("pipe_l4_1", Ase("@pipes_bitmask", "33_4-s")),
        ("pipe_l4_2", Ase("@pipes_bitmask", "18_4-s")),
        ("pipe_l4_3", Ase("@pipes_bitmask", "3_4-s")),
        ("pipe_l4_4", Ase("@pipes_bitmask", "132_4-s")),
        ("pipe_l4_5", Ase("@pipes_bitmask", "5_4-s")),
        ("pipe_l4_6", Ase("@pipes_bitmask", "6_4-s")),
        ("pipe_l4_7", Ase("@pipes_bitmask", "7_4-s")),
        ("pipe_l4_8", Ase("@pipes_bitmask", "72_4-s")),
        ("pipe_l4_9", Ase("@pipes_bitmask", "9_4-s")),
        ("pipe_l4_10", Ase("@pipes_bitmask", "10_4-s")),
        ("pipe_l4_11", Ase("@pipes_bitmask", "11_4-s")),
        ("pipe_l4_12", Ase("@pipes_bitmask", "12_4-s")),
        ("pipe_l4_13", Ase("@pipes_bitmask", "13_4-s")),
        ("pipe_l4_14", Ase("@pipes_bitmask", "14_4-s")),
        ("pipe_l4_15", Ase("@pipes_bitmask", "15_4-s")),
        ("pipe_l5_0", Ase("@pipes_bitmask", "48_5-s")),
        ("pipe_l5_1", Ase("@pipes_bitmask", "33_5-s")),
        ("pipe_l5_2", Ase("@pipes_bitmask", "18_5-s")),
        ("pipe_l5_3", Ase("@pipes_bitmask", "3_5-s")),
        ("pipe_l5_4", Ase("@pipes_bitmask", "132_5-s")),
        ("pipe_l5_5", Ase("@pipes_bitmask", "5_5-s")),
        ("pipe_l5_6", Ase("@pipes_bitmask", "6_5-s")),
        ("pipe_l5_7", Ase("@pipes_bitmask", "7_5-s")),
        ("pipe_l5_8", Ase("@pipes_bitmask", "72_5-s")),
        ("pipe_l5_9", Ase("@pipes_bitmask", "9_5-s")),
        ("pipe_l5_10", Ase("@pipes_bitmask", "10_5-s")),
        ("pipe_l5_11", Ase("@pipes_bitmask", "11_5-s")),
        ("pipe_l5_12", Ase("@pipes_bitmask", "12_5-s")),
        ("pipe_l5_13", Ase("@pipes_bitmask", "13_5-s")),
        ("pipe_l5_14", Ase("@pipes_bitmask", "14_5-s")),
        ("pipe_l5_15", Ase("@pipes_bitmask", "15_5-s")),
        // THE CONNECTION STUBS a machine standing in a run wears, and the
        // reason its picture is no longer frozen at bake time.
        //
        // tg draws every atmospherics component BARE and then underlays
        // one of these per mouth, per instance
        // (`/obj/machinery/atmospherics/components/update_icon()`,
        // components_base.dm:68-111): `intact_[node_dir]_[layer]` where
        // that mouth actually found a neighbour, `exposed_[direction]_
        // [layer]` where it reaches and found nothing. Which is why a tg
        // filter meets the run on both sides of it and a tg pump with one
        // end unplumbed shows a capped stub there -- neither of which a
        // baked-in half-pipe can say, because a baked cell cannot know
        // what is next door.
        //
        // Forty cells: two kinds x the four cardinals x tg's five piping
        // layers. tg names them `<kind>_<dir bit>_<layer>` and the bits
        // are BYOND's (1 N, 2 S, 4 E, 8 W); the names here put the family
        // first and the layer before the direction, which is the order
        // `pipe_l3_5` above already reads in. The layer is baked into the
        // ART rather than applied as a shift: tg's sheet ships each stub
        // pre-offset per layer, so `pipe_intact_l2_1` lines up with
        // `pipe_l2_*` exactly and a stub meets the run it points at with
        // no seam. Greyscale for the same reason the run is -- the engine
        // paints each stub with the colour of the run it reaches, tg's
        // `pipe_appearance.color = node.pipe_color`.
        ("pipe_intact_l1_1", Ase("@pipe_underlays", "intact_1_1-s")),
        ("pipe_intact_l1_2", Ase("@pipe_underlays", "intact_2_1-s")),
        ("pipe_intact_l1_4", Ase("@pipe_underlays", "intact_4_1-s")),
        ("pipe_intact_l1_8", Ase("@pipe_underlays", "intact_8_1-s")),
        ("pipe_intact_l2_1", Ase("@pipe_underlays", "intact_1_2-s")),
        ("pipe_intact_l2_2", Ase("@pipe_underlays", "intact_2_2-s")),
        ("pipe_intact_l2_4", Ase("@pipe_underlays", "intact_4_2-s")),
        ("pipe_intact_l2_8", Ase("@pipe_underlays", "intact_8_2-s")),
        ("pipe_intact_l3_1", Ase("@pipe_underlays", "intact_1_3-s")),
        ("pipe_intact_l3_2", Ase("@pipe_underlays", "intact_2_3-s")),
        ("pipe_intact_l3_4", Ase("@pipe_underlays", "intact_4_3-s")),
        ("pipe_intact_l3_8", Ase("@pipe_underlays", "intact_8_3-s")),
        ("pipe_intact_l4_1", Ase("@pipe_underlays", "intact_1_4-s")),
        ("pipe_intact_l4_2", Ase("@pipe_underlays", "intact_2_4-s")),
        ("pipe_intact_l4_4", Ase("@pipe_underlays", "intact_4_4-s")),
        ("pipe_intact_l4_8", Ase("@pipe_underlays", "intact_8_4-s")),
        ("pipe_intact_l5_1", Ase("@pipe_underlays", "intact_1_5-s")),
        ("pipe_intact_l5_2", Ase("@pipe_underlays", "intact_2_5-s")),
        ("pipe_intact_l5_4", Ase("@pipe_underlays", "intact_4_5-s")),
        ("pipe_intact_l5_8", Ase("@pipe_underlays", "intact_8_5-s")),
        ("pipe_exposed_l1_1", Ase("@pipe_underlays", "exposed_1_1-s")),
        ("pipe_exposed_l1_2", Ase("@pipe_underlays", "exposed_2_1-s")),
        ("pipe_exposed_l1_4", Ase("@pipe_underlays", "exposed_4_1-s")),
        ("pipe_exposed_l1_8", Ase("@pipe_underlays", "exposed_8_1-s")),
        ("pipe_exposed_l2_1", Ase("@pipe_underlays", "exposed_1_2-s")),
        ("pipe_exposed_l2_2", Ase("@pipe_underlays", "exposed_2_2-s")),
        ("pipe_exposed_l2_4", Ase("@pipe_underlays", "exposed_4_2-s")),
        ("pipe_exposed_l2_8", Ase("@pipe_underlays", "exposed_8_2-s")),
        ("pipe_exposed_l3_1", Ase("@pipe_underlays", "exposed_1_3-s")),
        ("pipe_exposed_l3_2", Ase("@pipe_underlays", "exposed_2_3-s")),
        ("pipe_exposed_l3_4", Ase("@pipe_underlays", "exposed_4_3-s")),
        ("pipe_exposed_l3_8", Ase("@pipe_underlays", "exposed_8_3-s")),
        ("pipe_exposed_l4_1", Ase("@pipe_underlays", "exposed_1_4-s")),
        ("pipe_exposed_l4_2", Ase("@pipe_underlays", "exposed_2_4-s")),
        ("pipe_exposed_l4_4", Ase("@pipe_underlays", "exposed_4_4-s")),
        ("pipe_exposed_l4_8", Ase("@pipe_underlays", "exposed_8_4-s")),
        ("pipe_exposed_l5_1", Ase("@pipe_underlays", "exposed_1_5-s")),
        ("pipe_exposed_l5_2", Ase("@pipe_underlays", "exposed_2_5-s")),
        ("pipe_exposed_l5_4", Ase("@pipe_underlays", "exposed_4_5-s")),
        ("pipe_exposed_l5_8", Ase("@pipe_underlays", "exposed_8_5-s")),
        // THE OTHER STUB, for the one machine that stands across all five
        // layers at once. tg keeps a second sheet for it
        // (`layer_manifold_underlays.dmi`, drawn by
        // `get_attached_image`, layermanifold.dm:78-82) and the
        // difference is where the tube STOPS: a component's stub runs to
        // the machine's body, which tg has shifted off centre by its
        // piping layer, while this one runs to the tile centre, because
        // the body it meets is a band across the middle of the tile that
        // was never shifted anywhere. So half a tile of pipe, exactly, on
        // each of the five layers.
        //
        // Twenty cells and no `exposed_` among them: tg's sheet has none
        // either. An end this thing did not find simply is not drawn, and
        // that reads correctly -- a layer with no run on it is a layer
        // this adapter is not bridging.
        ("pipe_half_l1_1", Ase("@manifold_underlays", "intact_1_1-s")),
        ("pipe_half_l1_2", Ase("@manifold_underlays", "intact_2_1-s")),
        ("pipe_half_l1_4", Ase("@manifold_underlays", "intact_4_1-s")),
        ("pipe_half_l1_8", Ase("@manifold_underlays", "intact_8_1-s")),
        ("pipe_half_l2_1", Ase("@manifold_underlays", "intact_1_2-s")),
        ("pipe_half_l2_2", Ase("@manifold_underlays", "intact_2_2-s")),
        ("pipe_half_l2_4", Ase("@manifold_underlays", "intact_4_2-s")),
        ("pipe_half_l2_8", Ase("@manifold_underlays", "intact_8_2-s")),
        ("pipe_half_l3_1", Ase("@manifold_underlays", "intact_1_3-s")),
        ("pipe_half_l3_2", Ase("@manifold_underlays", "intact_2_3-s")),
        ("pipe_half_l3_4", Ase("@manifold_underlays", "intact_4_3-s")),
        ("pipe_half_l3_8", Ase("@manifold_underlays", "intact_8_3-s")),
        ("pipe_half_l4_1", Ase("@manifold_underlays", "intact_1_4-s")),
        ("pipe_half_l4_2", Ase("@manifold_underlays", "intact_2_4-s")),
        ("pipe_half_l4_4", Ase("@manifold_underlays", "intact_4_4-s")),
        ("pipe_half_l4_8", Ase("@manifold_underlays", "intact_8_4-s")),
        ("pipe_half_l5_1", Ase("@manifold_underlays", "intact_1_5-s")),
        ("pipe_half_l5_2", Ase("@manifold_underlays", "intact_2_5-s")),
        ("pipe_half_l5_4", Ase("@manifold_underlays", "intact_4_5-s")),
        ("pipe_half_l5_8", Ase("@manifold_underlays", "intact_8_5-s")),
        // Cable art, tg's naming kept verbatim: l<layer>-<dirs>
        // with BYOND dir bits 1=N 2=S 4=E 8=W, sorted ascending, and
        // "noconnection" for a stub joined to nothing. The client
        // derives WHICH of these to draw from its own neighbour scan,
        // so the wire only ever carries the topology.
        //
        // tg's art is white and tinted per cable; the colours are the
        // vocabulary, not decoration -- red is the feeder you do not
        // cut, yellow is the branch you do (tg's CABLE_HEX_COLOR_RED
        // and _YELLOW). Baked in rather than tinted at draw time so
        // the Canvas2D fallback, which can fill a rect but not tint a
        // sprite, draws the same wire the WebGPU path does.
        ("cable_l1_none", Tinted(Ase("@cable", "l1-noconnection-s"), (255, 0, 0))),
        ("cable_l2_none", Tinted(Ase("@cable", "l2-noconnection-s"), (255, 255, 0))),
        ("cable_l1_1", Tinted(Ase("@cable", "l1-1-s"), (255, 0, 0))),
        ("cable_l1_2", Tinted(Ase("@cable", "l1-2-s"), (255, 0, 0))),
        ("cable_l1_3", Tinted(Ase("@cable", "l1-1-2-s"), (255, 0, 0))),
        ("cable_l1_4", Tinted(Ase("@cable", "l1-4-s"), (255, 0, 0))),
        ("cable_l1_5", Tinted(Ase("@cable", "l1-1-4-s"), (255, 0, 0))),
        ("cable_l1_6", Tinted(Ase("@cable", "l1-2-4-s"), (255, 0, 0))),
        ("cable_l1_7", Tinted(Ase("@cable", "l1-1-2-4-s"), (255, 0, 0))),
        ("cable_l1_8", Tinted(Ase("@cable", "l1-8-s"), (255, 0, 0))),
        ("cable_l1_9", Tinted(Ase("@cable", "l1-1-8-s"), (255, 0, 0))),
        ("cable_l1_10", Tinted(Ase("@cable", "l1-2-8-s"), (255, 0, 0))),
        ("cable_l1_11", Tinted(Ase("@cable", "l1-1-2-8-s"), (255, 0, 0))),
        ("cable_l1_12", Tinted(Ase("@cable", "l1-4-8-s"), (255, 0, 0))),
        ("cable_l1_13", Tinted(Ase("@cable", "l1-1-4-8-s"), (255, 0, 0))),
        ("cable_l1_14", Tinted(Ase("@cable", "l1-2-4-8-s"), (255, 0, 0))),
        ("cable_l1_15", Tinted(Ase("@cable", "l1-1-2-4-8-s"), (255, 0, 0))),
        ("cable_l2_1", Tinted(Ase("@cable", "l2-1-s"), (255, 255, 0))),
        ("cable_l2_2", Tinted(Ase("@cable", "l2-2-s"), (255, 255, 0))),
        ("cable_l2_3", Tinted(Ase("@cable", "l2-1-2-s"), (255, 255, 0))),
        ("cable_l2_4", Tinted(Ase("@cable", "l2-4-s"), (255, 255, 0))),
        ("cable_l2_5", Tinted(Ase("@cable", "l2-1-4-s"), (255, 255, 0))),
        ("cable_l2_6", Tinted(Ase("@cable", "l2-2-4-s"), (255, 255, 0))),
        ("cable_l2_7", Tinted(Ase("@cable", "l2-1-2-4-s"), (255, 255, 0))),
        ("cable_l2_8", Tinted(Ase("@cable", "l2-8-s"), (255, 255, 0))),
        ("cable_l2_9", Tinted(Ase("@cable", "l2-1-8-s"), (255, 255, 0))),
        ("cable_l2_10", Tinted(Ase("@cable", "l2-2-8-s"), (255, 255, 0))),
        ("cable_l2_11", Tinted(Ase("@cable", "l2-1-2-8-s"), (255, 255, 0))),
        ("cable_l2_12", Tinted(Ase("@cable", "l2-4-8-s"), (255, 255, 0))),
        ("cable_l2_13", Tinted(Ase("@cable", "l2-1-4-8-s"), (255, 255, 0))),
        ("cable_l2_14", Tinted(Ase("@cable", "l2-2-4-8-s"), (255, 255, 0))),
        ("cable_l2_15", Tinted(Ase("@cable", "l2-1-2-4-8-s"), (255, 255, 0))),

    ],
)
