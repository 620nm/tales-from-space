// Subfloor infrastructure, and the only art in the pack derived from a
// bitmask: tg's !pipes_bitmask.dmi and cable naming, kept verbatim.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    // Sheet aliases are local to this family; @names below resolve here.
    sheets: [
        ("pipes_bitmask", "obj/pipes_n_cables/!pipes_bitmask.dmi"),
        ("cable", "obj/pipes_n_cables/layer_cable.dmi"),
        ("manifold_underlays", "obj/pipes_n_cables/layer_manifold_underlays.dmi"),
        ("pipe_underlays", "obj/pipes_n_cables/pipe_underlays.dmi"),
    ],
    sprites: [
        // Atmospheric pipe, tg's !pipes_bitmask.dmi naming kept
        // verbatim: "<field>_<piping layer>". The field is tg's
        // CARDINAL_TO_FULLPIPES/_SHORTPIPES pair -- low nibble the
        // directions the run actually joins, high nibble the short
        // stub drawn where it does not, so a length with one
        // connection reads as a pipe that ENDS rather than a piece of
        // a longer one. Sixteen shapes cover every adjacency; five
        // layers cross without meeting. The client derives WHICH from
        // its own neighbour scan, so the wire carries only topology.
        // Art is greyscale on purpose (tg tints per pipe); unpainted
        // grey is what a pipe dispenser hands you.
        ("pipe_l1_0", Dmi("@pipes_bitmask", "48_1", 0)),
        ("pipe_l1_1", Dmi("@pipes_bitmask", "33_1", 0)),
        ("pipe_l1_2", Dmi("@pipes_bitmask", "18_1", 0)),
        ("pipe_l1_3", Dmi("@pipes_bitmask", "3_1", 0)),
        ("pipe_l1_4", Dmi("@pipes_bitmask", "132_1", 0)),
        ("pipe_l1_5", Dmi("@pipes_bitmask", "5_1", 0)),
        ("pipe_l1_6", Dmi("@pipes_bitmask", "6_1", 0)),
        ("pipe_l1_7", Dmi("@pipes_bitmask", "7_1", 0)),
        ("pipe_l1_8", Dmi("@pipes_bitmask", "72_1", 0)),
        ("pipe_l1_9", Dmi("@pipes_bitmask", "9_1", 0)),
        ("pipe_l1_10", Dmi("@pipes_bitmask", "10_1", 0)),
        ("pipe_l1_11", Dmi("@pipes_bitmask", "11_1", 0)),
        ("pipe_l1_12", Dmi("@pipes_bitmask", "12_1", 0)),
        ("pipe_l1_13", Dmi("@pipes_bitmask", "13_1", 0)),
        ("pipe_l1_14", Dmi("@pipes_bitmask", "14_1", 0)),
        ("pipe_l1_15", Dmi("@pipes_bitmask", "15_1", 0)),
        ("pipe_l2_0", Dmi("@pipes_bitmask", "48_2", 0)),
        ("pipe_l2_1", Dmi("@pipes_bitmask", "33_2", 0)),
        ("pipe_l2_2", Dmi("@pipes_bitmask", "18_2", 0)),
        ("pipe_l2_3", Dmi("@pipes_bitmask", "3_2", 0)),
        ("pipe_l2_4", Dmi("@pipes_bitmask", "132_2", 0)),
        ("pipe_l2_5", Dmi("@pipes_bitmask", "5_2", 0)),
        ("pipe_l2_6", Dmi("@pipes_bitmask", "6_2", 0)),
        ("pipe_l2_7", Dmi("@pipes_bitmask", "7_2", 0)),
        ("pipe_l2_8", Dmi("@pipes_bitmask", "72_2", 0)),
        ("pipe_l2_9", Dmi("@pipes_bitmask", "9_2", 0)),
        ("pipe_l2_10", Dmi("@pipes_bitmask", "10_2", 0)),
        ("pipe_l2_11", Dmi("@pipes_bitmask", "11_2", 0)),
        ("pipe_l2_12", Dmi("@pipes_bitmask", "12_2", 0)),
        ("pipe_l2_13", Dmi("@pipes_bitmask", "13_2", 0)),
        ("pipe_l2_14", Dmi("@pipes_bitmask", "14_2", 0)),
        ("pipe_l2_15", Dmi("@pipes_bitmask", "15_2", 0)),
        ("pipe_l3_0", Dmi("@pipes_bitmask", "48_3", 0)),
        ("pipe_l3_1", Dmi("@pipes_bitmask", "33_3", 0)),
        ("pipe_l3_2", Dmi("@pipes_bitmask", "18_3", 0)),
        ("pipe_l3_3", Dmi("@pipes_bitmask", "3_3", 0)),
        ("pipe_l3_4", Dmi("@pipes_bitmask", "132_3", 0)),
        ("pipe_l3_5", Dmi("@pipes_bitmask", "5_3", 0)),
        ("pipe_l3_6", Dmi("@pipes_bitmask", "6_3", 0)),
        ("pipe_l3_7", Dmi("@pipes_bitmask", "7_3", 0)),
        ("pipe_l3_8", Dmi("@pipes_bitmask", "72_3", 0)),
        ("pipe_l3_9", Dmi("@pipes_bitmask", "9_3", 0)),
        ("pipe_l3_10", Dmi("@pipes_bitmask", "10_3", 0)),
        ("pipe_l3_11", Dmi("@pipes_bitmask", "11_3", 0)),
        ("pipe_l3_12", Dmi("@pipes_bitmask", "12_3", 0)),
        ("pipe_l3_13", Dmi("@pipes_bitmask", "13_3", 0)),
        ("pipe_l3_14", Dmi("@pipes_bitmask", "14_3", 0)),
        ("pipe_l3_15", Dmi("@pipes_bitmask", "15_3", 0)),
        ("pipe_l4_0", Dmi("@pipes_bitmask", "48_4", 0)),
        ("pipe_l4_1", Dmi("@pipes_bitmask", "33_4", 0)),
        ("pipe_l4_2", Dmi("@pipes_bitmask", "18_4", 0)),
        ("pipe_l4_3", Dmi("@pipes_bitmask", "3_4", 0)),
        ("pipe_l4_4", Dmi("@pipes_bitmask", "132_4", 0)),
        ("pipe_l4_5", Dmi("@pipes_bitmask", "5_4", 0)),
        ("pipe_l4_6", Dmi("@pipes_bitmask", "6_4", 0)),
        ("pipe_l4_7", Dmi("@pipes_bitmask", "7_4", 0)),
        ("pipe_l4_8", Dmi("@pipes_bitmask", "72_4", 0)),
        ("pipe_l4_9", Dmi("@pipes_bitmask", "9_4", 0)),
        ("pipe_l4_10", Dmi("@pipes_bitmask", "10_4", 0)),
        ("pipe_l4_11", Dmi("@pipes_bitmask", "11_4", 0)),
        ("pipe_l4_12", Dmi("@pipes_bitmask", "12_4", 0)),
        ("pipe_l4_13", Dmi("@pipes_bitmask", "13_4", 0)),
        ("pipe_l4_14", Dmi("@pipes_bitmask", "14_4", 0)),
        ("pipe_l4_15", Dmi("@pipes_bitmask", "15_4", 0)),
        ("pipe_l5_0", Dmi("@pipes_bitmask", "48_5", 0)),
        ("pipe_l5_1", Dmi("@pipes_bitmask", "33_5", 0)),
        ("pipe_l5_2", Dmi("@pipes_bitmask", "18_5", 0)),
        ("pipe_l5_3", Dmi("@pipes_bitmask", "3_5", 0)),
        ("pipe_l5_4", Dmi("@pipes_bitmask", "132_5", 0)),
        ("pipe_l5_5", Dmi("@pipes_bitmask", "5_5", 0)),
        ("pipe_l5_6", Dmi("@pipes_bitmask", "6_5", 0)),
        ("pipe_l5_7", Dmi("@pipes_bitmask", "7_5", 0)),
        ("pipe_l5_8", Dmi("@pipes_bitmask", "72_5", 0)),
        ("pipe_l5_9", Dmi("@pipes_bitmask", "9_5", 0)),
        ("pipe_l5_10", Dmi("@pipes_bitmask", "10_5", 0)),
        ("pipe_l5_11", Dmi("@pipes_bitmask", "11_5", 0)),
        ("pipe_l5_12", Dmi("@pipes_bitmask", "12_5", 0)),
        ("pipe_l5_13", Dmi("@pipes_bitmask", "13_5", 0)),
        ("pipe_l5_14", Dmi("@pipes_bitmask", "14_5", 0)),
        ("pipe_l5_15", Dmi("@pipes_bitmask", "15_5", 0)),
        // THE CONNECTION STUBS a machine standing in a run wears, and the
        // reason its picture is no longer frozen at bake time.
        //
        // tg draws every atmospherics component BARE and then underlays
        // one of these per mouth, per instance
        // (`/obj/machinery/atmospherics/components/update_icon()`,
        // components_base.dm:68-111): `intact_[node_dir]_[layer]` where
        // that mouth actually found a neighbour, `exposed_[direction]_
        // [layer]` where it reaches and found nothing. Which is why a tg
        // filter meets the run on both sides of it and a tg pump with one
        // end unplumbed shows a capped stub there -- neither of which a
        // baked-in half-pipe can say, because a baked cell cannot know
        // what is next door.
        //
        // Forty cells: two kinds x the four cardinals x tg's five piping
        // layers. tg names them `<kind>_<dir bit>_<layer>` and the bits
        // are BYOND's (1 N, 2 S, 4 E, 8 W); the names here put the family
        // first and the layer before the direction, which is the order
        // `pipe_l3_5` above already reads in. The layer is baked into the
        // ART rather than applied as a shift: tg's sheet ships each stub
        // pre-offset per layer, so `pipe_intact_l2_1` lines up with
        // `pipe_l2_*` exactly and a stub meets the run it points at with
        // no seam. Greyscale for the same reason the run is -- the engine
        // paints each stub with the colour of the run it reaches, tg's
        // `pipe_appearance.color = node.pipe_color`.
        ("pipe_intact_l1_1", Dmi("@pipe_underlays", "intact_1_1", 0)),
        ("pipe_intact_l1_2", Dmi("@pipe_underlays", "intact_2_1", 0)),
        ("pipe_intact_l1_4", Dmi("@pipe_underlays", "intact_4_1", 0)),
        ("pipe_intact_l1_8", Dmi("@pipe_underlays", "intact_8_1", 0)),
        ("pipe_intact_l2_1", Dmi("@pipe_underlays", "intact_1_2", 0)),
        ("pipe_intact_l2_2", Dmi("@pipe_underlays", "intact_2_2", 0)),
        ("pipe_intact_l2_4", Dmi("@pipe_underlays", "intact_4_2", 0)),
        ("pipe_intact_l2_8", Dmi("@pipe_underlays", "intact_8_2", 0)),
        ("pipe_intact_l3_1", Dmi("@pipe_underlays", "intact_1_3", 0)),
        ("pipe_intact_l3_2", Dmi("@pipe_underlays", "intact_2_3", 0)),
        ("pipe_intact_l3_4", Dmi("@pipe_underlays", "intact_4_3", 0)),
        ("pipe_intact_l3_8", Dmi("@pipe_underlays", "intact_8_3", 0)),
        ("pipe_intact_l4_1", Dmi("@pipe_underlays", "intact_1_4", 0)),
        ("pipe_intact_l4_2", Dmi("@pipe_underlays", "intact_2_4", 0)),
        ("pipe_intact_l4_4", Dmi("@pipe_underlays", "intact_4_4", 0)),
        ("pipe_intact_l4_8", Dmi("@pipe_underlays", "intact_8_4", 0)),
        ("pipe_intact_l5_1", Dmi("@pipe_underlays", "intact_1_5", 0)),
        ("pipe_intact_l5_2", Dmi("@pipe_underlays", "intact_2_5", 0)),
        ("pipe_intact_l5_4", Dmi("@pipe_underlays", "intact_4_5", 0)),
        ("pipe_intact_l5_8", Dmi("@pipe_underlays", "intact_8_5", 0)),
        ("pipe_exposed_l1_1", Dmi("@pipe_underlays", "exposed_1_1", 0)),
        ("pipe_exposed_l1_2", Dmi("@pipe_underlays", "exposed_2_1", 0)),
        ("pipe_exposed_l1_4", Dmi("@pipe_underlays", "exposed_4_1", 0)),
        ("pipe_exposed_l1_8", Dmi("@pipe_underlays", "exposed_8_1", 0)),
        ("pipe_exposed_l2_1", Dmi("@pipe_underlays", "exposed_1_2", 0)),
        ("pipe_exposed_l2_2", Dmi("@pipe_underlays", "exposed_2_2", 0)),
        ("pipe_exposed_l2_4", Dmi("@pipe_underlays", "exposed_4_2", 0)),
        ("pipe_exposed_l2_8", Dmi("@pipe_underlays", "exposed_8_2", 0)),
        ("pipe_exposed_l3_1", Dmi("@pipe_underlays", "exposed_1_3", 0)),
        ("pipe_exposed_l3_2", Dmi("@pipe_underlays", "exposed_2_3", 0)),
        ("pipe_exposed_l3_4", Dmi("@pipe_underlays", "exposed_4_3", 0)),
        ("pipe_exposed_l3_8", Dmi("@pipe_underlays", "exposed_8_3", 0)),
        ("pipe_exposed_l4_1", Dmi("@pipe_underlays", "exposed_1_4", 0)),
        ("pipe_exposed_l4_2", Dmi("@pipe_underlays", "exposed_2_4", 0)),
        ("pipe_exposed_l4_4", Dmi("@pipe_underlays", "exposed_4_4", 0)),
        ("pipe_exposed_l4_8", Dmi("@pipe_underlays", "exposed_8_4", 0)),
        ("pipe_exposed_l5_1", Dmi("@pipe_underlays", "exposed_1_5", 0)),
        ("pipe_exposed_l5_2", Dmi("@pipe_underlays", "exposed_2_5", 0)),
        ("pipe_exposed_l5_4", Dmi("@pipe_underlays", "exposed_4_5", 0)),
        ("pipe_exposed_l5_8", Dmi("@pipe_underlays", "exposed_8_5", 0)),
        // THE OTHER STUB, for the one machine that stands across all five
        // layers at once. tg keeps a second sheet for it
        // (`layer_manifold_underlays.dmi`, drawn by
        // `get_attached_image`, layermanifold.dm:78-82) and the
        // difference is where the tube STOPS: a component's stub runs to
        // the machine's body, which tg has shifted off centre by its
        // piping layer, while this one runs to the tile centre, because
        // the body it meets is a band across the middle of the tile that
        // was never shifted anywhere. So half a tile of pipe, exactly, on
        // each of the five layers.
        //
        // Twenty cells and no `exposed_` among them: tg's sheet has none
        // either. An end this thing did not find simply is not drawn, and
        // that reads correctly -- a layer with no run on it is a layer
        // this adapter is not bridging.
        ("pipe_half_l1_1", Dmi("@manifold_underlays", "intact_1_1", 0)),
        ("pipe_half_l1_2", Dmi("@manifold_underlays", "intact_2_1", 0)),
        ("pipe_half_l1_4", Dmi("@manifold_underlays", "intact_4_1", 0)),
        ("pipe_half_l1_8", Dmi("@manifold_underlays", "intact_8_1", 0)),
        ("pipe_half_l2_1", Dmi("@manifold_underlays", "intact_1_2", 0)),
        ("pipe_half_l2_2", Dmi("@manifold_underlays", "intact_2_2", 0)),
        ("pipe_half_l2_4", Dmi("@manifold_underlays", "intact_4_2", 0)),
        ("pipe_half_l2_8", Dmi("@manifold_underlays", "intact_8_2", 0)),
        ("pipe_half_l3_1", Dmi("@manifold_underlays", "intact_1_3", 0)),
        ("pipe_half_l3_2", Dmi("@manifold_underlays", "intact_2_3", 0)),
        ("pipe_half_l3_4", Dmi("@manifold_underlays", "intact_4_3", 0)),
        ("pipe_half_l3_8", Dmi("@manifold_underlays", "intact_8_3", 0)),
        ("pipe_half_l4_1", Dmi("@manifold_underlays", "intact_1_4", 0)),
        ("pipe_half_l4_2", Dmi("@manifold_underlays", "intact_2_4", 0)),
        ("pipe_half_l4_4", Dmi("@manifold_underlays", "intact_4_4", 0)),
        ("pipe_half_l4_8", Dmi("@manifold_underlays", "intact_8_4", 0)),
        ("pipe_half_l5_1", Dmi("@manifold_underlays", "intact_1_5", 0)),
        ("pipe_half_l5_2", Dmi("@manifold_underlays", "intact_2_5", 0)),
        ("pipe_half_l5_4", Dmi("@manifold_underlays", "intact_4_5", 0)),
        ("pipe_half_l5_8", Dmi("@manifold_underlays", "intact_8_5", 0)),
        // Cable art, tg's naming kept verbatim: l<layer>-<dirs>
        // with BYOND dir bits 1=N 2=S 4=E 8=W, sorted ascending, and
        // "noconnection" for a stub joined to nothing. The client
        // derives WHICH of these to draw from its own neighbour scan,
        // so the wire only ever carries the topology.
        //
        // tg's art is white and tinted per cable; the colours are the
        // vocabulary, not decoration -- red is the feeder you do not
        // cut, yellow is the branch you do (tg's CABLE_HEX_COLOR_RED
        // and _YELLOW). Baked in rather than tinted at draw time so
        // the Canvas2D fallback, which can fill a rect but not tint a
        // sprite, draws the same wire the WebGPU path does.
        ("cable_l1_none", Tinted(Dmi("@cable", "l1-noconnection", 0), (255, 0, 0))),
        ("cable_l2_none", Tinted(Dmi("@cable", "l2-noconnection", 0), (255, 255, 0))),
        ("cable_l1_1", Tinted(Dmi("@cable", "l1-1", 0), (255, 0, 0))),
        ("cable_l1_2", Tinted(Dmi("@cable", "l1-2", 0), (255, 0, 0))),
        ("cable_l1_3", Tinted(Dmi("@cable", "l1-1-2", 0), (255, 0, 0))),
        ("cable_l1_4", Tinted(Dmi("@cable", "l1-4", 0), (255, 0, 0))),
        ("cable_l1_5", Tinted(Dmi("@cable", "l1-1-4", 0), (255, 0, 0))),
        ("cable_l1_6", Tinted(Dmi("@cable", "l1-2-4", 0), (255, 0, 0))),
        ("cable_l1_7", Tinted(Dmi("@cable", "l1-1-2-4", 0), (255, 0, 0))),
        ("cable_l1_8", Tinted(Dmi("@cable", "l1-8", 0), (255, 0, 0))),
        ("cable_l1_9", Tinted(Dmi("@cable", "l1-1-8", 0), (255, 0, 0))),
        ("cable_l1_10", Tinted(Dmi("@cable", "l1-2-8", 0), (255, 0, 0))),
        ("cable_l1_11", Tinted(Dmi("@cable", "l1-1-2-8", 0), (255, 0, 0))),
        ("cable_l1_12", Tinted(Dmi("@cable", "l1-4-8", 0), (255, 0, 0))),
        ("cable_l1_13", Tinted(Dmi("@cable", "l1-1-4-8", 0), (255, 0, 0))),
        ("cable_l1_14", Tinted(Dmi("@cable", "l1-2-4-8", 0), (255, 0, 0))),
        ("cable_l1_15", Tinted(Dmi("@cable", "l1-1-2-4-8", 0), (255, 0, 0))),
        ("cable_l2_1", Tinted(Dmi("@cable", "l2-1", 0), (255, 255, 0))),
        ("cable_l2_2", Tinted(Dmi("@cable", "l2-2", 0), (255, 255, 0))),
        ("cable_l2_3", Tinted(Dmi("@cable", "l2-1-2", 0), (255, 255, 0))),
        ("cable_l2_4", Tinted(Dmi("@cable", "l2-4", 0), (255, 255, 0))),
        ("cable_l2_5", Tinted(Dmi("@cable", "l2-1-4", 0), (255, 255, 0))),
        ("cable_l2_6", Tinted(Dmi("@cable", "l2-2-4", 0), (255, 255, 0))),
        ("cable_l2_7", Tinted(Dmi("@cable", "l2-1-2-4", 0), (255, 255, 0))),
        ("cable_l2_8", Tinted(Dmi("@cable", "l2-8", 0), (255, 255, 0))),
        ("cable_l2_9", Tinted(Dmi("@cable", "l2-1-8", 0), (255, 255, 0))),
        ("cable_l2_10", Tinted(Dmi("@cable", "l2-2-8", 0), (255, 255, 0))),
        ("cable_l2_11", Tinted(Dmi("@cable", "l2-1-2-8", 0), (255, 255, 0))),
        ("cable_l2_12", Tinted(Dmi("@cable", "l2-4-8", 0), (255, 255, 0))),
        ("cable_l2_13", Tinted(Dmi("@cable", "l2-1-4-8", 0), (255, 255, 0))),
        ("cable_l2_14", Tinted(Dmi("@cable", "l2-2-4-8", 0), (255, 255, 0))),
        ("cable_l2_15", Tinted(Dmi("@cable", "l2-1-2-4-8", 0), (255, 255, 0))),

    ],
)
