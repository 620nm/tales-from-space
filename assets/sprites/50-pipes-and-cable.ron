// Subfloor infrastructure, in tg's own names: !pipes_bitmask.dmi's
// states, which are the frozen output of the smart-pipe icon algorithm
// and the only bitmask art in the pack, and the cable pieces, which are
// tg's `d1-d2` states. Both kept verbatim.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    // Sheet aliases are local to this family; @names below resolve here.
    sheets: [
        ("pipes_bitmask", "obj/pipes_n_cables/!pipes_bitmask.dmi"),
        ("cable", "obj/pipes_n_cables/pipe_cleaner.dmi"),
        ("manifold_underlays", "obj/pipes_n_cables/layer_manifold_underlays.dmi"),
        ("pipe_underlays", "obj/pipes_n_cables/pipe_underlays.dmi"),
    ],
    sprites: [
        // Atmospheric pipe, tg's !pipes_bitmask.dmi naming kept
        // verbatim: "<field>_<piping layer>". The field is tg's
        // CARDINAL_TO_FULLPIPES/_SHORTPIPES pair -- low nibble the
        // directions the run actually joins, high nibble the short
        // stub drawn where it does not, so a length with one
        // connection reads as a pipe that ENDS rather than a piece of
        // a longer one. Sixteen shapes cover every adjacency; five
        // layers cross without meeting. The client derives WHICH from
        // its own neighbour scan, so the wire carries only topology.
        // Art is greyscale on purpose (tg tints per pipe); unpainted
        // grey is what a pipe dispenser hands you.
        ("pipe_l1_0", Dmi("@pipes_bitmask", "48_1", 0)),
        ("pipe_l1_1", Dmi("@pipes_bitmask", "33_1", 0)),
        ("pipe_l1_2", Dmi("@pipes_bitmask", "18_1", 0)),
        ("pipe_l1_3", Dmi("@pipes_bitmask", "3_1", 0)),
