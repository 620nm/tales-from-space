            Sprite("cable_l1_1-5", "1-5", s),
            Sprite("cable_l1_1-6", "1-6", s),
            Sprite("cable_l1_1-8", "1-8", s),
            Sprite("cable_l1_1-9", "1-9", s),
            Sprite("cable_l1_1-10", "1-10", s),
            Sprite("cable_l1_2-4", "2-4", s),
            Sprite("cable_l1_2-5", "2-5", s),
            Sprite("cable_l1_2-6", "2-6", s),
            Sprite("cable_l1_2-8", "2-8", s),
            Sprite("cable_l1_2-9", "2-9", s),
            Sprite("cable_l1_2-10", "2-10", s),
            Sprite("cable_l1_4-5", "4-5", s),
            Sprite("cable_l1_4-6", "4-6", s),
            Sprite("cable_l1_4-8", "4-8", s),
            Sprite("cable_l1_4-9", "4-9", s),
            Sprite("cable_l1_4-10", "4-10", s),
            Sprite("cable_l1_5-6", "5-6", s),
            Sprite("cable_l1_5-8", "5-8", s),
            Sprite("cable_l1_5-9", "5-9", s),
            Sprite("cable_l1_5-10", "5-10", s),
            Sprite("cable_l1_6-8", "6-8", s),
            Sprite("cable_l1_6-9", "6-9", s),
            Sprite("cable_l1_6-10", "6-10", s),
            Sprite("cable_l1_8-9", "8-9", s),
            Sprite("cable_l1_8-10", "8-10", s),
            Sprite("cable_l1_9-10", "9-10", s),
        ]),
        (sheet: "cable", tint: Some((255, 255, 0)), sprites: [
            Sprite("cable_l2_0-1", "0-1", s),
            Sprite("cable_l2_0-2", "0-2", s),
            Sprite("cable_l2_0-4", "0-4", s),
            Sprite("cable_l2_0-5", "0-5", s),
            Sprite("cable_l2_0-6", "0-6", s),
            Sprite("cable_l2_0-8", "0-8", s),
            Sprite("cable_l2_0-9", "0-9", s),
            Sprite("cable_l2_0-10", "0-10", s),
            Sprite("cable_l2_1-2", "1-2", s),
            Sprite("cable_l2_1-4", "1-4", s),
            Sprite("cable_l2_1-5", "1-5", s),
            Sprite("cable_l2_1-6", "1-6", s),
            Sprite("cable_l2_1-8", "1-8", s),
            Sprite("cable_l2_1-9", "1-9", s),
            Sprite("cable_l2_1-10", "1-10", s),
            Sprite("cable_l2_2-4", "2-4", s),
            Sprite("cable_l2_2-5", "2-5", s),
            Sprite("cable_l2_2-6", "2-6", s),
            Sprite("cable_l2_2-8", "2-8", s),
            Sprite("cable_l2_2-9", "2-9", s),
            Sprite("cable_l2_2-10", "2-10", s),
            Sprite("cable_l2_4-5", "4-5", s),
            Sprite("cable_l2_4-6", "4-6", s),
            Sprite("cable_l2_4-8", "4-8", s),
