// The toolbelt and what shows on it, and the third power line.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then expansion order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    sheets: [
        ("worn_belt", "mob/clothing/belt.dmi"),
        ("belt_l", "mob/inhands/equipment/belt_lefthand.dmi"),
        ("belt_r", "mob/inhands/equipment/belt_righthand.dmi"),
        ("tools_l", "mob/inhands/equipment/tools_lefthand.dmi"),
        ("tools_r", "mob/inhands/equipment/tools_righthand.dmi"),
        ("belt_overlays", "obj/clothing/belt_overlays.dmi"),
        ("belts", "obj/clothing/belts.dmi"),
        ("device_tool", "obj/devices/tool.dmi"),
        ("cable", "pipes_n_cables/layer_cable.aseprite"),
    ],
    groups: [
        // tg's /obj/item/storage/belt/utility: one icon_state,
        // "utility", across the object sheet, the worn sheet and both
        // inhand sheets. Hand bases stay literal; only the directions
        // already completed by the client are generated.
        (sheet: "belts", sprites: [Sprite("toolbelt", "utility", s)]),
        (sheet: "worn_belt", sprites: [Directions("worn_toolbelt", "utility")]),
        (sheet: "belt_l", sprites: [Directions("held_toolbelt_l", "utility")]),
        (sheet: "belt_r", sprites: [Directions("held_toolbelt_r", "utility")]),

        // The content overlays themselves: tg's get_belt_overlay reads
        // `inside_belt_icon_state || icon_state` out of this one sheet,
        // which is why the welder and the cable coil have none — tg
        // draws nothing for them either.
        (sheet: "belt_overlays", sprites: [
            Sprite("belt_screwdriver", "screwdriver", s),
            Sprite("belt_wrench", "wrench", s),
            Sprite("belt_crowbar", "crowbar", s),
            Sprite("belt_cutters", "cutters", s),
            Sprite("belt_multitool", "multitool", s),
        ]),

        // The multitool the engineer's belt carries (tg belt.dm:125).
        (sheet: "device_tool", sprites: [Sprite("multitool", "multitool", s)]),
        (sheet: "tools_l", sprites: [Directions("held_multitool_l", "multitool")]),
        (sheet: "tools_r", sprites: [Directions("held_multitool_r", "multitool")]),

        // The third power line, blue. tg draws it from the `l4-` states
        // (cable.dm:43-48 -- /obj/structure/cable/layer3 wears
        // `icon_state = "l4-1-2-4-8-node"`), because the sheet's rows are
        // pixel offsets and not layer numbers. The tint is
        // CABLE_HEX_COLOR_BLUE = COLOR_STRONG_BLUE = #1919c8
        // (__DEFINES/colors.dm:32,404). Names and frozen states remain
        // literal: this is not a content-specific series generator.
        // The converted sheet is 1-dir; convert-dmi still tags south as
        // `-s`, which is what Sprite(..., s) on an Aseprite sheet looks up.
        (sheet: "cable", tint: Some((25, 25, 200)), sprites: [
            Sprite("cable_l3_none", "l4-noconnection", s),
            Sprite("cable_l3_1", "l4-1", s),
            Sprite("cable_l3_2", "l4-2", s),
            Sprite("cable_l3_3", "l4-1-2", s),
            Sprite("cable_l3_4", "l4-4", s),
            Sprite("cable_l3_5", "l4-1-4", s),
            Sprite("cable_l3_6", "l4-2-4", s),
            Sprite("cable_l3_7", "l4-1-2-4", s),
            Sprite("cable_l3_8", "l4-8", s),
            Sprite("cable_l3_9", "l4-1-8", s),
            Sprite("cable_l3_10", "l4-2-8", s),
            Sprite("cable_l3_11", "l4-1-2-8", s),
            Sprite("cable_l3_12", "l4-4-8", s),
            Sprite("cable_l3_13", "l4-1-4-8", s),
            Sprite("cable_l3_14", "l4-2-4-8", s),
            Sprite("cable_l3_15", "l4-1-2-4-8", s),
        ]),
    ],
)
