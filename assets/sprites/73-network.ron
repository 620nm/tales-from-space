// The device network: the card, the generic wall frame every bracket
// starts as, the access point that hangs in it, the air alarm that
// hangs in the same bracket over a room's plumbing, and the router that
// tops a station's tree.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
//
// The four `_n`/`_s`/`_e`/`_w` copies of a wall picture are the same
// cell four times: what makes a bracket face its wall is the OFFSET
// each name is baked with (`assets/sprites.ron`), which is tg's
// `pixel_shift` on `/obj/item/wallframe`
// (code/game/objects/items/wall_mounted.dm:63-72).
(
    sheets: [
        ("wallmounts", "obj/machines/wallmounts.dmi"),
        ("telecomms", "obj/machines/telecomms.dmi"),
        ("circuitry", "obj/devices/circuitry_n_data.dmi"),
    ],
    sprites: [
        // The interface card. A wired network card off tg's circuitry
        // sheet -- a cell tg draws and no tg machine claims, which is
        // exactly what a pack inventing its own device network wants.
        ("network_card", Dmi("@circuitry", "net_wired", 0)),

        // ---- the generic wall frame, three states x four faces ----
        // tg builds its APC out of this same ladder and paints each
        // rung off `icons/obj/machines/wallmounts.dmi`
        // (code/modules/power/apc/apc_appearance.dm):
        //
        //   :30  "apcmaint"  -- the box open with nothing in it
        //   :38  "apcewires" -- its wiring exposed
        //   :28  "apc1"      -- `basestate`, boarded and still open
        //
        // The frame here is generic where tg's is an APC hull, so the
        // pictures are borrowed rather than ported: this is the wall
        // box every mount in this pack starts as.
        ("wall_frame", Dmi("@wallmounts", "apcmaint", 0)),
        ("wall_frame_n", Dmi("@wallmounts", "apcmaint", 0)),
        ("wall_frame_s", Dmi("@wallmounts", "apcmaint", 0)),
        ("wall_frame_e", Dmi("@wallmounts", "apcmaint", 0)),
        ("wall_frame_w", Dmi("@wallmounts", "apcmaint", 0)),

        ("wall_frame_wired", Dmi("@wallmounts", "apcewires", 0)),
        ("wall_frame_wired_n", Dmi("@wallmounts", "apcewires", 0)),
        ("wall_frame_wired_s", Dmi("@wallmounts", "apcewires", 0)),
        ("wall_frame_wired_e", Dmi("@wallmounts", "apcewires", 0)),
        ("wall_frame_wired_w", Dmi("@wallmounts", "apcewires", 0)),

        ("wall_frame_boarded", Dmi("@wallmounts", "apc1", 0)),
        ("wall_frame_boarded_n", Dmi("@wallmounts", "apc1", 0)),
        ("wall_frame_boarded_s", Dmi("@wallmounts", "apc1", 0)),
        ("wall_frame_boarded_e", Dmi("@wallmounts", "apc1", 0)),
        ("wall_frame_boarded_w", Dmi("@wallmounts", "apc1", 0)),

        // ---- the access point ----
        // tg's wall-mounted access console, a small panel with a lamp
        // on it (code/game/machinery/embedded_controller/
        // access_controller.dm:109-111, `icon_state =
        // "access_control_standby"`). tg wires it to airlocks; here it
        // is the box a segment of the device network hangs off.
        ("access_point", Dmi("@wallmounts", "access_control_standby", 0)),
        ("access_point_n", Dmi("@wallmounts", "access_control_standby", 0)),
        ("access_point_s", Dmi("@wallmounts", "access_control_standby", 0)),
        ("access_point_e", Dmi("@wallmounts", "access_control_standby", 0)),
        ("access_point_w", Dmi("@wallmounts", "access_control_standby", 0)),
        // Its DARK face, which tg has and this pack had not imported:
        // `update_icon_state` drops to `[base_icon_state]_off` on
        // NOPOWER (access_controller.dm:224-227) and otherwise draws
        // standby (:228). The same two words the air alarm's faces
        // answer to -- a dead cord and a box off the air both draw
        // dark.
        ("access_point_off", Dmi("@wallmounts", "access_control_off", 0)),
        ("access_point_off_n", Dmi("@wallmounts", "access_control_off", 0)),
        ("access_point_off_s", Dmi("@wallmounts", "access_control_off", 0)),
        ("access_point_off_e", Dmi("@wallmounts", "access_control_off", 0)),
        ("access_point_off_w", Dmi("@wallmounts", "access_control_off", 0)),
        // tg's third face, baked and named by nothing: the box mid-
        // cycle while it works a pair of airlocks (`_process`,
        // access_controller.dm:228). Nothing here drives doors from an
        // access point, so there is no moment to draw it in.
        ("access_point_busy", Dmi("@wallmounts", "access_control_process", 0)),

        // ---- the air alarm ----
        // tg's own box, off the same sheet: `icon_state = "alarmp"`
        // (code/modules/atmospherics/machinery/air_alarm/
        // _air_alarm.dm:6-7), which is the panel shut and the machine
        // built. tg lays the lamp on top as a separate `alarm0`,
        // `alarm2` or `alarm1` overlay picked by the danger level
        // (`update_overlays`, _air_alarm.dm:554-569) and draws NO lamp
        // at all while the box is open, unpowered, broken or shorted
        // (_air_alarm.dm:557, beside the matching `set_light(0)` at
        // :526-527).
        //
        // The dark face is that no-lamp case exactly, and this entry
        // wears it for both of the states this engine can derive that
        // tg would have drawn dark: a dead cord, and a box that is not
        // on the air (`appearance.device`,
        // docs/content-schema/appearance.md).
        ("air_alarm", Dmi("@wallmounts", "alarmp", 0)),
        ("air_alarm_n", Dmi("@wallmounts", "alarmp", 0)),
        ("air_alarm_s", Dmi("@wallmounts", "alarmp", 0)),
        ("air_alarm_e", Dmi("@wallmounts", "alarmp", 0)),
        ("air_alarm_w", Dmi("@wallmounts", "alarmp", 0)),

        // The lit face: the same shut panel with tg's teal no-danger
        // lamp composited onto it. tg keeps the lamp a separate overlay
        // because its danger level changes under a static box; here the
        // whole face is one cell, because a device state selects a base
        // picture and the roster carries one name per state. The
        // emissive twin tg pairs with the overlay
        // (`emissive_appearance`, _air_alarm.dm:569) is NOT imported:
        // on a composed cell it would glow the whole panel rather than
        // the screen, which is a brighter box than tg draws.
        ("air_alarm_lit", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm0")], 0)),
        ("air_alarm_lit_n", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm0")], 0)),
        ("air_alarm_lit_s", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm0")], 0)),
        ("air_alarm_lit_e", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm0")], 0)),
        ("air_alarm_lit_w", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm0")], 0)),

        // The two ALARMED faces, baked and named by no entry yet. tg
        // picks between them on `danger_level` (_air_alarm.dm:560-566):
        // `alarm2` yellow for a warning, `alarm1` red for a hazard.
        // Nothing here decides that yet -- it wants a threshold pass
        // over the room's mix -- so the art is imported and waits for
        // one rather than being ported from scratch when it lands.
        ("air_alarm_warning", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm2")], 0)),
        ("air_alarm_warning_n", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm2")], 0)),
        ("air_alarm_warning_s", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm2")], 0)),
        ("air_alarm_warning_e", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm2")], 0)),
        ("air_alarm_warning_w", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm2")], 0)),
        ("air_alarm_hazard", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm1")], 0)),
        ("air_alarm_hazard_n", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm1")], 0)),
        ("air_alarm_hazard_s", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm1")], 0)),
        ("air_alarm_hazard_e", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm1")], 0)),
        ("air_alarm_hazard_w", DmiLayers([("@wallmounts", "alarmp"), ("@wallmounts", "alarm1")], 0)),

        // tg's three ASSEMBLY faces, also baked and named by nothing.
        // `update_icon_state` reaches them only while the panel is open
        // (_air_alarm.dm:540-549): `alarmx` built, `alarm_b2` boarded
        // with no wiring, `alarm_b1` bare. This pack builds every wall
        // box out of ONE generic bracket instead -- `wall_frame` and
        // its two rungs above -- so an alarm under construction IS a
        // wall frame and there is no state for an alarm-shaped one to
        // hang on. Imported anyway, one cell each rather than four:
        // the ladder is here if this box ever gets a hull of its own.
        ("air_alarm_open", Dmi("@wallmounts", "alarmx", 0)),
        ("air_alarm_frame_wired", Dmi("@wallmounts", "alarm_b2", 0)),
        ("air_alarm_frame", Dmi("@wallmounts", "alarm_b1", 0)),

        // ---- the router ----
        // tg's telecommunications relay, the rack that carries traffic
        // between places nothing else reaches
        // (code/game/machinery/telecomms/machines/relay.dm:9-11).
        ("network_router", Dmi("@telecomms", "relay", 0)),
    ],
)
