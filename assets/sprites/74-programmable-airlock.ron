// tg unary_devices/airlock_pump.dm:22-24, :85-89; access_controller.dm:34-38, :83-91.
// Device behavior belongs to the pack's event sockets.
(
    sheets: [
        ("vents", "obj/machines/atmospherics/unary_devices.dmi"),
        ("buttons", "obj/machines/wallmounts.dmi"),
        ("station", "obj/doors/airlocks/station/overlays.dmi"),
        ("interior", "obj/doors/airlocks/public/overlays.dmi"),
        ("wide", "obj/doors/airlocks/multi_tile/public/overlays.dmi"),
    ],
    sprites: [
        ("airlock_pump_off", Dmi("@vents", "vent_off", 0)),
        ("airlock_pump_blowing", DmiAnim("@vents", "vent_out", 0)),
        ("airlock_pump_siphoning", DmiAnim("@vents", "vent_in", 0)),
        ("airlock_pump_loose", Dmi("@vents", "airlock_pump", 0)),
        // tg airlock.dm:565-600 selects lights_bolts while closed.
        ("door_bolt_lights", Dmi("@station", "lights_bolts", 0)),
        ("door_int_bolt_lights", Dmi("@interior", "lights_bolts", 0)),
        ("door_wide_bolt_lights_w", DmiWindow([("@wide", "lights_bolts")], 0, 0, 32)),
        ("door_wide_bolt_lights_e", DmiWindow([("@wide", "lights_bolts")], 0, 32, 32)),
        ("door_wide_bolt_lights_n", DmiWindow([("@wide", "lights_bolts")], 2, 0, 0)),
        ("door_wide_bolt_lights_s", DmiWindow([("@wide", "lights_bolts")], 2, 0, 32)),
    ],
    groups: [
        (sheet: "vents", sprites: [
            Directions("airlock_pump_loose", "airlock_pump"),
        ]),
        (sheet: "buttons", sprites: [
            Faces(25, Sprite("airlock_button", "access_button_standby", s)),
            Faces(25, Sprite("airlock_button_off", "access_button_off", s)),
            Faces(25, Sprite("airlock_button_active", "access_button_cycle", s)),
        ]),
    ],
)
