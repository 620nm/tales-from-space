// Toys: things the station carries because a shift is long.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then expansion order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
//
// A die in tg is TWO cells: the blank body (`icon_state = "d6"`) and
// the pips, added as an overlay named for the roll —
// `update_overlays` appends `"[icon_state]-[result]"`
// (code/game/objects/items/dice.dm:114-116). So a die that shows a
// number is a composite, and the number is baked in.
//
// Which is why every face is here. An item's picture now follows its
// declared appearance state (`states`/`state_sprites` on the prototype,
// turned by `ctx.set_state`), and a state resolves to ONE atlas cell —
// so the composite tg builds at runtime out of a body and an overlay is
// composited once, at bake time, into a cell per face. Twenty-six extra
// cells buys the property that matters: the name a die can be put into
// is a name that was baked, checked at load rather than discovered by a
// player looking at an invisible object.
//
// `d6` and `d20` stay: they are the RESTING picture a prototype's
// `sprite` field names, and the fallback a state without its own row
// falls through to.
(
    sheets: [
        ("dice", "obj/toys/dice.dmi"),
        ("toy", "obj/toys/toy.dmi"),
    ],
    sprites: [
        // The resting faces: the ones that read as "this is a die" at
        // 32 pixels, and the two everybody wants to roll anyway.
        ("d6", DmiLayers([("@dice", "d6"), ("@dice", "d6-6")], 0)),
        ("d20", DmiLayers([("@dice", "d20"), ("@dice", "d20-20")], 0)),

        // Six sides.
        ("d6_1", DmiLayers([("@dice", "d6"), ("@dice", "d6-1")], 0)),
        ("d6_2", DmiLayers([("@dice", "d6"), ("@dice", "d6-2")], 0)),
        ("d6_3", DmiLayers([("@dice", "d6"), ("@dice", "d6-3")], 0)),
        ("d6_4", DmiLayers([("@dice", "d6"), ("@dice", "d6-4")], 0)),
        ("d6_5", DmiLayers([("@dice", "d6"), ("@dice", "d6-5")], 0)),
        ("d6_6", DmiLayers([("@dice", "d6"), ("@dice", "d6-6")], 0)),

        // ...and twenty.
        ("d20_1", DmiLayers([("@dice", "d20"), ("@dice", "d20-1")], 0)),
        ("d20_2", DmiLayers([("@dice", "d20"), ("@dice", "d20-2")], 0)),
        ("d20_3", DmiLayers([("@dice", "d20"), ("@dice", "d20-3")], 0)),
        ("d20_4", DmiLayers([("@dice", "d20"), ("@dice", "d20-4")], 0)),
        ("d20_5", DmiLayers([("@dice", "d20"), ("@dice", "d20-5")], 0)),
        ("d20_6", DmiLayers([("@dice", "d20"), ("@dice", "d20-6")], 0)),
        ("d20_7", DmiLayers([("@dice", "d20"), ("@dice", "d20-7")], 0)),
        ("d20_8", DmiLayers([("@dice", "d20"), ("@dice", "d20-8")], 0)),
        ("d20_9", DmiLayers([("@dice", "d20"), ("@dice", "d20-9")], 0)),
        ("d20_10", DmiLayers([("@dice", "d20"), ("@dice", "d20-10")], 0)),
        ("d20_11", DmiLayers([("@dice", "d20"), ("@dice", "d20-11")], 0)),
        ("d20_12", DmiLayers([("@dice", "d20"), ("@dice", "d20-12")], 0)),
        ("d20_13", DmiLayers([("@dice", "d20"), ("@dice", "d20-13")], 0)),
        ("d20_14", DmiLayers([("@dice", "d20"), ("@dice", "d20-14")], 0)),
        ("d20_15", DmiLayers([("@dice", "d20"), ("@dice", "d20-15")], 0)),
        ("d20_16", DmiLayers([("@dice", "d20"), ("@dice", "d20-16")], 0)),
        ("d20_17", DmiLayers([("@dice", "d20"), ("@dice", "d20-17")], 0)),
        ("d20_18", DmiLayers([("@dice", "d20"), ("@dice", "d20-18")], 0)),
        ("d20_19", DmiLayers([("@dice", "d20"), ("@dice", "d20-19")], 0)),
        ("d20_20", DmiLayers([("@dice", "d20"), ("@dice", "d20-20")], 0)),

        // ---- the rest of the set ---------------------------------
        // tg's bag of dice is d4/d6/d8/d10/d12/d20 and one oddity
        // (dice.dm:14-31); five more solids means five more rosters,
        // and the rule is the one above -- a face a prototype can be
        // put into is a face that was baked.
        ("d4", DmiLayers([("@dice", "d4"), ("@dice", "d4-4")], 0)),
        ("d8", DmiLayers([("@dice", "d8"), ("@dice", "d8-8")], 0)),
        ("d10", DmiLayers([("@dice", "d10"), ("@dice", "d10-10")], 0)),
        ("d12", DmiLayers([("@dice", "d12"), ("@dice", "d12-12")], 0)),
        // The percentile die. tg draws it off its own ten cells and
        // reads them out as 0, 10, 20 ... 90 (`manipulate_result`,
        // dice.dm:225) -- the CELL is still 1..10, which is why the
        // roster below is numbered the way every other die's is.
        ("d00", DmiLayers([("@dice", "d00"), ("@dice", "d00-10")], 0)),

        // Four sides.
        ("d4_1", DmiLayers([("@dice", "d4"), ("@dice", "d4-1")], 0)),
        ("d4_2", DmiLayers([("@dice", "d4"), ("@dice", "d4-2")], 0)),
        ("d4_3", DmiLayers([("@dice", "d4"), ("@dice", "d4-3")], 0)),
        ("d4_4", DmiLayers([("@dice", "d4"), ("@dice", "d4-4")], 0)),

        // Eight.
        ("d8_1", DmiLayers([("@dice", "d8"), ("@dice", "d8-1")], 0)),
        ("d8_2", DmiLayers([("@dice", "d8"), ("@dice", "d8-2")], 0)),
        ("d8_3", DmiLayers([("@dice", "d8"), ("@dice", "d8-3")], 0)),
        ("d8_4", DmiLayers([("@dice", "d8"), ("@dice", "d8-4")], 0)),
        ("d8_5", DmiLayers([("@dice", "d8"), ("@dice", "d8-5")], 0)),
        ("d8_6", DmiLayers([("@dice", "d8"), ("@dice", "d8-6")], 0)),
        ("d8_7", DmiLayers([("@dice", "d8"), ("@dice", "d8-7")], 0)),
        ("d8_8", DmiLayers([("@dice", "d8"), ("@dice", "d8-8")], 0)),

        // Ten.
        ("d10_1", DmiLayers([("@dice", "d10"), ("@dice", "d10-1")], 0)),
        ("d10_2", DmiLayers([("@dice", "d10"), ("@dice", "d10-2")], 0)),
        ("d10_3", DmiLayers([("@dice", "d10"), ("@dice", "d10-3")], 0)),
        ("d10_4", DmiLayers([("@dice", "d10"), ("@dice", "d10-4")], 0)),
        ("d10_5", DmiLayers([("@dice", "d10"), ("@dice", "d10-5")], 0)),
        ("d10_6", DmiLayers([("@dice", "d10"), ("@dice", "d10-6")], 0)),
        ("d10_7", DmiLayers([("@dice", "d10"), ("@dice", "d10-7")], 0)),
        ("d10_8", DmiLayers([("@dice", "d10"), ("@dice", "d10-8")], 0)),
        ("d10_9", DmiLayers([("@dice", "d10"), ("@dice", "d10-9")], 0)),
        ("d10_10", DmiLayers([("@dice", "d10"), ("@dice", "d10-10")], 0)),

        // Twelve.
        ("d12_1", DmiLayers([("@dice", "d12"), ("@dice", "d12-1")], 0)),
        ("d12_2", DmiLayers([("@dice", "d12"), ("@dice", "d12-2")], 0)),
        ("d12_3", DmiLayers([("@dice", "d12"), ("@dice", "d12-3")], 0)),
        ("d12_4", DmiLayers([("@dice", "d12"), ("@dice", "d12-4")], 0)),
        ("d12_5", DmiLayers([("@dice", "d12"), ("@dice", "d12-5")], 0)),
        ("d12_6", DmiLayers([("@dice", "d12"), ("@dice", "d12-6")], 0)),
        ("d12_7", DmiLayers([("@dice", "d12"), ("@dice", "d12-7")], 0)),
        ("d12_8", DmiLayers([("@dice", "d12"), ("@dice", "d12-8")], 0)),
        ("d12_9", DmiLayers([("@dice", "d12"), ("@dice", "d12-9")], 0)),
        ("d12_10", DmiLayers([("@dice", "d12"), ("@dice", "d12-10")], 0)),
        ("d12_11", DmiLayers([("@dice", "d12"), ("@dice", "d12-11")], 0)),
        ("d12_12", DmiLayers([("@dice", "d12"), ("@dice", "d12-12")], 0)),

        // ...and the percentile's ten cells.
        ("d00_1", DmiLayers([("@dice", "d00"), ("@dice", "d00-1")], 0)),
        ("d00_2", DmiLayers([("@dice", "d00"), ("@dice", "d00-2")], 0)),
        ("d00_3", DmiLayers([("@dice", "d00"), ("@dice", "d00-3")], 0)),
        ("d00_4", DmiLayers([("@dice", "d00"), ("@dice", "d00-4")], 0)),
        ("d00_5", DmiLayers([("@dice", "d00"), ("@dice", "d00-5")], 0)),
        ("d00_6", DmiLayers([("@dice", "d00"), ("@dice", "d00-6")], 0)),
        ("d00_7", DmiLayers([("@dice", "d00"), ("@dice", "d00-7")], 0)),
        ("d00_8", DmiLayers([("@dice", "d00"), ("@dice", "d00-8")], 0)),
        ("d00_9", DmiLayers([("@dice", "d00"), ("@dice", "d00-9")], 0)),
        ("d00_10", DmiLayers([("@dice", "d00"), ("@dice", "d00-10")], 0)),

        // ---- what carries them -----------------------------------
        // One cell, no faces: the bag is a bag whatever is inside it
        // (tg `/obj/item/storage/dice`, dice.dm:6-12).
        ("dice_bag", Dmi("@dice", "dicebag", 0)),

        // ---- the Captain's Aid -----------------------------------
        // Five cells, one per position of the only dial it has
        // (tg toys.dm:404-410). Named for tg's own mode words so the
        // prototype's `states` roster and this list read as one list.
        ("captains_aid", Dmi("@toy", "captainsaid_off", 0)),
        ("captains_aid_off", Dmi("@toy", "captainsaid_off", 0)),
        ("captains_aid_port", Dmi("@toy", "captainsaid_port", 0)),
        ("captains_aid_starboard", Dmi("@toy", "captainsaid_starboard", 0)),
        ("captains_aid_fore", Dmi("@toy", "captainsaid_fore", 0)),
        ("captains_aid_aft", Dmi("@toy", "captainsaid_aft", 0)),
    ],
)
