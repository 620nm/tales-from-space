    groups: [
        // Canonical sheets and base states: lattice.dm:1-16,116-125.
        (
            sheet: "lattice",
            sprites: [
                Junctions("lattice", "lattice"),
            ],
        ),
        (
            sheet: "catwalk",
            sprites: [
                Junctions("catwalk", "catwalk"),
            ],
        ),
        // Three families, and WHICH of them join each other is not said
        // here: a sheet is art, and belonging is a word content invents
        // (tfs/content/structures/*.luau). tg keeps its own three the
        // same way -- one .dmi each, and one `smoothing_groups` line
        // apiece deciding who is whose neighbour
        // (tables_racks.dm:15-31,618-631,744-755).
        (
            sheet: "table",
            sprites: [
                Junctions("table", "table"),
            ],
        ),
        (
            sheet: "reinforced_table",
            sprites: [
                Junctions("reinforced_table", "reinforced_table"),
            ],
        ),
        (
            sheet: "wood_table",
            sprites: [
                Junctions("wood_table", "wood_table"),
            ],
        ),
        // The two tg glass floors: one sheet and base state each
        // (glass.dm:4-6,71-73); the lead-glass pair is first-party
        // Aseprite in `sprites:` above. All four smooth as one group
        // (glass.dm:10-11), which is the structures' word, not this file's.
        (
            sheet: "glass_floor",
            sprites: [
                Junctions("glass_floor", "glass"),
            ],
        ),
        (
            sheet: "reinforced_glass_floor",
            sprites: [
                Junctions("reinforced_glass_floor", "reinf_glass"),
            ],
        ),
        // tg's ice sheet (ice.dm:4-5) is cut by the glass floors' template
        // (ice_turf.png.toml, bitmask/diagonal_32x32) but wears only
        // `ice_turf-0`; the family bakes whole so the check can find it.
        (
            sheet: "ice_floor",
            sprites: [
                Junctions("ice_floor", "ice_turf"),
            ],
        ),
    ],
)
