// What a vessel's contents look like through its glass, and the three
// small containers that wear them beside the beaker.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in this
// directory is baked, in FILE-NAME order and then expansion order, so
// the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
//
// tg keeps every fill picture on ONE sheet away from the containers
// themselves (`fill_icon = 'icons/obj/medical/reagent_fillings.dmi'`,
// code/modules/reagents/reagent_containers.dm:303) and picks a state
// out of it by percentage, colouring the whole layer with the mixture's
// blended colour (`update_overlays`, reagent_containers.dm:287-307).
// Everything on this sheet is therefore authored GREYSCALE and drawn as
// a tinted overlay -- the same bargain docs/COLOR.md describes for
// cable and pipe paint, and the reason a hundred reagents need six
// pictures rather than six hundred.
//
// The threshold numbers ARE the state names: tg's per-type
// `fill_icon_thresholds = list(0, 1, 20, 40, 60, 80, 100)` indexes this
// sheet by concatenation (`"[fill_name][threshold]"`), so `beaker20` is
// the picture a beaker between 20% and 40% full wears. The 0 stop is
// dropped here because nothing on the sheet answers to it: tg's own
// beaker jumps from nothing to `beaker1`, and a vessel below 1% draws
// no fill layer at all.
(
    // Sheet aliases are local to this family; @names below resolve here.
    sheets: [
        ("chemical", "obj/medical/chemical.dmi"),
        ("fillings", "obj/medical/reagent_fillings.dmi"),
        ("syringe", "obj/medical/syringe.dmi"),
        ("drinks", "obj/drinks/bottles.dmi"),
        ("janitor", "obj/service/janitor.dmi"),
        ("puff", "obj/medical/chempuff.dmi"),
    ],
    sprites: [
        // The vessels. The beaker is already baked with the tools in
        // 10-turf-fixtures-and-tools.ron; these are the three smaller
        // ones that share its fill mechanism.
        // /obj/item/reagent_containers/dropper (dropper.dm:1,5).
        ("dropper", Dmi("@chemical", "dropper0", 0)),
        // /obj/item/reagent_containers/cup/tube (_cup.dm:797,800).
        ("test_tube", Dmi("@chemical", "test_tube", 0)),
        // /obj/item/reagent_containers/cup/bottle (bottle.dm:3,6).
        ("bottle", Dmi("@chemical", "bottle", 0)),
        // _cup.dm:473-531, the requested reusable laboratory shells.
        ("beaker_large", Dmi("@chemical", "beakerlarge", 0)),
        ("beaker_plastic", Dmi("@chemical", "beakerwhite", 0)),
        ("beaker_metamaterial", Dmi("@chemical", "beakergold", 0)),
        ("beaker_cryostasis", Dmi("@chemical", "beakernoreact", 0)),
        ("beaker_bluespace", Dmi("@chemical", "beakerbluespace", 0)),
        // drinks.dm:230-331 and spray.dm:1-28.
        ("water_bottle_small", Dmi("@drinks", "smallbottle", 0)),
        ("water_bottle_large", Dmi("@drinks", "largebottle", 0)),
        ("spray_bottle", Dmi("@janitor", "sprayer_large", 0)),
        ("spray_puff", Dmi("@puff", "", 0)),
        // The two things a dose ends up in. The syringe's world picture
        // is its EMPTY barrel: tg redraws `syringe_[rounded_vol]` per
        // fill (syringes.dm:8,160-163) and this engine draws the level
        // as a tinted overlay off the fill sheet instead, so the barrel
        // underneath never changes.
        ("syringe", Dmi("@syringe", "syringe_0", 0)),
        // /obj/item/reagent_containers/applicator/pill (pill.dm:1-5).
        // tg rolls one of twenty-two tablet pictures at mint time; the
        // base `pill` state is the one it falls back to, and one pill
        // looking like every other pill is the honest picture of a
        // machine that only knows one shape.
        ("pill", Dmi("@chemical", "pill", 0)),

        // The fills, one family per vessel shape.
        ("beaker_fill_1", Dmi("@fillings", "beaker1", 0)),
        ("beaker_fill_20", Dmi("@fillings", "beaker20", 0)),
        ("beaker_fill_40", Dmi("@fillings", "beaker40", 0)),
        ("beaker_fill_60", Dmi("@fillings", "beaker60", 0)),
        ("beaker_fill_80", Dmi("@fillings", "beaker80", 0)),
        ("beaker_fill_100", Dmi("@fillings", "beaker100", 0)),
        ("beaker_large_fill_1", Dmi("@fillings", "beakerlarge1", 0)),
        ("beaker_large_fill_20", Dmi("@fillings", "beakerlarge20", 0)),
        ("beaker_large_fill_40", Dmi("@fillings", "beakerlarge40", 0)),
        ("beaker_large_fill_60", Dmi("@fillings", "beakerlarge60", 0)),
        ("beaker_large_fill_80", Dmi("@fillings", "beakerlarge80", 0)),
        ("beaker_large_fill_100", Dmi("@fillings", "beakerlarge100", 0)),
        ("beaker_plastic_fill_1", Dmi("@fillings", "beakerwhite1", 0)),
        ("beaker_plastic_fill_10", Dmi("@fillings", "beakerwhite10", 0)),
        ("beaker_plastic_fill_20", Dmi("@fillings", "beakerwhite20", 0)),
        ("beaker_plastic_fill_40", Dmi("@fillings", "beakerwhite40", 0)),
        ("beaker_plastic_fill_60", Dmi("@fillings", "beakerwhite60", 0)),
        ("beaker_plastic_fill_80", Dmi("@fillings", "beakerwhite80", 0)),
        ("beaker_plastic_fill_100", Dmi("@fillings", "beakerwhite100", 0)),
        ("beaker_metamaterial_fill_1", Dmi("@fillings", "beakergold1", 0)),
        ("beaker_metamaterial_fill_10", Dmi("@fillings", "beakergold10", 0)),
        ("beaker_metamaterial_fill_25", Dmi("@fillings", "beakergold25", 0)),
        ("beaker_metamaterial_fill_35", Dmi("@fillings", "beakergold35", 0)),
        ("beaker_metamaterial_fill_50", Dmi("@fillings", "beakergold50", 0)),
        ("beaker_metamaterial_fill_60", Dmi("@fillings", "beakergold60", 0)),
        ("beaker_metamaterial_fill_80", Dmi("@fillings", "beakergold80", 0)),
        ("beaker_metamaterial_fill_100", Dmi("@fillings", "beakergold100", 0)),
        ("beaker_cryostasis_fill_1", Dmi("@fillings", "beakernoreact1", 0)),
        ("beaker_cryostasis_fill_20", Dmi("@fillings", "beakernoreact20", 0)),
        ("beaker_cryostasis_fill_40", Dmi("@fillings", "beakernoreact40", 0)),
        ("beaker_cryostasis_fill_60", Dmi("@fillings", "beakernoreact60", 0)),
        ("beaker_cryostasis_fill_80", Dmi("@fillings", "beakernoreact80", 0)),
        ("beaker_cryostasis_fill_100", Dmi("@fillings", "beakernoreact100", 0)),
        ("beaker_bluespace_fill_1", Dmi("@fillings", "beakerbluespace1", 0)),
        ("beaker_bluespace_fill_20", Dmi("@fillings", "beakerbluespace20", 0)),
        ("beaker_bluespace_fill_40", Dmi("@fillings", "beakerbluespace40", 0)),
        ("beaker_bluespace_fill_60", Dmi("@fillings", "beakerbluespace60", 0)),
        ("beaker_bluespace_fill_80", Dmi("@fillings", "beakerbluespace80", 0)),
        ("beaker_bluespace_fill_100", Dmi("@fillings", "beakerbluespace100", 0)),
        ("water_bottle_small_fill_10", Dmi("@fillings", "smallbottle10", 0)),
        ("water_bottle_small_fill_25", Dmi("@fillings", "smallbottle25", 0)),
        ("water_bottle_small_fill_50", Dmi("@fillings", "smallbottle50", 0)),
        ("water_bottle_small_fill_75", Dmi("@fillings", "smallbottle75", 0)),
        ("water_bottle_small_fill_80", Dmi("@fillings", "smallbottle80", 0)),
        ("water_bottle_small_fill_90", Dmi("@fillings", "smallbottle90", 0)),
        ("water_bottle_large_fill_10", Dmi("@fillings", "largebottle10", 0)),
        ("water_bottle_large_fill_25", Dmi("@fillings", "largebottle25", 0)),
        ("water_bottle_large_fill_50", Dmi("@fillings", "largebottle50", 0)),
        ("water_bottle_large_fill_75", Dmi("@fillings", "largebottle75", 0)),
        ("water_bottle_large_fill_80", Dmi("@fillings", "largebottle80", 0)),
        ("water_bottle_large_fill_90", Dmi("@fillings", "largebottle90", 0)),
        ("bottle_fill_1", Dmi("@fillings", "bottle1", 0)),
        ("bottle_fill_20", Dmi("@fillings", "bottle20", 0)),
        ("bottle_fill_40", Dmi("@fillings", "bottle40", 0)),
        ("bottle_fill_60", Dmi("@fillings", "bottle60", 0)),
        ("bottle_fill_80", Dmi("@fillings", "bottle80", 0)),
        ("bottle_fill_100", Dmi("@fillings", "bottle100", 0)),
        ("tube_fill_1", Dmi("@fillings", "tube1", 0)),
        ("tube_fill_20", Dmi("@fillings", "tube20", 0)),
        ("tube_fill_40", Dmi("@fillings", "tube40", 0)),
        ("tube_fill_60", Dmi("@fillings", "tube60", 0)),
        ("tube_fill_80", Dmi("@fillings", "tube80", 0)),
        ("tube_fill_100", Dmi("@fillings", "tube100", 0)),
        // The dropper has ONE fill picture and no thresholds at all:
        // tg's dropper overrides `update_overlays` to add the `dropper`
        // state flat whenever there is anything in it
        // (dropper.dm:87-93). Five units is too small a bulb to draw a
        // level in.
        ("dropper_fill", Dmi("@fillings", "dropper", 0)),
        // The syringe's ladder is tg's absolute stops (`syringe1`,
        // `syringe5`, `syringe10`, `syringe15` at 1, 5, 10 and 15 of
        // its fifteen units, syringes.dm:172-176) rather than
        // percentages; items/syringe.luau converts them.
        ("syringe_fill_1", Dmi("@fillings", "syringe1", 0)),
        ("syringe_fill_5", Dmi("@fillings", "syringe5", 0)),
        ("syringe_fill_10", Dmi("@fillings", "syringe10", 0)),
        ("syringe_fill_15", Dmi("@fillings", "syringe15", 0)),
        // The pill takes the dropper's deal: one picture, no ladder.
        ("pill_fill", Dmi("@fillings", "pill", 0)),
    ],
)
