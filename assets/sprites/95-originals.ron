// First-party art: sprites drawn for this game rather than ported from
// tgstation. Paths are relative to `tfs/assets/originals/`, and the
// extension picks the decoder — `.png` is one 32x32 still, `.aseprite`
// is a tagged document whose TAGS are its states. Contract and the
// authoring rules: `tfs/assets/originals/README.md`, docs/ASSETS.md §4.1.
//
// One family of `tfs/assets/sprites.ron`'s roster. Every .ron in
// this directory is baked, in FILE-NAME order and then entry order,
// so the atlas layout is a function of the manifest and not of the
// filesystem. Two files claiming one sprite name is a bake error.
(
    sprites: [
        // A bar of soap: the same drawing three ways, which is exactly
        // what makes it a proof — one still from a plain PNG, one still
        // from an Aseprite tag, and one animation from a tagged range.
        ("soap_bar", Png("soap.png")),
        ("soap_wet", Ase("soap.aseprite", "idle")),
        ("soap_bubbles", AseAnim("soap.aseprite", "bubbles")),

        // A transparent maintenance grid drawn over the ordinary plating
        // foundation and the cable/pipe runs beneath it.
        ("open_floor", Ase("turf/open_floor.aseprite", "open_floor")),

        // The drifting mark the gas overlay wears when the air over a
        // tile is moving (protocol v46). It is an EFFECT, not a thing:
        // no content names it, the renderer looks it up once at boot
        // beside `white`, and a bake without it simply draws no
        // streaks. Deliberately soft and untinted white — it is
        // multiplied by whatever colour the gas already is.
        //
        // The FILE sorts under `fx/`; the NAME cannot, because a
        // logical name becomes a vending CSS class and the baker holds
        // every one of them to `[A-Za-z0-9_-]`.
        ("wind_streak", Png("fx/wind_streak.png")),

        // The two line-dock machines, four pictures each: a dock is
        // painted by what is standing in it AND by whether it is
        // running, and the engine picks one of the four in one place
        // (`chem.sprite_loaded` / `sprite_running` /
        // `sprite_running_loaded`, ../lunatic/docs/CONTENT-SCHEMA.md).
        // Stills, so a running machine is a lit lamp and a hot element
        // rather than a loop; the animated version is an Aseprite
        // follow-up and needs nothing here but a changed row.
        ("evaporator", Png("bench/evaporator_off.png")),
        ("evaporator_loaded", Png("bench/evaporator_off_loaded.png")),
        ("evaporator_on", Png("bench/evaporator_on.png")),
        ("evaporator_on_loaded", Png("bench/evaporator_on_loaded.png")),
        ("steam_generator", Png("bench/steam_generator_off.png")),
        ("steam_generator_loaded", Png("bench/steam_generator_off_loaded.png")),
        ("steam_generator_on", Png("bench/steam_generator_on.png")),
        ("steam_generator_on_loaded", Png("bench/steam_generator_on_loaded.png")),
    ],
    sheets: [
        ("hazard_placard", "signs/nfpa-704.ase"),
    ],
    groups: [
        // The hazard placard, drawn as one document whose LAYERS are the
        // stack a consumer builds at runtime: the diamond, a digit in
        // each of three quadrants, and one optional symbol in the
        // fourth. Nothing here is an animation — the frames are the
        // ALTERNATIVES — so every sprite is one layer's cel on one
        // frame, and arrives with the rest of the placard transparent.
        //
        // A logical name becomes a vending CSS class, so the parts are
        // spelled with underscores rather than the dots prose would use.
        (
            sheet: "hazard_placard",
            sprites: [
                Layer("nfpa_704_placard", "placard", 1),
                LayerFrames("health", [
                    "nfpa_704_health_0",
                    "nfpa_704_health_1",
                    "nfpa_704_health_2",
                    "nfpa_704_health_3",
                    "nfpa_704_health_4",
                ]),
                LayerFrames("fire", [
                    "nfpa_704_fire_0",
                    "nfpa_704_fire_1",
                    "nfpa_704_fire_2",
                    "nfpa_704_fire_3",
                    "nfpa_704_fire_4",
                ]),
                LayerFrames("reactivity", [
                    "nfpa_704_reactivity_0",
                    "nfpa_704_reactivity_1",
                    "nfpa_704_reactivity_2",
                    "nfpa_704_reactivity_3",
                    "nfpa_704_reactivity_4",
                ]),
                LayerFrames("special", [
                    "nfpa_704_special_skull",
                    "nfpa_704_special_radioactive",
                    "nfpa_704_special_biohazard",
                    "nfpa_704_special_water_reactive",
                    "nfpa_704_special_asphyxiant",
                    "nfpa_704_special_oxidizer",
                ]),
            ],
        ),
    ],
)
