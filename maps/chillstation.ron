// Chillstation 13: an atmos + electrical playground. A finished
// Commons (solar-fed, lit, vending), an unfinished Annex waiting for
// plating and a branch circuit, materials on the floor, and
// open space in every direction. The true demo: spawn friends,
// finish the room, watch the vent bring it to one atmosphere.
//
// Where that atmosphere comes from: the air canister 'c' in the
// Commons feeds the distribution run below (hidden under the deck, as
// pipe always is — pry a floor tile to see it), the run reaches both
// vents 'v', and each vent releases into its room until the room hits
// one atmosphere. Nothing else on this station makes air, so the
// canister is finite and a long breach costs it. Note that 'o' is a
// power OUTLET, not a vent — it is electrical (docs/power.md).
//
// East of the Annex is the EVA vestibule: two airlocks 'E' with three
// tiles of bare plating between them, so the way out to space is a
// chamber you empty rather than a hole you open. Shape copied from
// tgstation's MetaStation "Escape Pod One" (_maps/map_files/
// MetaStation/MetaStation.dmm, (38,147)-(38,149)): an
// /obj/machinery/door/airlock/external at each end, three
// /turf/open/floor/plating between them, hull all the way round.
//
// The two doors are CYCLE-LINKED (`cycle_links` below, tg's
// /obj/effect/mapping_helpers/airlock/cyclelink_helper): opening either
// one shuts the other, so the chamber cannot be held open at both ends.
// That is the difference between an airlock and a corridor with two
// doors in it, and it is machinery rather than crew discipline — the
// station is not vented by one impatient crewman.
//
// Windows: the Annex looks north through three panes of reinforced
// glass in the hull, and east into the vestibule through two more. They
// ship glazed (`structures` places a state by name), because tg maps
// its window galleries assembled — an /obj/effect/spawner/structure/
// window/reinforced, not bare rods for the crew to fit. A glazed pane
// is a BARRIER: it holds a room's air exactly as a shut door does
// (tg window.dm:405 `can_atmos_pass`). Prise one out of the hull and
// the Annex is open to space, which is the point of putting one there.
(
    name: "Chillstation 13",
    legend: {
        ' ': (turf: Space),
        '.': (turf: Floor),
        '#': (turf: Wall),
        '+': (turf: Floor, fixture: Some(Door)),
        'a': (turf: Floor, fixture: Some(Apc)),
        // Standard ceiling tubes, in tg's default fluorescent white
        // (LIGHT_COLOR_DEFAULT "#f3fffa", code/__DEFINES/colors.dm:254 —
        // the colour /obj/machinery/light ships with, light.dm:24-28).
        'l': (turf: Floor, fixture: Some(Light), light: Some("#F3FFFA")),
        // The one warm fitting in the Commons: a tungsten bulb
        // (LIGHT_COLOR_TUNGSTEN "#FFD6AA", colors.dm:312) somebody put
        // in over the table and nobody has replaced. Four tiles from
        // the tube at (7,5), so the deck between them is a gradient
        // from cool to warm and back — the whole point of coloured
        // light, standing on one floor.
        'b': (turf: Floor, fixture: Some(Light), light: Some("#FFD6AA")),
        'o': (turf: Floor, fixture: Some(Outlet)),
        'm': (turf: Floor, fixture: Some(Smes)),
        'v': (turf: Floor, fixture: Some(Vent)),
        'c': (turf: Floor, fixture: Some(Canister)),
        '_': (turf: Plating),
        's': (turf: Space, fixture: Some(Solar)),
        // An external airlock. Same door the engine spawns for '+',
        // standing on bare plating instead of a finished tile, because
        // that is where tg puts one: the vestibule deck is never
        // tiled.
        'E': (turf: Plating, fixture: Some(Door)),
        // Atmospherics keeps its deck OPEN. Every other room on the
        // station hides its plumbing under floor tiles, which is right
        // -- pipe is subfloor and a corridor is not a diagram. A
        // department whose whole job is the plumbing is the one place
        // tg leaves the plating bare, so the six chars below are the
        // Commons' fixtures again standing on '_' instead of '.'.
        'C': (turf: Plating, fixture: Some(Canister)),
        'L': (turf: Plating, fixture: Some(Light), light: Some("#F3FFFA")),
        'A': (turf: Plating, fixture: Some(Apc)),
        'O': (turf: Plating, fixture: Some(Outlet)),
        // The tank annex's door. The same airlock '+' spawns, standing
        // on bare plating rather than a finished tile -- which is what
        // 'E' already says, but 'E' is the EVA vestibule's and a glyph
        // is a word in a picture. An internal door and an airlock to
        // vacuum should not read the same.
        'D': (turf: Plating, fixture: Some(Door)),
    },
    rows: [
        "                              ",
        "                              ",
        "                              ",
        "                              ",
        "    ###############___###     ",
        "    #a.l...bo.#avl......##    ",
        "    #...v.....#.........__#   ",
        "    #.........#.........E_E   ",
        "    #.........+.........__#   ",
        "    #.......c.#.....#### #    ",
        "    #.______..#.....#         ",
        "    #m..l....v#.....#         ",
        "    #############+########### ",
        "              #_C_CA_L___L__# ",
        "              #_____________# ",
        "              #_____________# ",
        "      s s s s #_____C_______# ",
        "    ###_###_###_________C___# ",
        "    #AL_____L_#_____________# ",
        "    #_______________________# ",
        "    #____________________O__# ",
        "    #_________#######+####### ",
        "    #_________D_____________# ",
        "    #_________###+###+###+### ",
        "    #_________##___#___#___## ",
        "    ############___#___#___## ",
        "              ############### ",
    ],
    spawns: [(7, 8), (8, 8), (9, 8), (10, 8)],
    items: [
        (7, 7, "toolbox"),
        (16, 10, "welder"),
        (17, 10, "crowbar"),
        (16, 11, "cable_coil"),
        (17, 11, "cable_coil"),
        (18, 10, "metal"),
        (18, 11, "metal"),
        (19, 10, "floor_tile"),
        (19, 11, "floor_tile"),
        (18, 9, "vendor_board"),
        (19, 8, "tool_vendor_board"),
        (19, 9, "tv_board"),
        // Glazing stock: the Annex is where you learn windows.
        (16, 9, "rod"),
        (17, 9, "glass"),
        (16, 8, "rglass"),
        (17, 8, "screwdriver"),
        // Two sheets of reinforced glass — one pane's worth, stacked by
        // the gallery as the spare. The windows themselves ship glazed
        // now; what a shift actually needs on hand is the glass to put
        // one BACK, and the tools to take one out are already in the
        // Annex pile above.
        (21, 6, "rglass"),
        (21, 6, "rglass"),
        // Lighting stock, on the workshop side: a shattered tube is
        // now something that happens, so something to fix it with is
        // something the station needs.
        (18, 8, "box_lights"),
        (19, 8, "light_replacer"),
        // The atmospherics bench: the four things a technician actually
        // carries. The RPD builds and removes plumbing anywhere, the
        // analyser reads a room or a run, the painter is how a main
        // gets its livery -- and paint here is plumbing, so it is also
        // how a main gets cut by mistake -- and the spare meter is a
        // gauge for wherever the next question is.
        (16, 20, "rpd"),
        (17, 20, "analyzer"),
        (18, 20, "pipe_painter"),
        (19, 20, "pipe_meter"),
        (20, 20, "wrench"),
    ],
    // The socket the supply canister is fastened to. It sits beside the
    // through-main and mouths south into it: the connector is the
    // component on its own tile, never raw pipe hidden under one. Pull
    // the port up with a wrench and the distribution loop has no source.
    structures: [
        (12, 9, "connector_port"),
        // The airlock gallery: a glass wall across the Annex with one
        // tile of gap at (22, 7), so the way to the inner airlock runs
        // past a window rather than through open floor. Reinforced, and
        // fitted — tg's vestibules are ringed with
        // /obj/effect/spawner/structure/window/reinforced, which is a
        // spawner precisely because a mapper places the assembled thing.
        //
        // These three stand between two halves of ONE pressurised room,
        // so what they buy is sightlines rather than atmosphere. The
        // ones that hold air are below.
        (22, 5, "grille", "reinforced"),
        (22, 6, "grille", "reinforced"),
        (22, 8, "grille", "reinforced"),
        // The Annex's viewport: three panes let into the north hull, on
        // bare plating with vacuum on the far side. This is the window
        // that has to be airtight or it is not a window, and it is the
        // whole reason `airtight` exists — before it, a hull pane was a
        // hole you could see through, and the only honest thing a map
        // could do was leave the hull solid.
        (19, 4, "grille", "reinforced"),
        (20, 4, "grille", "reinforced"),
        (21, 4, "grille", "reinforced"),
        // And two into the vestibule, so the Annex can see who is in
        // the chamber and whether the outer door is open before it
        // matters. Same glass, and the same consequence if it goes:
        // these two are all that stand between the Annex and a chamber
        // that is deliberately opened to space several times a shift.
        (24, 6, "grille", "reinforced"),
        (24, 8, "grille", "reinforced"),

        // ---- Atmospherics ------------------------------------------
        // GAS STORAGE. Two bottles on connector ports feed the process
        // line; two more hang off the machines that need or make a
        // second gas -- the mixer's other intake, and the bottle the
        // filter fills with what it pulls out.
        (16, 13, "connector_port"),
        (18, 13, "connector_port"),
        (24, 17, "connector_port"),
        // THE PROCESS LINE, west to east. Everything the department
        // does to gas happens along one row of deck: separate, blend,
        // push. The filter's side mouth drops south into the bottle it
        // fills; the mixer's takes from the one beside it.
        // Commissioned, not shipped in a box: the map places each of
        // these in a STATE, and for a machine that has positions the
        // state IS the switch. tg maps `/on` subtypes for exactly
        // this reason -- a station whose air only starts moving once
        // somebody walks to Atmospherics is not a station.
        // A filter ROW, tg's shape: one machine per gas, in series
        // down the waste line, each dropping what it catches out of
        // its side mouth. Oxygen first, then carbon dioxide; what
        // survives both is the nitrogen the mixer blends back.
        (20, 14, "gas_filter_n2", "running"),
        (22, 14, "gas_filter_co2", "running"),
        (24, 14, "gas_mixer_airmix", "running"),
        (26, 14, "gas_pump", "running"),
        // Two gauges, either side of the machines that change the gas
        // -- which is the only place a gauge earns its bolt.
        (21, 14, "meter"),
        (25, 14, "meter"),
        // THE THREE LAYER ADAPTERS, and the reason the department can
        // exist at all. The station's native vents can only see piping
        // layer 3 (sim/vents.rs `LAYER_DEFAULT`), while tg's mains are
        // layer 4 for supply and layer 2 for scrubbers. An adapter
        // welds every layer it touches into ONE net, so:
        //   (27,15) puts the pump's layer-3 outlet onto the layer-4
        //           supply main;
        //   (18,10) puts that main back onto the layer-3 run the
        //           Commons and Annex vents are plumbed to;
        //   (18,18) brings the layer-2 scrubbers main home into the
        //           layer-3 process line, so scrubbed air is re-filtered
        //           rather than dumped.
        // Take any one of them out with a wrench and the loop parts in
        // two, conserving every mole (tfs/tests/adapters_test.luau).
        (27, 15, "layer_adapter"),
        (18, 10, "layer_adapter"),
        (18, 18, "layer_adapter"),
        // The fourth adapter, and the storage loop's own: it puts
        // the layer-2 chamber draw onto the layer-3 line into the
        // mixer's side intake. Same reason as the others -- the
        // machines at each end are pinned to different layers, and
        // an adapter is the only thing that joins them.
        (26, 18, "layer_adapter"),
        // The COLOUR adapter, joining the cyan process line to the
        // green chamber feed. Paint is plumbing here -- two runs
        // whose colours disagree are two networks -- so this is the
        // one fitting that lets a department keep its lines
        // legible and still have them be one body of gas.
        (15, 15, "color_adapter"),
        // ISOLATION. tg puts a hand valve wherever a technician
        // needs to cut a leg out without stopping the station: one
        // on the green feed that charges the oxygen and nitrogen
        // chambers, one on the orange line the carbon dioxide filter
        // sends its catch down. Either can be shut without stopping the
        // station, which is the whole point of putting them there. The
        // manual valve is the wheel you turn in the dark; the digital
        // one answers its panel and needs the lights on. Both ship OPEN,
        // because a commissioned station's valves are: an isolation
        // point is a thing you CAN shut, not a thing that starts shut.
        (15, 19, "manual_valve", "open"),
        // ...and one on each MAIN where it leaves the department, which
        // is where tg puts them and what the wiki tells a technician to
        // reach for first: a valve wherever you might need to part a
        // line without stopping the station. Each is a per-layer preset,
        // because a valve takes its layer from its entry and the mains
        // are not on the default one.
        (19, 11, "manual_valve_l4", "open"),
        (15, 10, "manual_valve_l2", "open"),
        // The waste-side pump, on the return riser: the scrubbers main
        // arrives here having crossed the station on its own and needs
        // pushing up into the process line. Distro has had a pump since
        // the department existed; this is the other half of that room.
        //
        // A VOLUMETRIC one, and that is the whole point of the choice. A
        // pressure pump works to a setpoint and stops -- put one here at
        // one atmosphere, against a process line already at one
        // atmosphere, and it has arrived before it started and the
        // return never moves. A return line does not want a pressure, it
        // wants a throughput, which is exactly what tg's volume pump is
        // for (volume_pump.dm: it "never asks").
        (19, 17, "volume_pump", "running"),
        (17, 14, "digital_valve", "open"),
        // Bottled nitrogen off the first filter's side mouth. The
        // connector stands at (20,16) and mouths north into the catch
        // pipe at (20,15); that keeps the component off the raw run and
        // keeps its own tile's valid layer-4 crossing intact.
        (20, 16, "connector_port"),
        // The scrubber that makes it a LOOP rather than a supply: it
        // stands on the Commons' own branch circuit, on layer 2, and
        // takes the carbon dioxide the crew breathe out back to
        // Atmospherics.
        (13, 8, "air_scrubber", "scrubbing"),
        // ---- The tank annex --------------------------------------
        // Seven stationary reservoirs, one per gas this shift's
        // chemistry defines, each filled by the PLACEMENT rather than
        // by a prototype of its own -- tg ships twenty /tank/<gas>
        // subtypes and this map ships none. 23 000 kPa is tg's
        // `starting_pressure_percent = 0.5` of the 46 000 kPa rating
        // (tank.dm:39, 43).
        //
        // Deliberately UNPLUMBED. A tank shares its contents with every
        // net its four mouths reach, so a shared main through this row
        // would settle all seven into one mixture within a pass and the
        // store would be seven tanks of the same thing. The gaps
        // between them and the whole of rows 20-21 and 23 are where an
        // engineer runs pipe to whichever one they want today.
        (5, 19, "stationary_tank", "anchored", ("o2", 23000.0)),
        (7, 19, "stationary_tank", "anchored", ("n2", 23000.0)),
        (9, 19, "stationary_tank", "anchored", ("co2", 23000.0)),
        (11, 19, "stationary_tank", "anchored", ("plasma", 23000.0)),
        (13, 19, "stationary_tank", "anchored", ("water_vapor", 23000.0)),
        (6, 24, "stationary_tank", "anchored", ("tritium", 23000.0)),
        (8, 24, "stationary_tank", "anchored", ("n2o", 23000.0)),
        // Two panes in the annex's north hull, looking out over the
        // solar array, and two in the wall it shares with the machine
        // hall so the tank row can be read from the department. Glass
        // stands in a HOLE in the wall and never on it, which is why
        // the four tiles under these are plating.
        (7, 17, "grille", "reinforced"),
        (11, 17, "grille", "reinforced"),
        (14, 19, "grille", "reinforced"),
        (14, 20, "grille", "reinforced"),
        // And the injector, which is the other end of the same idea and
        // the one machine here with no notion of enough: it fills the
        // department's own deck straight off the process line.
        // Each chamber's pair, the way tg pairs them: an injector
        // pushing gas IN off the green feed, and a scrubber set to
        // SIPHON drawing it back out onto the yellow draw. Both
        // ship running -- a storage chamber nobody switched on is a
        // sealed room full of gas with no way to reach it.
        (16, 24, "air_injector", "injecting"),
        (16, 25, "air_scrubber", "siphoning"),
        (20, 24, "air_injector", "injecting"),
        (20, 25, "air_scrubber", "siphoning"),
        (24, 24, "air_injector", "injecting"),
        (24, 25, "air_scrubber", "siphoning"),
    ],
    // The vestibule interlock: each airlock names the direction its
    // partner lies in, and the link resolves only because BOTH of them
    // do (tg airlock.dm:225 `cyclelinkairlock()`, whose scan rejects a
    // door that does not point back). Opening either shuts the other.
    cycle_links: [
        (24, 7, East),
        (26, 7, West),
    ],
    // The Commons' two vending machines, standing finished at
    // roundstart. Both are corded, and the outlet at (12, 5) is the
    // socket both are plugged into -- unplug the Commons and the
    // shopping stops, which is the point of corded appliances.
    machines: [
        (13, 5, "vendor"),
        (13, 6, "tool_vendor"),
        // The pipe dispenser, corded to the outlet beside it. Every
        // fitting the department is built out of comes off this shelf,
        // which is why it stands in the department rather than in the
        // Commons with the snacks.
        (26, 20, "pipe_dispenser"),
    ],
    cables: [
        (5, 16, 1), (6, 16, 1), (7, 16, 1), (8, 16, 1), (9, 16, 1), (10, 16, 1),
        (11, 16, 1), (12, 16, 1), (5, 11, 1), (5, 12, 1), (5, 13, 1), (5, 14, 1),
        (5, 15, 1), (5, 5, 1), (5, 6, 1), (5, 7, 1), (5, 8, 1), (5, 9, 1),
        (5, 10, 1), (6, 5, 1), (7, 5, 1), (8, 5, 1), (9, 5, 1), (10, 5, 1),
        (11, 5, 1), (12, 5, 1), (13, 5, 1), (14, 5, 1), (15, 5, 1), (5, 5, 2),
        (6, 5, 2), (7, 5, 2), (8, 5, 2), (9, 5, 2), (10, 5, 2), (11, 5, 2),
        (12, 5, 2), (13, 5, 2), (13, 6, 2), (13, 7, 2), (13, 8, 2), (13, 9, 2),
        (13, 10, 2), (13, 11, 2), (12, 11, 2), (11, 11, 2), (10, 11, 2),
        (9, 11, 2), (8, 11, 2), (8, 6, 2),
        // The vestibule's own feeder spur, layer 1, from the Annex's APC
        // tile along the top of the room and down to both airlocks. It
        // is a FEEDER tap, not a branch: a door with live L1 under its
        // own tile is powered whatever its area's APC is doing
        // (docs/power.md, "direct feeder tap > nearest adjacent branch
        // feed"). That is deliberate and it is tg's instinct too — the
        // way off a station should not stop working because somebody
        // flipped the breaker on the room next to it. The Annex's own
        // lights and vent still wait for the branch circuit nobody has
        // run yet.
        (16, 5, 1), (17, 5, 1), (18, 5, 1), (19, 5, 1), (20, 5, 1),
        (21, 5, 1), (22, 5, 1), (23, 5, 1), (23, 6, 1), (23, 7, 1),
        (24, 7, 1), (25, 7, 1), (26, 7, 1),
        // Atmospherics' own feeder tap, dropped south out of the
        // Annex's L1 run and through the bulkhead to the department's
        // APC at (19, 13).
        (19, 6, 1),
        (19, 7, 1),
        (19, 8, 1),
        (19, 9, 1),
        (19, 10, 1),
        (19, 11, 1),
        (19, 12, 1),
        (19, 13, 1),
        // And its branch circuit, L2, under everything in the
        // department that draws: the filter, the mixer, the pump,
        // the injector, both lights and the dispenser's outlet.
        (15, 14, 2),
        (16, 14, 2),
        (17, 14, 2),
        (18, 14, 2),
        (19, 14, 2),
        (20, 14, 2),
        (21, 14, 2),
        (22, 14, 2),
        (23, 14, 2),
        (24, 14, 2),
        (25, 14, 2),
        (26, 14, 2),
        (27, 14, 2),
        (19, 13, 2),
        (19, 14, 2),
        (19, 15, 2),
        (19, 16, 2),
        (19, 17, 2),
        (19, 18, 2),
        (15, 13, 2),
        (16, 13, 2),
        (17, 13, 2),
        (18, 13, 2),
        (19, 13, 2),
        (20, 13, 2),
        (21, 13, 2),
        (22, 13, 2),
        (23, 13, 2),
        (24, 13, 2),
        (25, 13, 2),
        (26, 13, 2),
        (27, 13, 2),
        (20, 18, 2),
        (21, 18, 2),
        // The spur down the east wall to the dispenser's outlet. It
        // starts on the y=14 run rather than beside it: a segment that
        // begins at (25, 17) is four cables that touch nothing, and an
        // outlet on one is a socket wired to itself. The boot warning
        // ("outlet's branch segment reaches no APC output") is what
        // caught it, which is what that warning is for.
        (25, 15, 2),
        (25, 16, 2),
        (25, 17, 2),
        (25, 18, 2),
        (25, 19, 2),
        (25, 20, 2),
        // The tank annex's feeder tap: two cables south off the solar
        // array's L1 run at (5, 16), through the annex's north wall and
        // onto its APC tile.
        (5, 17, 1),
        (5, 18, 1),
        // ...and its branch circuit, starting on the APC's own tile so
        // it is an output rather than four cables that touch nothing.
        // Along the fixture row first (both lights), then down the east
        // side to the free machine tile at (11, 22), so whatever gets
        // stood there is already fed.
        (5, 18, 2),
        (6, 18, 2),
        (7, 18, 2),
        (8, 18, 2),
        (9, 18, 2),
        (10, 18, 2),
        (11, 18, 2),
        (12, 18, 2),
        (12, 19, 2),
        (12, 20, 2),
        (12, 21, 2),
        (12, 22, 2),
        (11, 22, 2),
        // Down to gas storage: every chamber's injector and siphon
        // is a fan, and a chamber nobody has wired is a sealed room
        // full of gas with no way to move it.
        (19, 19, 2),
        (19, 20, 2),
        (19, 21, 2),
        (19, 22, 2),
        (19, 23, 2),
        (19, 24, 2),
        (19, 25, 2),
        (16, 24, 2),
        (17, 24, 2),
        (18, 24, 2),
        (20, 24, 2),
        (21, 24, 2),
        (22, 24, 2),
        (23, 24, 2),
        (24, 24, 2),
        (25, 24, 2),
        (26, 24, 2),
        (16, 25, 2),
        (17, 25, 2),
        (18, 25, 2),
        (20, 25, 2),
        (21, 25, 2),
        (22, 25, 2),
        (23, 25, 2),
        (24, 25, 2),
        (25, 25, 2),
        (26, 25, 2),
    ],
    // The distribution run, layer 3 (bit 4) — tg's distro loop. It
    // starts beside the canister (12, 9), crosses the Commons under the
    // deck to that room's vent (13, 11), passes UNDER the bulkhead at
    // (14, 10) — a mapper may, a player may not — and climbs the Annex
    // to its vent (16, 5). One line, one canister, two rooms.
    // The supply main, painted tg's supply blue (GLOB.pipe_paint_
    // colors "blue"). Only visible where the deck is open.
    pipe_paint: [
        (6, 10, 4, "#0000FF"),
        (7, 10, 4, "#0000FF"),
        (8, 10, 4, "#0000FF"),
        (9, 10, 4, "#0000FF"),
        (10, 10, 4, "#0000FF"),
        (11, 10, 4, "#0000FF"),
        (12, 10, 4, "#0000FF"),
        (13, 10, 4, "#0000FF"),
        // Vents are unary endpoints on (13,11) and (8,6): their
        // stubs borrow the neighbouring run's paint.
        (8, 9, 4, "#0000FF"),
        (8, 8, 4, "#0000FF"),
        (8, 7, 4, "#0000FF"),
        (14, 10, 4, "#0000FF"),
        (15, 10, 4, "#0000FF"),
        (16, 10, 4, "#0000FF"),
        (16, 9, 4, "#0000FF"),
        (16, 8, 4, "#0000FF"),
        // The PROCESS LINE wears air-mix cyan, which is what makes
        // the colour adapter at (15, 15) a real fitting rather than
        // a decoration: cyan and green are two liveries, and two
        // liveries do not join without one.
        (15, 14, 4, "#00FFFF"),
