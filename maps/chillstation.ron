        (x: 17, y: 17, decal: "trim", paint: Some("blue")),
        (x: 18, y: 17, decal: "trim", paint: Some("blue")),
        (x: 19, y: 17, decal: "trim", paint: Some("blue")),
        (x: 20, y: 17, decal: "trim", paint: Some("blue")),
        (x: 21, y: 17, decal: "trim", paint: Some("blue")),
        (x: 22, y: 17, decal: "trim", paint: Some("blue")),
