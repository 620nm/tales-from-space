    // GAS STORAGE, tg-style: sealed chambers holding a gas as ROOM
    // AIR, not bottles on a shelf. The difference is the whole recovery
    // story -- a canister can be unwrenched and wheeled away, a chamber
    // cannot, so a station that has lost every bottle can still make
    // air. Oxygen and nitrogen at fifty atmospheres, carbon dioxide at
    // three (it is what the station is trying to get RID of, so its
    // chamber is a receiving tank rather than a reserve).
    //
    // The keys are the matter registry's and are checked at boot: a key
    // nothing answers to refuses the server rather than quietly holding
    // ordinary air (main.rs, and MapFile::room_gas_errors).
    room_gas: [
        (16, 24, "o2", 5000.0),
        (16, 25, "o2", 5000.0),
        (17, 24, "o2", 5000.0),
        (17, 25, "o2", 5000.0),
        (18, 24, "o2", 5000.0),
        (18, 25, "o2", 5000.0),
