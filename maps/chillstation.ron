        // shaft the supply climbs -- which is the entire reason
        // piping layers exist: these two share tiles at (19,14),
        // (19,16), (22,16), (24,16) and (15,14) and are separate
        // bodies of gas on every one of them.
        (13, 7, 2),
        (14, 7, 2),
        (15, 7, 2),
        (15, 8, 2),
        (15, 9, 2),
        (15, 11, 2),
        (15, 12, 2),
