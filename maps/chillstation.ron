        (21, 25, "n2", 5000.0),
        (22, 24, "n2", 5000.0),
        (22, 25, "n2", 5000.0),
        (24, 24, "co2", 300.0),
        (24, 25, "co2", 300.0),
        (25, 24, "co2", 300.0),
        (25, 25, "co2", 300.0),
        (26, 24, "co2", 300.0),
        (26, 25, "co2", 300.0),
    ],
    pipes: [
        (6, 10, 4), (7, 10, 4), (8, 10, 4), (9, 10, 4), (10, 10, 4),
        (11, 10, 4), (12, 10, 4), (13, 10, 4),
        (8, 9, 4), (8, 8, 4), (8, 7, 4),
        (14, 10, 4), (15, 10, 4), (16, 10, 4), (16, 9, 4), (16, 8, 4),
        (16, 7, 4), (16, 6, 4),

        // ---- Atmospherics ------------------------------------
        // The PROCESS LINE, layer 3: gas storage in the west,
        // through the filter and the mixer, to the pump. This is
        // the department's own working line and it is left
        // unpainted, because it is not distro and not waste --
        // it is where the mix is made.
        (15, 14, 4),
        (16, 14, 4),
        (18, 14, 4),
        (19, 14, 4),
        (21, 14, 4),
        (23, 14, 4),
        (25, 14, 4),
        (27, 14, 4),
        // The mixer's side feed: its second mouth drops south to the
        // bottle on the port at (24, 17). The connector replaces the
        // last raw tile, so the two lengths end at its northward stub;
        // (24, 16) was missing and a run with a hole in it is two
        // runs — the mixer read 0 kPa on the side intake and blended
        // 79% of a line with 21% of nothing.
        (24, 15, 4),
        (24, 16, 4),
        // THE RETURN RISER, and it is deliberately NOT a straight
        // climb up column 19. The scrubbers main arrives at the
        // adapter (18, 18), crosses the volume pump at (19, 17), and
        // then steps WEST into column 18 to reach the process line at
        // (18, 14).
        //
        // The step is the whole point. A pipe joins its orthogonal
        // neighbours — there are no directional fittings here — so two
        // runs side by side in adjacent columns are one run. Climbing
        // column 19 put the riser alongside the filter's catch line in
        // column 20 for three rows, and every one of those three was a
        // bypass around the pump: inlet and outlet were the same net,
        // holding the same moles, and the pump was scenery. Column 18
        // touches nothing.
        (19, 18, 4),
        (19, 16, 4),
        (18, 16, 4),
        (18, 15, 4),
        (17, 10, 4),
        // The filter's catch: one raw tile, then the socket one tile
        // south, and no further.
        // It cannot run down column 20 either — (20, 16) sits beside
        // the pump's outlet at (19, 16), which welded the nitrogen the
        // filter had just separated straight back onto the line
        // feeding it. A dead end is what a bottle wants anyway.
        (20, 15, 4),
        // The CO2 chamber's own feed, in engineering orange, fed by
        // the filter that catches it and by nothing else. This is
        // the line that makes the loop a LOOP: what a scrubber takes
        // out of a corridor ends up in the tank labelled for it,
        // rather than in a bottle somebody has to carry.
        (22, 15, 4),
        (22, 16, 4),
        (22, 17, 4),
        (22, 18, 4),
        (22, 19, 4),
        (22, 20, 4),
        (22, 21, 4),
        (22, 22, 4),
        (23, 22, 4),
        (23, 23, 4),
        (23, 24, 4),
        // THE STORAGE LOOP, layer 3 and separated from the process
        // line by COLOUR rather than by layer -- which is what tg does
        // inside a department, and what the paint rules were built for.
        // FEED (green) carries what the filter row pulls out of the
        // waste down to each chamber's injector; DRAW (yellow) brings it
        // back up from each chamber's siphoning scrubber to the mixer.
        // The two run parallel up the department and never join.
        (15, 23, 4),
        (16, 23, 4),
        (17, 23, 4),
        (18, 23, 4),
        (19, 23, 4),
        (15, 24, 4),
        (19, 24, 4),
        (15, 22, 4),
        (15, 21, 4),
        (15, 20, 4),
        (15, 18, 4),
        (15, 17, 4),
        (15, 16, 4),
        // DRAW is layer 2, because a scrubber is: every one of them
        // on the station binds on tg's scrubbers layer, and a
        // chamber's siphon is no exception. So the storage draw and
        // the station's waste main are two layer-2 nets that never
        // touch, told apart on sight by their paint.
        (16, 26, 2),
        (17, 26, 2),
        (18, 26, 2),
        (19, 26, 2),
        (20, 26, 2),
        (21, 26, 2),
        (22, 26, 2),
        (23, 26, 2),
        (24, 26, 2),
        (25, 26, 2),
        (26, 26, 2),
        (27, 26, 2),
        (27, 18, 2),
        (27, 19, 2),
        (27, 20, 2),
        (27, 21, 2),
        (27, 22, 2),
        (27, 23, 2),
        (27, 24, 2),
        (27, 25, 2),
        // ...and the short layer-3 link that carries it into the
        // mixer's side intake, through the adapter at (26, 18).
        (25, 18, 4),
        (24, 18, 4),
        // The SUPPLY main, layer 4 and blue: tg's own
        // convention, counted across every map file it ships
        // (`vent_pump/on/layer4`, 2091 instances against one on
