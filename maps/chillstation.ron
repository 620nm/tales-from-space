        (27, 16, 8),
        (19, 15, 8),
        (19, 14, 8),
        (19, 13, 8),
        (19, 12, 8),
        (19, 10, 8),
        // The SCRUBBERS main, layer 2 and red (tg's
        // `vent_scrubber/on/layer2`, 1860 against one). It
