    // GAS STORAGE, tg-style: sealed chambers holding a gas as ROOM AIR,
    // not bottles on a shelf. The difference is the whole recovery story
    // -- a canister can be unwrenched and wheeled away, a chamber cannot,
    // so a station that has lost every bottle can still make air. Oxygen
    // and nitrogen at fifty atmospheres, carbon dioxide at three (it is
    // what the station is trying to get RID of, so its chamber is a
    // receiving tank rather than a reserve).
    //
    // A preset is a RECIPE, named once and painted many times: raising
    // the oxygen reserve is one number on one line here, not six tiles
    // rewritten. Moles rather than a pressure, because moles are what a
    // cell holds -- these three are pV/RT at 20 C, which is the reading
    // the ids are named after (docs/ATMOS.md 11).
    //
    // The substance keys are the matter registry's and are checked at boot: a
    // key nothing answers to refuses the server rather than quietly holding
    // ordinary air (main.rs, and MapFile::blend_errors). `water` names its
    // phase, because water rests LIQUID at 20 C and this store is a gas.
    blends: {
        // What every supply bottle on the station opens the shift
        // holding: tg's own canister charge, 21/79 at 45 atmospheres
        // (content/blends/canister_air.luau, which declares the same
        // blend as the pack's default so a mapper can copy it).
        "canister_air": (rows: [("o2", 392.86967015394526), ("n2", 1477.93828296008)], temperature_k: 293.15, amount: per_tile),
        "resin_pellet_charge": (rows: [("polymer_resin:solid", 0.1)], temperature_k: 293.15, amount: total),
        // A 1:3 carbon-dioxide/hydrogen charge at about 6 MPa in the
        // canister's 2 000 L shell. At 300 K this is about 2 400 mol of
        // syngas, enough for more than 0.1 mol of naphtha.
        "syngas_6000kpa": (rows: [("co2", 600.0), ("hydrogen", 1800.0)], temperature_k: 300.0, amount: per_tile),
        "co2_300kpa": (rows: [("co2", 123.0895930990394)], temperature_k: 293.15, amount: per_tile),
        // The tank annex's seven stores. One blend per store, named
        // after the pressure a 2 500 L shell of it reads at 20 C -- so
        // a second tank of the same thing names the same blend rather
        // than repeating the arithmetic.
        "co2_23000kpa": (rows: [("co2", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "n2_23000kpa": (rows: [("n2", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "n2_5000kpa": (rows: [("n2", 2051.493218317323)], temperature_k: 293.15, amount: per_tile),
        "n2o_23000kpa": (rows: [("n2o", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "o2_23000kpa": (rows: [("o2", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "o2_5000kpa": (rows: [("o2", 2051.493218317323)], temperature_k: 293.15, amount: per_tile),
        "plasma_23000kpa": (rows: [("plasma", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "tritium_23000kpa": (rows: [("tritium", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "water_67268kpa": (rows: [("water:gas", 27599.96916195394)], temperature_k: 293.15, amount: per_tile),
        // The two stores that are not gas at all, mirrored from
        // content/blends/ where their arithmetic is spelled out. Both are
        // `total`, because a dose is a dose whatever shell it went into:
        // ten litres of water in a supply bottle, and two moles of ice in
        // a fifty-millilitre beaker. Neither row needs a `:gas` suffix and
        // the ice names its phase anyway, so warming the file never turns
        // the lump into a puddle by accident.
        "water_10l": (rows: [("water", 555.0929780738273)], temperature_k: 293.15, amount: total),
        "ice_block": (rows: [("water:solid", 2.0)], temperature_k: 263.15, amount: total),
        // And the one that is painted on tiles rather than poured into a
        // shell, so it is a DENSITY: standard air plus half a mole of
        // water vapour per tile (content/blends/humid_air.luau).
        "humid_air": (rows: [("o2", 8.730437114532117), ("n2", 32.84307295466844), ("water:gas", 0.5)], temperature_k: 293.15, amount: per_tile),
    },
    painted: [
        // The air over the chem bench, where a burner has been going
        // under somebody's glassware: ordinary station air with half a
        // mole of water in it per tile (content/blends/humid_air.luau).
        // Enough to see -- water's own file makes vapour visible at a
        // quarter mole -- and under the density it would rain out at,
        // so the room stays foggy instead of condensing on tick one.
        (19, 5, "humid_air"),
        (20, 5, "humid_air"),
        (15, 33, "o2_5000kpa"),
        (16, 33, "o2_5000kpa"),
        (17, 33, "o2_5000kpa"),
        (19, 33, "n2_5000kpa"),
        (20, 33, "n2_5000kpa"),
        (21, 33, "n2_5000kpa"),
        (23, 33, "co2_300kpa"),
        (24, 33, "co2_300kpa"),
        (25, 33, "co2_300kpa"),
        (15, 34, "o2_5000kpa"),
        (16, 34, "o2_5000kpa"),
        (17, 34, "o2_5000kpa"),
        (19, 34, "n2_5000kpa"),
        (20, 34, "n2_5000kpa"),
        (21, 34, "n2_5000kpa"),
        (23, 34, "co2_300kpa"),
        (24, 34, "co2_300kpa"),
        (25, 34, "co2_300kpa"),
    ],
    // On the APC, because a label names the topmost thing on its tile:
    // each panel wears the name of the room it serves.
    labels: [
        (4, 5, "Workshop"),
        (14, 5, "Chemistry Lab"),
        (26, 5, "Cargo Bay"),
        (18, 11, "The Concourse"),
        (15, 14, "The Commons"),
        (4, 22, "Engineering"),
        (28, 22, "Cargo Hall"),
        (18, 22, "Atmospherics"),
        (4, 27, "Tank Annex"),
    ],
)
