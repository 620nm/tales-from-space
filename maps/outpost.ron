// Outpost Zero: the M0 test station. Four rooms around a central corridor,
// one exterior airlock opening to space at the bottom of the corridor.
// M6 wired it (docs/power.md): red feeder ring from the Engineering
// generator/SMES to every APC (running under four doors as direct
// taps), yellow branch circuits from each APC to its room's lights,
// outlets, and door feeds.
(
    name: "Outpost Zero",
    legend: {
        ' ': (turf: Space),
        '.': (turf: Floor),
        '#': (turf: Wall),
        '+': (turf: Floor, fixture: Some(Door)),
        's': (turf: Floor, fixture: Some(SecureDoor)),
        'a': (turf: Floor, fixture: Some(Apc)),
        'l': (turf: Floor, fixture: Some(Light)),
        'V': (turf: Floor, fixture: Some(Vendor)),
        'o': (turf: Floor, fixture: Some(Outlet)),
        'G': (turf: Floor, fixture: Some(Generator)),
        'M': (turf: Floor, fixture: Some(Smes)),
    },
    rows: [
        "                          ",
        "  ####################    ",
        "  #ao.....#....#o....#    ",
        "  #.......+....s..a..#    ",
        "  #l......#....#.....#    ",
        "  ####+####....#######    ",
        "  #.......+....+....l#    ",
        "  #..a....#....#G...M#    ",
        "  #.....oV#.o.a#..a.o#    ",
        "  #########+##########    ",
        "                          ",
    ],
    spawns: [
        (11, 3),
        (12, 3),
        (13, 3),
        (14, 3),
        (12, 6),
        (13, 6),
    ],
    // The bottom-left room is the tool room: toolbox, welder, crowbar,
    // wirecutters, and the vending machine. The engineering ID
    // (top-left) unlocks the secure east-top room.
    items: [
        (4, 7, "toolbox"),
