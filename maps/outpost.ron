// Outpost Zero: the M0 test station. Four rooms around a central corridor,
// one exterior airlock opening to space at the bottom of the corridor.
(
    name: "Outpost Zero",
    legend: {
        ' ': (turf: Space),
        '.': (turf: Floor),
        '#': (turf: Wall),
        '+': (turf: Floor, fixture: Some(Door)),
        's': (turf: Floor, fixture: Some(SecureDoor)),
        'a': (turf: Floor, fixture: Some(Apc)),
        'l': (turf: Floor, fixture: Some(Light)),
        'V': (turf: Floor, fixture: Some(Vendor)),
    },
    rows: [
        "                          ",
        "  ####################    ",
        "  #a......#....#.....#    ",
        "  #.......+....s..a..#    ",
        "  #l......#....#.....#    ",
        "  ####+####....#######    ",
        "  #.......+....+....l#    ",
        "  #..a....#....#.....#    ",
        "  #......V#....#..a..#    ",
        "  #########+##########    ",
        "                          ",
    ],
    spawns: [
        (11, 3),
        (12, 3),
        (13, 3),
        (14, 3),
        (12, 6),
        (13, 6),
    ],
    // The bottom-left room is the tool room: toolbox, welder, crowbar,
    // and the vending machine. The engineering ID (top-left) unlocks the
    // secure east-top room.
    items: [
        (5, 7, "toolbox"),
        (6, 7, "welder"),
        (7, 7, "crowbar"),
        (4, 3, "id_engineering"),
    ],
)
