// Outpost Zero: the M0 test station. Four rooms around a central corridor,
// one exterior airlock opening to space at the bottom of the corridor.
(
    name: "Outpost Zero",
    legend: {
        ' ': (turf: Space),
        '.': (turf: Floor),
        '#': (turf: Wall),
        '+': (turf: Floor, fixture: Some(Door)),
        's': (turf: Floor, fixture: Some(SecureDoor)),
        'a': (turf: Floor, fixture: Some(Apc)),
        'l': (turf: Floor, fixture: Some(Light)),
    },
    rows: [
        "                          ",
        "  ####################    ",
        "  #a......#....#.....#    ",
        "  #.......+....s..a..#    ",
        "  #l......#....#.....#    ",
        "  ####+####....#######    ",
        "  #.......+....+....l#    ",
        "  #..a....#....#.....#    ",
        "  #.......#....#..a..#    ",
        "  #########+##########    ",
        "                          ",
    ],
    spawns: [
        (11, 3),
        (12, 3),
        (13, 3),
        (14, 3),
        (12, 6),
        (13, 6),
    ],
    // The engineering ID unlocks the secure east-top room, where the
    // crowbar waits. The toolbox is just a toolbox. Robust, though.
    items: [
        (5, 7, "toolbox"),
        (4, 3, "id_engineering"),
        (18, 2, "crowbar"),
    ],
)
