// Outpost Zero: the M0 test station. Four rooms around a central corridor,
// one exterior airlock opening to space at the bottom of the corridor.
// It is wired the way the shipped station is (docs/POWER.md): a yellow
// L2 backbone ring from the Engineering generator/SMES to every APC
// (running under four doors as direct taps), and a red L1 room circuit
// out of each APC to its room's outlets and door feeds -- and every
// light fitting is a cord into the nearest of those outlets.
(
    name: "Outpost Zero",
    legend: {
        ' ': (turf: Space),
        '#': (turf: Wall),
        '.': (turf: Floor),
    },
    rows: [
        "                          ",
        "  ####################    ",
        "  #.......#....#.....#    ",
        "  #..................#    ",
        "  #.......#....#.....#    ",
        "  ####.####....#######    ",
        "  #..................#    ",
        "  #.......#.#..#.....#    ",
        "  #.......#..#.#.....#    ",
        "  #########.##########    ",
        "                          ",
    ],
    // The flooded alcove, and the only water on this station. A tile is
    // one cubic metre, so these `total` doses ARE the tile's contents:
    // 55.51 mol of water is a litre of it and 2775.5 mol is fifty, over
    // a square metre of deck -- a millimetre of wet and five centimetres
    // of standing water, which is the difference between a spill and
    // something you would step around.
    //
    // The two air rows ride along because a painted tile holds what the
    // blend says and NOTHING else: water on its own would open this
    // alcove airless, and a compartment that flooded is not a
    // compartment that decompressed. They are ordinary 21/79 at 20 C,
    // the same arithmetic content/blends/standard_air.luau spells out.
    //
    // WHAT HOLDS IT UP is the sill, and that is why the deep pair is a
    // compartment rather than two tiles in the open. Five centimetres of
    // standing water is far above the film a liquid stops thinning at,
    // so the moment a puddle can level the pair would run out across the
    // alcove and be a centimetre of wet nobody would look at twice. Two
    // shut leaves are what keep it: the glazed sill north of it and the
    // exterior airlock south of it. Open either and the fifty litres
    // goes -- into the alcove, or into space -- which is the point of
    // putting a door on a flood.
    //
    // The litre tiles outside need no sill. A litre over a square metre
    // is a millimetre deep, under the film water holds itself at, so
    // they are not going anywhere either way.
    blends: {
        "water_1l": (rows: [("water", 55.51), ("o2", 8.730437114532117), ("n2", 32.84307295466844)], temperature_k: 293.15, amount: total),
        "water_50l": (rows: [("water", 2775.5), ("o2", 8.730437114532117), ("n2", 32.84307295466844)], temperature_k: 293.15, amount: total),
    },
    // The vestibule at the exterior airlock, and the litre that got out
    // of it before somebody shut the sill.
    painted: [
        (11, 8, "water_50l"),
        (12, 8, "water_50l"),
        (13, 7, "water_1l"),
        (14, 8, "water_1l"),
    ],
    spawns: [
        (11, 3),
        (12, 3),
        (13, 3),
        (14, 3),
        (12, 6),
        (13, 6),
    ],
    items: [
        (5, 2, "beaker.libital"),
        (4, 3, "id_engineering"),
        (3, 7, "wirecutters"),
        (4, 7, "toolbox"),
        (6, 7, "welder"),
        (7, 7, "crowbar"),
    ],
    structures: [
        (3, 2, "apc"),
        (4, 2, "outlet"),
        (13, 2, "light"),
        (16, 2, "outlet"),
        (17, 2, "light"),
        (18, 2, "apc"),
        (12, 2, "outlet"),
        (10, 3, "airlock"),
        (15, 3, "airlock.engineering"),
        (3, 4, "light"),
        (6, 5, "airlock"),
        (3, 6, "light"),
        (4, 6, "outlet"),
        (5, 6, "apc"),
        (10, 6, "airlock"),
        (15, 6, "airlock"),
        (20, 6, "light"),
        // The sill: the one leaf between the corridor and the
        // flooded vestibule, glazed so the water is something you
        // can see before you are standing in it. The backbone
        // already ran under this tile on its way to the exterior
        // door, which is the other thing holding the water in.
        (11, 7, "airlock", { "glass": true }),
        (16, 7, "generator"),
        (20, 7, "smes", { "l2": "bidirectional" }),
        (8, 8, "outlet"),
        (12, 8, "outlet"),
        (14, 8, "apc"),
        (18, 8, "apc"),
        (20, 8, "outlet"),
        (11, 9, "airlock"),
    ],
    machines: [
