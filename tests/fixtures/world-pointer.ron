(
    name: "Mounted pointer browser regression",
    legend: { '.': (composition: (components: [(component: "station_base")])), '#': (composition: (components: [(component: "station_base"), (component: "wall")])) },
    levels: [
        (
            rows: [
                "#######",
                "#..#..#",
                "#.....#",
                "##...##",
                "#.....#",
                "#..#..#",
                "#######",
            ],
            structures: [
                (3, 3, "player_spawn"),
                (3, 2, "airlock_button", { "mount": "north" }),
                (4, 3, "airlock_button", { "mount": "east" }),
                (3, 4, "airlock_button", { "mount": "south" }),
                (2, 3, "airlock_button", { "mount": "west" }),
            ],
        ),
    ],
    // On the ground, since space in free_build is weightless.
    needs: ["gravity"],
    environment: (kind: Exact(terrestrial), gravity_m_s2: Exact(9.80665), surface_temperature_k: Exact(259.15)),
)
