// One enclosed warm room opens through an airlock onto cold surroundings.
(
    name: "Cold outpost",
    tags: ["space", "terrestrial", "no_gravity_generator"],
    environment: (gravity_m_s2: Exact(9.80665)),
    legend: {
        ' ': (composition: (), outdoors: true),
        '#': (composition: (components: [(component: "station_base"), (component: "wall")])),
        '.': (composition: (components: [(component: "station_base"), (component: "floor_tiles")])),
        'g': (composition: (substrate: Some("ground")), outdoors: true),
        'v': (composition: (substrate: Some("space"))),
    },
    rows: [
        "           ",
        "  #####    ",
        "  #...#    ",
        "  #....gg  ",
        "  #...#    ",
        "  #####  v ",
        "           ",
    ],
    structures: [(4, 3, "player_spawn"), (6, 3, "airlock"), (5, 3, "apc", { "l1_reserve": true, "l2": "input" }), (4, 2, "light"), (4, 3, "utility_outlet_port"), (8, 3, "generator")],
    networks: [(x: 4, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15), (x: 5, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15), (x: 5, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15), (x: 6, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15), (x: 6, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15), (x: 7, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15), (x: 8, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15)
    ],
    items: [(4, 3, "analyzer")],
)
