// A compact liquid-flow bench: the deep pair is held between two doors,
// with a shallow tile and a dry tile beyond its internal wall.
(
    name: "Flooded Alcove",
    environment: (kind: Exact(space), gravity_m_s2: Exact(9.80665)),
    legend: {
        ' ': (composition: (substrate: Named("space")), outdoors: true),
        '#': (composition: (substrate: Named("space"), components: [(component: "station_base"), (component: "wall")])),
        '.': (composition: (substrate: Named("space"), components: [(component: "station_base"), (component: "floor_tiles")])),
    },
    levels: [
        (
            rows: [
                "                ",
                "                ",
                "        ########",
                "        #......#",
                "        #......#",
                "        #....###",
                "        #......#",
                "        ###.#..#",
                "        ###..###",
                "        ###.####",
                "                ",
            ],
            painted: [
                (11, 8, "water_50l"),
                (12, 8, "water_50l"),
                (14, 6, "water_4_5l"),
                (13, 7, "water_1l"),
            ],
            structures: [
                (11, 3, "player_spawn"),
                (11, 7, "airlock", { "glass": true }),
                (11, 9, "airlock"),
                (9, 3, "generator"),
                (10, 3, "apc", { "l1_reserve": true, "l2": "input" }),
            ],
            networks: [
                (x: 9, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 9, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15),
                (x: 10, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 10, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15),
                (x: 11, y: 3, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 3, network: "power", channel: "l2", kind: "cable", facing: 15),
                (x: 11, y: 4, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 5, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 6, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 7, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 8, network: "power", channel: "l1", kind: "cable", facing: 15),
                (x: 11, y: 9, network: "power", channel: "l1", kind: "cable", facing: 15),
            ],
        ),
    ],
    // A side puddle at the east bend is isolated from the deep pair by
    // the shut sill and joins the corridor's spill only after it opens.
    // CELL-SIZED: a blend has one amount, and the water must be a total
    // (liters), so each row's o2 and n2 are one 3 m3 cell's standard air,
    // 3 x (8.73 o2, 32.84 n2) mol. A change to simulation.tile changes
    // these two numbers; the water rows stay.
    blends: {
        "water_1l": (rows: [("water", 55.51), ("o2", 26.191311343596351), ("n2", 98.52921886400532)], temperature_k: 293.15, amount: total),
        "water_4_5l": (rows: [("water", 249.79500000000002), ("o2", 26.191311343596351), ("n2", 98.52921886400532)], temperature_k: 293.15, amount: total),
        "water_50l": (rows: [("water", 2775.5), ("o2", 26.191311343596351), ("n2", 98.52921886400532)], temperature_k: 293.15, amount: total),
    },
)
