// Two legs of an air plant feeding one thin ward. Supply: two stores
// through an air mixer onto a supply main and vent. Capture: a scrubber
// whose layer-2 waste main crosses a layer adapter into a CO2 filter
// and its own tank; the filter's remainder dead-ends in a stub.
(
    name: "Plant Loop",
    tags: ["space"],
    environment: (gravity_m_s2: Exact(9.80665)),
    legend: {
        ' ': (composition: (), outdoors: true),
        '#': (composition: (components: [(component: "station_base"), (component: "wall")])),
        '.': (composition: (components: [(component: "station_base"), (component: "floor_tiles")])),
    },
    rows: [
        "###################",
        "#......#..........#",
        "#......#..........#",
        "#......#..........#",
        "########..........#",
        "       #..........#",
        "       ############",
    ],
    blends: {
        "n2_23000kpa": (rows: [("n2", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        "o2_23000kpa": (rows: [("o2", 9436.868804259688)], temperature_k: 293.15, amount: per_tile),
        // Standard air at half an atmosphere: the ward opens thin, so only a
        // working supply leg brings it to its setpoint.
        "air_50kpa": (rows: [("o2", 4.365218557066058), ("n2", 16.42153647733422)], temperature_k: 293.15, amount: per_tile),
    },
    painted: [
        (1, 1, "air_50kpa"),
        (2, 1, "air_50kpa"),
        (3, 1, "air_50kpa"),
        (4, 1, "air_50kpa"),
        (5, 1, "air_50kpa"),
        (6, 1, "air_50kpa"),
        (1, 2, "air_50kpa"),
        (2, 2, "air_50kpa"),
        (3, 2, "air_50kpa"),
        (4, 2, "air_50kpa"),
        (5, 2, "air_50kpa"),
        (6, 2, "air_50kpa"),
        (1, 3, "air_50kpa"),
        (2, 3, "air_50kpa"),
        (3, 3, "air_50kpa"),
        (4, 3, "air_50kpa"),
        (5, 3, "air_50kpa"),
        (6, 3, "air_50kpa"),
    ],
    structures: [
        (15, 3, "player_spawn"),
        (17, 1, "generator"),
        (16, 1, "apc"),
        // Storage, each tank touching exactly one run: nitrogen into the
        // mixer's back intake, oxygen into its side intake, and an empty
        // tank on the CO2 filter's side outlet.
        (16, 5, "stationary_tank", "anchored", { "blend": "n2_23000kpa" }),
        (13, 3, "stationary_tank", "anchored", { "blend": "o2_23000kpa" }),
        (11, 3, "stationary_tank", "anchored"),
        (13, 5, "mixer.airmix", "running", { "dir": "west" }),
        (11, 1, "filter.co2", "running", { "dir": "east" }),
        (9, 1, "layer_adapter"),
        // The ward: one supply vent, and one scrubber pointed at CO2 with
        // the dial wide open and no floor, as a recovery leg.
        (6, 3, "vent", { "pipe": "east" }),
        (5, 1, "air_scrubber", "scrubbing", { "pipe": "east", "whole_air": false, "rate_lps": 200.0, "floor_kpa": 0.0 }),
    ],
    networks: [
        // The waste main on layer 2, from the scrubber to the adapter.
        (x: 6, y: 1, network: "pipe", channel: "l2", kind: "standard", facing: 15),
        (x: 7, y: 1, network: "pipe", channel: "l2", kind: "standard", facing: 15),
        (x: 8, y: 1, network: "pipe", channel: "l2", kind: "standard", facing: 15),
        // Layer 3: filter intake, remainder stub and side outlet.
        (x: 10, y: 1, network: "pipe", channel: "l3", kind: "standard", facing: 15),
        (x: 12, y: 1, network: "pipe", channel: "l3", kind: "standard", facing: 15),
        (x: 13, y: 1, network: "pipe", channel: "l3", kind: "standard", facing: 15),
        (x: 11, y: 2, network: "pipe", channel: "l3", kind: "standard", facing: 15),
