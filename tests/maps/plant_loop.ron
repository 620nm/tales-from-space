        (x: 14, y: 5, network: "pipe", channel: "l3", kind: "standard", facing: 15),
        (x: 13, y: 4, network: "pipe", channel: "l3", kind: "standard", facing: 15),
        // The supply main, from the mixer outlet under the wall to the vent.
        (x: 12, y: 5, network: "pipe", channel: "l3", kind: "standard", facing: 15),
