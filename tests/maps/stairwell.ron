// Two stacked rooms joined by one flight of stairs going up east: the flight
// at (3, 2) on level zero, its top over open space at (3, 2) on level one,
// and the landing at (4, 2) on level one. A crate waits beside the foot.
// A wrench lies on each level so a viewer can tell them apart.
(
    name: "Stairwell",
    environment: (kind: Exact(space), gravity_m_s2: Exact(9.80665)),
    legend: {
        '#': (composition: (components: [(component: "station_base"), (component: "wall")])),
        '.': (composition: (components: [(component: "station_base"), (component: "floor_tiles")])),
        'o': (composition: (substrate: Open)),
    },
    levels: [
        (
            rows: [
                "#########",
                "#.......#",
                "#.......#",
                "#.......#",
                "#########",
            ],
            structures: [(2, 2, "player_spawn"), (1, 2, "crate"), (3, 2, "stairs", { "dir": "east" })],
            items: [(1, 1, "wrench")],
        ),
        (
            rows: [
                "#########",
                "#.......#",
                "#..o....#",
                "#.......#",
                "#########",
            ],
            items: [(7, 3, "wrench")],
        ),
    ],
)
